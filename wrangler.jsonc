{
  // Cloudflare Workers: sitio estático de Astro (dist/), sin código de servidor.
  // Build en Cloudflare: `npm run build`; despliegue: `npx wrangler deploy`.
  "name": "northbridge",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Las rutas sin página propia muestran dist/404.html con estado 404.
    "not_found_handling": "404-page",
  },
}
