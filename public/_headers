# Cloudflare Pages: cabeceras de respuesta.

# Archivos con hash en el nombre (CSS, JS, imágenes optimizadas, fuentes): no cambian nunca.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes para compartir y vídeo del hero: cambian poco.
/og/*
  Cache-Control: public, max-age=86400
/video/*
  Cache-Control: public, max-age=604800

# Seguridad básica en todas las páginas (sin servicios de terceros que permitir).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
