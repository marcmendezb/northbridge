---
/** Card: white on Stone 50, 1 px Stone 200 border, 8 px radius. No heavy shadows. */
interface Props {
  as?: 'div' | 'article' | 'li';
  href?: string;
  class?: string;
}
const { as: Tag = 'div', href, class: className = '' } = Astro.props;
const classes = [
  'block rounded-card border border-piedra-200 bg-white p-6 text-navy-800',
  href && 'nb-trace no-underline transition-colors duration-200 hover:border-navy-800',
  className,
];
---

{href ? (
  <a href={href} class:list={classes}>
    <slot />
  </a>
) : (
  <Tag class:list={classes}>
    <slot />
  </Tag>
)}
