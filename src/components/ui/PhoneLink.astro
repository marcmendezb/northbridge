---
/**
 * The firm's phone number. It is the Zurich head office number in every country (no local numbers
 * are made up): outside Switzerland this is noted next to the number.
 */
import { useI18n } from '../../i18n';
import { byCountry } from '../../lib/country';
import { site } from '../../lib/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const { t } = useI18n(Astro.currentLocale);
const note = byCountry((c) => (c === 'CH' ? '' : ` (${t('contact.phoneCentral')})`));
---

<a class={className} href={`tel:${site.phone.replace(/\s/g, '')}`}>
  {site.phone}
  <Fragment set:html={note} />
</a>
