---
import { formatNumber } from '../../lib/format';
import { byCountry, currencyOf } from '../../lib/country';
import { vatFor } from '../../lib/vat';
import { convert } from '../../lib/pricing/currency';
import { priceUnit } from '../../lib/pricing/display';
import { useI18n } from '../../i18n';
const { t, locale } = useI18n(Astro.currentLocale);

/**
 * "from" and the unit in Instrument Sans; the amount in Newsreader. Always with "Prices excl. VAT".
 * `amount` is in EUR (config.ts): it is shown converted to the selected country's currency.
 */
interface Props {
  amount: number;
  /** Fixed price (one-off payment): the unit is just the currency. */
  once?: boolean;
  size?: 'md' | 'lg';
  /** First mention of VAT on the page: "VAT (MWST)". */
  firstVat?: boolean;
  hideVatNote?: boolean;
  class?: string;
}
const {
  amount,
  once = false,
  size = 'md',
  firstVat = false,
  hideVatNote = false,
  class: className = '',
} = Astro.props;
const value = byCountry((c) => formatNumber(convert(amount, currencyOf(c)), locale));
const unit = byCountry((c) => priceUnit(currencyOf(c), locale, once));
---

<div class:list={['flex flex-col gap-1', className]}>
  <p class="m-0 flex flex-wrap items-baseline gap-x-2">
    <span class="font-sans text-sm text-piedra-600">{t('price.from')}</span>
    <span
      class:list={['t-price text-navy-800', size === 'lg' ? 'text-[3.5rem]' : 'text-[2.5rem]']}
      set:html={value}
    />
    <span class="font-sans text-sm text-piedra-600" set:html={unit} />
  </p>
  {!hideVatNote && (
    <p
      class="t-small m-0"
      set:html={byCountry((c) =>
        vatFor(firstVat ? t('price.vatNoteFirst') : t('price.vatNote'), c, locale),
      )}
    />
  )}
</div>
