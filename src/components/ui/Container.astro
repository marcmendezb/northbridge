---
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
}
const { as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag
  class:list={[
    'mx-auto w-full max-w-[calc(var(--content-max)+2*var(--gutter))] px-[var(--gutter)]',
    className,
  ]}
>
  <slot />
</Tag>
