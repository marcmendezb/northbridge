---
import Arrow from '../brand/Arrow.astro';
/** Primary, secondary or ghost button. 4 px radius, never arch-shaped. Sage never carries white text. */
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'sm';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  /** Dark surface: the primary button inverts (white with Navy 800 text). */
  on?: 'light' | 'dark';
  arrow?: boolean;
  disabled?: boolean;
  class?: string;
  [attr: string]: unknown;
}
const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  on = 'light',
  arrow = false,
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 font-sans font-semibold leading-none no-underline transition-colors duration-200 disabled:cursor-not-allowed disabled:opacity-50';
const sizes = { md: 'min-h-11 px-6 py-3 text-[0.9375rem]', sm: 'min-h-11 px-4 py-2 text-sm' };
const variants = {
  primary:
    on === 'dark'
      ? 'rounded-button bg-white text-navy-800 hover:bg-piedra-100'
      : 'rounded-button bg-navy-800 text-white hover:bg-navy-700',
  secondary: 'rounded-button bg-salvia-400 text-navy-800 hover:bg-salvia-300',
  ghost:
    (on === 'dark'
      ? 'text-piedra-50 hover:text-salvia-300'
      : 'text-navy-600 hover:text-salvia-600') + ' min-h-11 rounded-button px-1',
};
const classes = [base, variant === 'ghost' ? '' : sizes[size], variants[variant], className];
---

{href ? (
  <a href={href} class:list={classes} aria-disabled={disabled ? 'true' : undefined} {...rest}>
    <slot />
    {arrow && <Arrow />}
  </a>
) : (
  <button type={type} disabled={disabled} class:list={classes} {...rest}>
    <slot />
    {arrow && <Arrow />}
  </button>
)}
