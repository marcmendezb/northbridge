---
import Breadcrumbs from './Breadcrumbs.astro';
import Container from '../ui/Container.astro';

/** Cabecera de página interior: migas, H1 y entradilla. */
interface Props {
  title: string;
  lead?: string;
  crumbs: { label: string; href?: string }[];
}
const { title, lead, crumbs } = Astro.props;
---

<header class="relative overflow-hidden border-b border-piedra-200 bg-white">
  <Container class="relative flex flex-col gap-6 py-12 md:py-16">
    <Breadcrumbs items={crumbs} />
    <div class="flex flex-col gap-5">
      <h1 class="m-0 max-w-[20ch] md:max-w-[24ch]">{title}</h1>
      {lead && <p class="t-lead m-0">{lead}</p>}
      <slot />
    </div>
  </Container>
</header>
