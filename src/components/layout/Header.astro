  .nb-header[data-mega-open] .nb-bar {
    border-color: var(--piedra-100);
    box-shadow: 0 10px 32px rgb(21 39 66 / 0.1);
  }

  /* CTA: primary navy button, white text and the brand arrow. */
  .nb-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px 0 22px;
    border-radius: var(--radius-button, 4px);
    background: var(--navy-800);
    color: var(--white);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
