  /* Languages: same dropdown as Services; the language code takes the icon's place. */
  .nb-mega__code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 26px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-tag, 2px);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--piedra-700);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .nb-mega__link:hover .nb-mega__code,
  .nb-mega__link:focus-visible .nb-mega__code {
    border-color: var(--salvia-600);
    color: var(--salvia-600);
  }
  /* Country: a button styled like the dropdown links; currency and legal forms below. */
  .nb-country {
    padding: 4px 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .nb-country__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nb-country__meta {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--piedra-600);
  }
  /* The flag takes the code's place; the selected one gets a navy ring. */
  .nb-country {
    align-items: flex-start;
  }
  /* Small flag, aligned with the first line of the name. */
  .nb-country__flag {
    display: inline-flex;
    justify-content: center;
    width: 34px;
    padding-top: 0.55rem;
  }
  .nb-country[aria-pressed='true'] .nb-flag,
  .nb-mobile__countries button[aria-pressed='true'] .nb-flag {
    outline: 1px solid var(--navy-800);
    outline-offset: 2px;
  }
  .nb-mega__link[aria-current] .nb-mega__code {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--white);
  }
  .nb-mega__info {
    margin: 18px 0 0;
    font-size: 0.9375rem;
