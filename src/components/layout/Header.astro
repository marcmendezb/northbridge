  /* Reduced header: logo on the left and the CTA, which scrolls down to the calendar. */
  .nb-header[data-minimal] .nb-bar__row {
    display: flex;
    justify-content: space-between;
  }
  .nb-bar__end > .nb-cta--always {
    display: inline-flex;
  }
  /* ── Mobile and tablet menu ──
     Without JS the links stay visible inside the bar. With JS the button opens a full-screen navy
     sheet under the bar: large links, Services unfolding in place, and the booking button, phone,
     country and language at the bottom, within thumb reach. */
  .nb-menu-btn {
    display: none;
    align-items: center;
    gap: 10px;
    min-width: 44px;
    height: 44px;
    margin-right: -8px;
    padding-inline: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--navy-800);
  }
  .nb-menu-btn__close {
    display: none;
  }
  .js .nb-menu-btn {
    display: inline-flex;
  }
  @media (min-width: 1200px) {
    .js .nb-menu-btn {
      display: none;
    }
    .nb-mobile {
      display: none;
    }
  }
  .nb-menu-btn[aria-expanded='true'] .nb-menu-btn__open {
    display: none;
  }
  .nb-menu-btn[aria-expanded='true'] .nb-menu-btn__close {
    display: inline;
  }

  .nb-mobile {
    max-height: calc(100svh - var(--header-h) - 12px);
    overflow-y: auto;
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .js .nb-mobile {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: none;
    max-height: none;
    padding-top: var(--header-h);
    overscroll-behavior: contain;
  }
  .js .nb-mobile[data-open='true'] {
    display: block;
    animation: nb-sheet-in var(--dur-base) var(--ease-out);
  }
  .js .nb-mobile[data-open='true'] [data-mobile-item] {
    animation: nb-sheet-item 700ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 40ms + 60ms);
  }
  .nb-header[data-menu-open] .nb-bar {
    border-color: transparent;
    box-shadow: none;
  }
  .nb-mobile__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    min-height: 100%;
    max-width: 640px;
    margin-inline: auto;
    padding: 16px var(--header-gutter) calc(24px + env(safe-area-inset-bottom));
  }
  .nb-mobile__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nb-mobile__item {
    border-bottom: 1px solid var(--navy-600);
  }
  .nb-mobile__row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nb-mobile__link {
    flex: 1;
    display: block;
    padding-block: 14px;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.875rem, 1.3rem + 2.4vw, 2.375rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--white);
    text-decoration: none;
  }
  .nb-mobile__link[aria-current='page'] {
    color: var(--salvia-300);
  }
  .nb-mobile__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-right: -12px;
    border: 0;
    background: none;
    color: var(--navy-100);
    cursor: pointer;
  }
  .nb-mobile__toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .nb-mobile__toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .nb-mobile__toggle:focus-visible,
  .nb-mobile :is(a, button):focus-visible {
    outline: 2px solid var(--salvia-300);
    outline-offset: 2px;
  }
  .nb-mobile__sub {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--dur-base) var(--ease-out);
  }
  .nb-mobile__sub > ul {
    min-height: 0;
    overflow: hidden;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nb-mobile__sub li:last-child {
    padding-bottom: 12px;
  }
  .js .nb-mobile__sub:not(.is-open) {
    grid-template-rows: 0fr;
  }
  .js .nb-mobile__sub:not(.is-open) > ul {
    visibility: hidden;
    transition: visibility 0s linear var(--dur-base);
  }
  .nb-mobile__sublink {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-block: 6px;
    font-size: 1.0625rem;
    color: var(--navy-100);
    text-decoration: none;
  }
  .nb-mobile__sublink:hover {
    color: var(--white);
  }
  .nb-mobile__foot {
    display: grid;
    gap: 20px;
    margin-top: auto;
  }
  .nb-mobile__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 14px 20px;
    border-radius: var(--radius-button, 4px);
    background: var(--white);
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    color: var(--navy-800);
    text-decoration: none;
  }
  .nb-mobile__cta:hover {
    background: var(--piedra-100);
  }
  .nb-mobile__call {
    margin: 0;
    font-size: 0.9375rem;
    text-align: center;
    color: var(--navy-200);
  }
  .nb-mobile__call a {
    font-weight: 600;
    color: var(--white);
  }
  .nb-mobile__settings {
    display: grid;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--navy-600);
  }
  .nb-mobile__setting {
    display: grid;
    gap: 8px;
  }
  .nb-mobile__setting-label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy-200);
  }
  .nb-mobile__seg {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    overflow: hidden;
    list-style: none;
    border: 1px solid var(--navy-600);
    border-radius: var(--radius-button, 4px);
  }
  .nb-mobile__seg li + li {
    border-left: 1px solid var(--navy-600);
  }
  .nb-mobile__seg :is(a, button) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    min-height: 44px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--navy-100);
    text-decoration: none;
    cursor: pointer;
  }
  .nb-mobile__seg :is([aria-pressed='true'], [aria-current='true']) {
    background: var(--white);
    color: var(--navy-800);
  }
  @keyframes nb-sheet-in {
    from {
      opacity: 0;
    }
  }
  @keyframes nb-sheet-item {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* Phones: a flat bar across the full width, aligned with the page edge. */
  @media (max-width: 767px) {
    .nb-header {
      padding-inline: 0;
    }
    .nb-bar {
      border-inline: 0;
      border-radius: 0;
    }
    .nb-bar__row {
      padding-inline: var(--header-gutter);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.nb-header');
  if (header) {
    const btn = header.querySelector<HTMLButtonElement>('.nb-menu-btn');
    const panel = header.querySelector<HTMLElement>('#mobile-menu');

    // The shadow appears after 24 px of scroll.
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // ── Dropdowns (Services and Languages): the bar grows downwards; only one open at a time ──
    const desktop = window.matchMedia('(min-width: 1200px)');
    const hoverable = () => desktop.matches && window.matchMedia('(hover: hover)').matches;
    const megas = [...header.querySelectorAll<HTMLButtonElement>('[data-mega-trigger]')]
      .map((trigger) => ({
        trigger,
        panel: document.getElementById(trigger.getAttribute('aria-controls') ?? ''),
        item: trigger.closest<HTMLElement>('[data-mega-item]'),
      }))
      .filter((m): m is { trigger: HTMLButtonElement; panel: HTMLElement; item: HTMLElement } =>
        Boolean(m.panel && m.item),
      );
    type Mega = (typeof megas)[number];
    if (megas.length) {
      let current: Mega | null = null;
      let timer: number | undefined;
      const setMega = (target: Mega | null, returnFocus = false) => {
        window.clearTimeout(timer);
        const previous = current;
        current = target;
        for (const m of megas) {
          const open = m === target;
          m.trigger.setAttribute('aria-expanded', String(open));
          m.panel.dataset.open = String(open);
        }
        header.toggleAttribute('data-mega-open', Boolean(target));
        if (!target && returnFocus) previous?.trigger.focus();
      };
      const later = (target: Mega | null, ms: number) => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => setMega(target), ms);
      };

      for (const m of megas) {
        m.trigger.addEventListener('click', (e) => {
          const open = current !== m;
          setMega(open ? m : null);
          // With the keyboard (Enter or Space), focus moves to the first link in the panel.
          if (open && (e as MouseEvent).detail === 0)
            m.panel.querySelector<HTMLElement>('a[href], button')?.focus();
        });
        m.item.addEventListener('mouseenter', () => hoverable() && later(m, current ? 0 : 80));
        m.item.addEventListener('mouseleave', () => hoverable() && later(null, 220));
        m.panel.addEventListener('mouseenter', () => hoverable() && window.clearTimeout(timer));
        m.panel.addEventListener('mouseleave', () => hoverable() && later(null, 220));
      }
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && current) {
          e.preventDefault();
          // If focus was inside, it returns to the button; with a mouse only, focus isn't stolen.
          setMega(null, header.contains(document.activeElement));
        }
      });
      header.addEventListener('focusout', (e) => {
        const next = e.relatedTarget as Node | null;
        if (current && next && !current.item.contains(next) && !current.panel.contains(next))
          setMega(null);
      });
      document.addEventListener('click', (e) => {
        if (!header.contains(e.target as Node)) setMega(null);
      });
      desktop.addEventListener('change', () => setMega(null));
    }

    // ── Language chosen manually: it is remembered and the browser language is no longer followed ──
    document.querySelectorAll<HTMLAnchorElement>('.nb-header a[hreflang]').forEach((a) =>
      a.addEventListener('click', () => {
        try {
          localStorage.setItem('nb-lang', (a.getAttribute('hreflang') ?? '').split('-')[0]);
        } catch {
          // No storage available: the choice applies to this visit only.
        }
      }),
    );

    // ── Country: updates currency and legal forms across the page (CSS on [data-cc]) and is remembered ──
    const root = document.documentElement;
    const countryButtons = [
      ...document.querySelectorAll<HTMLButtonElement>('[data-country-option]'),
    ];
    const syncCountry = () => {
      const active = root.dataset.country ?? 'CH';
      for (const b of countryButtons)
        b.setAttribute('aria-pressed', String(b.dataset.countryOption === active));
    };
    for (const b of countryButtons) {
      b.addEventListener('click', () => {
        const code = b.dataset.countryOption;
        if (!code) return;
        root.dataset.country = code;
        try {
          localStorage.setItem('nb-country', code);
        } catch {
          // No storage available: the country applies to this page only.
        }
        syncCountry();
      });
    }
    syncCountry();

    if (btn && panel) {
      const focusables = () =>
        [btn, ...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter(
          (el) => el.offsetParent !== null,
        );

      const setOpen = (open: boolean, returnFocus = true) => {
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute(
          'aria-label',
          (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '',
        );
        panel.dataset.open = String(open);
        header.toggleAttribute('data-menu-open', open);
        document.documentElement.style.overflow = open ? 'hidden' : '';
        window.dispatchEvent(new CustomEvent('nb:scroll-lock', { detail: open }));
        if (open) panel.querySelector<HTMLElement>('a')?.focus();
        else if (returnFocus) btn.focus();
      };

      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));

      // Services unfold inside the menu.
      const toggle = panel.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
      const sub = panel.querySelector<HTMLElement>('[data-mobile-sub]');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        sub?.classList.toggle('is-open', open);
      });
      panel.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false, false);
      });

      header.addEventListener('keydown', (e) => {
        if (btn.getAttribute('aria-expanded') !== 'true') return;
        if (e.key === 'Escape') {
          e.preventDefault();
          setOpen(false);
        } else if (e.key === 'Tab') {
          const items = focusables();
          const first = items[0];
          const last = items[items.length - 1];
          const active = document.activeElement;
          if (e.shiftKey && active === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && active === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });

      // Close the menu when switching to desktop.
      window.matchMedia('(min-width: 1200px)').addEventListener('change', (m) => {
        if (m.matches) setOpen(false, false);
      });
    }
  }
</script>
