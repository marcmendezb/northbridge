---
import { Image, Picture } from 'astro:assets';
import promoPhoto from '../../assets/img/home/hero-poster.jpg';
import Icon from '../brand/Icon.astro';
import Arrow from '../brand/Arrow.astro';
import Flag from '../brand/Flag.astro';
import logoMark from '../../assets/brand/logo-header.png';
import { alternates, localeMeta, parsePath, useI18n } from '../../i18n';
import { getBookingCta, getMainNav, getServiceLinks, site } from '../../lib/site';
import {
  COUNTRIES,
  DEFAULT_COUNTRY,
  byCountry,
  countryName,
  currencyOf,
  legalForm,
} from '../../lib/country';
const { t, lp, locale } = useI18n(Astro.currentLocale);
const bookingCta = getBookingCta(locale);
const mainNav = getMainNav(locale);
const serviceLinks = getServiceLinks(locale);
/** La misma página en cada idioma. */
const langOptions = alternates(parsePath(Astro.url.pathname).canonical).map((a) => ({
  ...a,
  ...localeMeta[a.locale],
  current: a.locale === locale,
}));
/** País: moneda y formas jurídicas (independiente del idioma). Lo marca el script del header. */
const countryOptions = COUNTRIES.map((code) => ({
  code,
  name: countryName(code, locale),
  meta: `${currencyOf(code)} · ${legalForm(code, 'gmbh')}, ${legalForm(code, 'ag')}`,
  current: code === DEFAULT_COUNTRY,
}));

interface Props {
  /** Cabecera reducida (landing de consulta): solo logo y CTA. */
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(`${href}/`));
---

<header class="nb-header" data-minimal={minimal ? '' : undefined}>
  <div class="nb-bar">
    <div class="nb-bar__row">
      <a
        href={lp('/')}
        class="nb-bar__logo"
        aria-label={`${site.name}, ${t('nav.home').toLowerCase()}`}
      >
        <Image
          src={logoMark}
          alt=""
          width={168}
          densities={[1, 2]}
          class="nb-bar__logo-img"
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
      </a>

      {!minimal && (
        <nav aria-label={t('nav.main')} class="nb-nav">
          <ul class="m-0 flex list-none items-center gap-1 p-0">
            {mainNav.map((l) => {
              const hasMega = l.href === lp('/servicios');
              return (
                <li
                  class:list={[hasMega && 'nb-has-menu']}
                  data-mega-item={hasMega ? '' : undefined}
                >
                  {hasMega ? (
                    <>
                      <a
                        href={l.href}
                        class="nb-nav__link nb-nav__nojs"
                        aria-current={isCurrent(l.href) ? 'page' : undefined}
                      >
                        {l.label}
                      </a>
                      <button
                        type="button"
                        class="nb-nav__link nb-nav__trigger"
                        aria-expanded="false"
                        aria-controls="mega-servicios"
                        aria-current={isCurrent(l.href) ? 'page' : undefined}
                        data-mega-trigger
                      >
                        {l.label}
                        <svg
                          class="nb-nav__chev"
                          viewBox="0 0 16 16"
                          width="14"
                          height="14"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          aria-hidden="true"
                        >
                          <path d="M3 6l5 5 5-5" />
                        </svg>
                      </button>
                    </>
                  ) : (
                    <a
                      href={l.href}
                      class="nb-nav__link"
                      aria-current={isCurrent(l.href) ? 'page' : undefined}
                    >
                      {l.label}
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </nav>
      )}

      <div class="nb-bar__end">
        {!minimal && (
          <div class="nb-lang" data-mega-item>
            <button
              type="button"
              class="nb-nav__link nb-lang__trigger"
              aria-expanded="false"
              aria-controls="mega-idiomas"
              data-mega-trigger
            >
              <span class="sr-only">
                {t('lang.region')}: <Fragment set:html={byCountry((c) => countryName(c, locale))} />
                , {localeMeta[locale].name}
              </span>
              <span aria-hidden="true" class="nb-lang__codes">
                <Fragment set:html={byCountry((c) => c)} />
                <span class="nb-lang__sep">·</span>
                {localeMeta[locale].short}
              </span>
              <svg
                class="nb-nav__chev"
                viewBox="0 0 16 16"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M3 6l5 5 5-5" />
              </svg>
            </button>
            <ul class="nb-lang__nojs" aria-label={t('lang.label')}>
              {langOptions.map((o) => (
                <li>
                  <a
                    href={o.path}
                    lang={o.htmlLang}
                    hreflang={o.htmlLang}
                    aria-current={o.current ? 'true' : undefined}
                  >
                    {o.short}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <a href={bookingCta.href} class:list={['nb-cta', minimal && 'nb-cta--always']}>
          <span>{t('nav.freeConsultation')}</span>
          <Arrow />
        </a>
        {!minimal && (
          <button
            type="button"
            class="nb-menu-btn"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label={t('nav.openMenu')}
            data-label-open={t('nav.openMenu')}
            data-label-close={t('nav.closeMenu')}
          >
            <svg
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path class="nb-menu-btn__open" d="M3 7h18M3 12h18M3 17h18" />
              <path class="nb-menu-btn__close" d="M5 5l14 14M19 5L5 19" />
            </svg>
          </button>
        )}
      </div>
    </div>

    {!minimal && (
      <div id="mega-servicios" class="nb-mega" data-mega data-open="false">
        <div class="nb-mega__clip">
          <div class="nb-mega__inner">
            <div class="nb-mega__col">
              <p class="nb-mega__head">{t('nav.mega.services')}</p>
              <ul class="nb-mega__list">
                {serviceLinks.map((l) => (
                  <li>
                    <a href={l.href} class="nb-mega__link">
                      <Icon name={l.icon} size={22} />
                      <span>{l.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a href={lp('/servicios')} class="nb-mega__all">
                {t('nav.mega.seeAll')} <Arrow />
              </a>
            </div>
            <div class="nb-mega__col">
              <p class="nb-mega__head">{t('nav.mega.start')}</p>
              <ul class="nb-mega__list">
                <li>
                  <a href={lp('/precios')} class="nb-mega__link">
                    <span>{t('nav.prices')}</span>
                  </a>
                </li>
                <li>
                  <a href={lp('/calculadora')} class="nb-mega__link">
                    <span>{t('footer.calculator')}</span>
                  </a>
                </li>
                <li>
                  <a href={bookingCta.href} class="nb-mega__link">
                    <span>{t('nav.freeConsultation')}</span>
                  </a>
                </li>
              </ul>
            </div>
            <a href={lp('/calculadora')} class="nb-mega__promo" data-surface="dark">
              <Picture
                src={promoPhoto}
                formats={['avif', 'webp']}
                widths={[480, 720]}
                sizes="360px"
                alt=""
                loading="lazy"
                quality={70}
                class="nb-mega__promo-img"
              />
              <span class="nb-mega__promo-body">
                <span class="nb-mega__promo-title">{t('nav.mega.promoTitle')}</span>
                <span class="nb-mega__promo-text">{t('nav.mega.promoText')}</span>
                <span class="nb-mega__promo-cta">
                  {t('cta.calculate')} <Arrow />
                </span>
              </span>
            </a>
          </div>
        </div>
      </div>
    )}

    {!minimal && (
      <div id="mega-idiomas" class="nb-mega" data-mega data-open="false">
        <div class="nb-mega__clip">
          <div class="nb-mega__inner">
            <div class="nb-mega__col">
              <p class="nb-mega__head" id="mega-country-head">
                {t('lang.country')}
              </p>
              <ul class="nb-mega__list" aria-labelledby="mega-country-head">
                {countryOptions.map((o) => (
                  <li>
                    <button
                      type="button"
                      class="nb-mega__link nb-country"
                      data-country-option={o.code}
                      aria-pressed={o.current ? 'true' : 'false'}
                    >
                      <span class="nb-country__flag">
                        <Flag country={o.code} />
                      </span>
                      <span class="nb-country__body">
                        <span>{o.name}</span>
                        <span class="nb-country__meta">{o.meta}</span>
                      </span>
                    </button>
                  </li>
                ))}
              </ul>
              <p class="nb-mega__info">{t('lang.countryHint')}</p>
            </div>
            <div class="nb-mega__col">
              <p class="nb-mega__head">{t('lang.label')}</p>
              <ul class="nb-mega__list">
                {langOptions.map((o) => (
                  <li>
                    <a
                      href={o.path}
                      lang={o.htmlLang}
                      hreflang={o.htmlLang}
                      class="nb-mega__link"
                      aria-current={o.current ? 'true' : undefined}
                    >
                      <span class="nb-mega__code" aria-hidden="true">
                        {o.short}
                      </span>
                      <span>{o.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <a href={bookingCta.href} class="nb-mega__promo" data-surface="dark">
              <Picture
                src={promoPhoto}
                formats={['avif', 'webp']}
                widths={[480, 720]}
                sizes="360px"
                alt=""
                loading="lazy"
                quality={70}
                class="nb-mega__promo-img"
              />
              <span class="nb-mega__promo-body">
                <span class="nb-mega__promo-title">{t('home.cta.title')}</span>
                <span class="nb-mega__promo-text">{t('home.cta.text')}</span>
                <span class="nb-mega__promo-cta">
                  {bookingCta.label} <Arrow />
                </span>
              </span>
            </a>
          </div>
        </div>
      </div>
    )}

    {!minimal && (
      <div id="mobile-menu" class="nb-mobile" data-open="false" data-lenis-prevent>
        <nav aria-label={t('nav.main')} class="px-5 pt-2 pb-6">
          <ul class="m-0 flex list-none flex-col p-0">
            {mainNav.map((l) => (
              <li class="border-t border-piedra-200">
                <a
                  href={l.href}
                  class="nb-mobile__link"
                  aria-current={isCurrent(l.href) ? 'page' : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
          <a href={bookingCta.href} class="nb-cta nb-cta--block mt-5">
            <span>{bookingCta.label}</span>
            <Arrow />
          </a>
          <ul class="nb-mobile__langs nb-mobile__countries" aria-label={t('lang.country')}>
            {countryOptions.map((o) => (
              <li>
                <button
                  type="button"
                  data-country-option={o.code}
                  aria-pressed={o.current ? 'true' : 'false'}
                  aria-label={`${o.name} (${o.meta})`}
                >
                  <Flag country={o.code} />
                </button>
              </li>
            ))}
          </ul>
          <ul class="nb-mobile__langs" aria-label={t('lang.label')}>
            {langOptions.map((o) => (
              <li>
                <a
                  href={o.path}
                  lang={o.htmlLang}
                  hreflang={o.htmlLang}
                  aria-current={o.current ? 'true' : undefined}
                >
                  {o.short}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    )}
  </div>
</header>

<style is:global>
  :root {
    --header-h: 96px;
  }

  /* Barra flotante: superficie elevada blanca, pegada arriba, esquinas inferiores de tarjeta (8 px). */
  .nb-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    padding-inline: var(--header-gutter);
    pointer-events: none;
  }
  .nb-bar {
    pointer-events: auto;
    max-width: var(--header-max);
    margin-inline: auto;
    background: var(--white);
    color: var(--navy-800);
    border: 1px solid var(--rule);
    border-top: 0;
    border-radius: 0 0 var(--radius-card, 8px) var(--radius-card, 8px);
    box-shadow: 0 0 0 rgb(21 39 66 / 0);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .nb-header[data-scrolled] .nb-bar {
    border-color: var(--piedra-100);
    box-shadow: 0 10px 32px rgb(21 39 66 / 0.1);
  }
  .nb-bar__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--header-h);
    padding-inline: var(--header-pad);
  }
  @media (min-width: 1200px) {
    .nb-bar__row {
      display: grid;
      grid-template-columns: minmax(max-content, 1fr) auto minmax(max-content, 1fr);
    }
  }
  .nb-bar__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 4px 0;
  }
  .nb-bar__logo-img {
    display: block;
    height: 40px;
    width: auto;
  }
  .nb-bar__end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
  }

  .nb-nav {
    display: none;
  }
  @media (min-width: 1200px) {
    .nb-nav {
      display: block;
    }
  }
  .nb-nav__link {
    position: relative;
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--piedra-700);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  /* Hover: el mismo color que los enlaces de los desplegables (Salvia 600), sin desplazamiento. */
  .nb-nav__link[aria-current='page'] {
    color: var(--navy-800);
  }
  .nb-nav__link:hover,
  .nb-nav__link:focus-visible,
  .nb-nav__trigger[aria-expanded='true'] {
    color: var(--salvia-600);
  }

  /* CTA: botón primario con icono sobre Salvia 400 (Navy sobre Salvia, nunca blanco). */
  /* ── Desplegable de Servicios (solo escritorio): la barra crece hacia abajo ── */
  .nb-nav__trigger {
    display: none;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    background: none;
    border: 0;
    font: inherit;
    font-size: 1rem;
    font-weight: 500;
  }
  .js .nb-nav__trigger {
    display: inline-flex;
  }
  .js .nb-nav__nojs {
    display: none;
  }
  .nb-nav__chev {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .nb-nav__trigger[aria-expanded='true'] .nb-nav__chev {
    transform: rotate(180deg);
  }
  .nb-mega {
    display: none;
  }
  @media (min-width: 1200px) {
    .js .nb-mega {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows var(--dur-base) var(--ease-out),
        visibility 0s linear var(--dur-base);
    }
    .js .nb-mega[data-open='true'] {
      grid-template-rows: 1fr;
      visibility: visible;
      transition:
        grid-template-rows var(--dur-base) var(--ease-out),
        visibility 0s;
    }
  }
  .nb-mega__clip {
    min-height: 0;
    overflow: hidden;
  }
  .nb-mega__inner {
    display: grid;
    grid-template-columns: 1fr 1fr minmax(300px, 400px);
    gap: 24px 56px;
    margin-inline: var(--header-pad);
    padding: 32px 0 28px;
    border-top: 1px solid var(--rule);
  }
  .nb-mega__head {
    margin: 0 0 20px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--piedra-600);
  }
  .nb-mega__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nb-mega__link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--navy-800);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .nb-mega__link .nb-icon {
    color: var(--piedra-600);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nb-mega__link:hover,
  .nb-mega__link:focus-visible {
    color: var(--salvia-600);
    transform: translateX(4px);
  }
  .nb-mega__link:hover .nb-icon,
  .nb-mega__link:focus-visible .nb-icon {
    color: var(--salvia-600);
  }
  .nb-mega__all {
    display: inline-block;
    margin-top: 18px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--navy-600);
  }
  .nb-mega__all:hover {
    color: var(--salvia-600);
  }
  /* Tarjeta de la derecha: foto provisional; aquí irá la calculadora. */
  .nb-mega__promo {
    position: relative;
    display: flex;
    min-height: 280px;
    overflow: hidden;
    border-radius: var(--radius-card, 8px);
    background: var(--salvia-700);
    color: var(--white);
    text-decoration: none;
    isolation: isolate;
  }
  .nb-mega__promo-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 66% 50%;
    transition: transform 1200ms var(--ease-out);
  }
  .nb-mega__promo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Velo verde de acento (Salvia 700): el texto blanco cumple AA también sobre la zona clara de la foto. */
    background: color-mix(in srgb, var(--salvia-700) 80%, transparent);
  }
  .nb-mega__promo:hover .nb-mega__promo-img {
    transform: scale(1.04);
  }
  .nb-mega__promo-body {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 24px;
    width: 100%;
  }
  .nb-mega__promo-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .nb-mega__promo-text {
    font-size: 0.9375rem;
    color: var(--white);
  }
  .nb-mega__promo-cta {
    margin-top: 12px;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  /* Idiomas: mismo desplegable que Servicios; el código del idioma ocupa el sitio del icono. */
  .nb-mega__code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 26px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-tag, 2px);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--piedra-700);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .nb-mega__link:hover .nb-mega__code,
  .nb-mega__link:focus-visible .nb-mega__code {
    border-color: var(--salvia-600);
    color: var(--salvia-600);
  }
  /* País: botón con el mismo aspecto que los enlaces del desplegable; debajo, moneda y formas. */
  .nb-country {
    padding: 4px 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .nb-country__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nb-country__meta {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--piedra-600);
  }
  /* La bandera ocupa el sitio del código; la elegida lleva un anillo Navy. */
  .nb-country {
    align-items: flex-start;
  }
  /* Bandera pequeña, alineada con la primera línea del nombre. */
  .nb-country__flag {
    display: inline-flex;
    justify-content: center;
    width: 34px;
    padding-top: 0.55rem;
  }
  .nb-country[aria-pressed='true'] .nb-flag,
  .nb-mobile__countries button[aria-pressed='true'] .nb-flag {
    outline: 1px solid var(--navy-800);
    outline-offset: 2px;
  }
  .nb-mega__link[aria-current] .nb-mega__code {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--white);
  }
  .nb-mega__info {
    margin: 18px 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--piedra-700);
  }
  .nb-lang__trigger {
    display: none;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    cursor: pointer;
    background: none;
    border: 0;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .nb-lang__codes {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .nb-lang__sep {
    color: var(--piedra-400);
  }
  .nb-lang__trigger[aria-expanded='true'] .nb-nav__chev {
    transform: rotate(180deg);
  }
  .nb-lang__nojs,
  .nb-mobile__langs {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nb-lang__nojs a,
  .nb-mobile__langs a,
  .nb-mobile__langs button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--piedra-700);
    text-decoration: none;
  }
  .nb-lang__nojs a[aria-current],
  .nb-mobile__langs a[aria-current],
  .nb-mobile__langs button[aria-pressed='true'] {
    color: var(--salvia-600);
  }
  .nb-mobile__langs {
    margin-top: 20px;
    padding-top: 12px;
    border-top: 1px solid var(--piedra-200);
  }
  .nb-mobile__langs button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  /* Elegir país necesita JS; sin JS se queda el de por defecto. */
  html:not(.js) .nb-mobile__countries {
    display: none;
  }
  .js .nb-mobile__countries + .nb-mobile__langs {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .nb-lang__nojs {
    display: none;
  }
  @media (min-width: 1200px) {
    .js .nb-lang__trigger {
      display: inline-flex;
    }
    html:not(.js) .nb-lang__nojs {
      display: flex;
    }
  }

  .nb-header[data-mega-open] .nb-bar {
    border-color: var(--piedra-100);
    box-shadow: 0 10px 32px rgb(21 39 66 / 0.1);
  }

  /* CTA: botón primario Navy, texto blanco y la flecha de la marca. */
  .nb-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px 0 22px;
    border-radius: var(--radius-button, 4px);
    background: var(--navy-800);
    color: var(--white);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .nb-cta:hover {
    background: var(--navy-700);
  }
  .nb-bar__end > .nb-cta {
    display: none;
  }
  @media (min-width: 640px) {
    .nb-bar__end > .nb-cta {
      display: inline-flex;
    }
    .nb-bar__end {
      gap: 12px;
    }
  }
  .nb-bar__end > .nb-cta--always {
    display: inline-flex;
  }
  .nb-cta--block {
    display: flex;
    width: 100%;
    justify-content: center;
  }

  /* Menú móvil: sin JS, los enlaces quedan visibles dentro de la barra; con JS se abre y se cierra. */
  .nb-menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    margin-right: -6px;
  }
  .nb-menu-btn__close {
    display: none;
  }
  .js .nb-menu-btn {
    display: inline-flex;
  }
  @media (min-width: 1200px) {
    .js .nb-menu-btn {
      display: none;
    }
    .nb-mobile {
      display: none;
    }
  }
  .nb-menu-btn[aria-expanded='true'] .nb-menu-btn__open {
    display: none;
  }
  .nb-menu-btn[aria-expanded='true'] .nb-menu-btn__close {
    display: inline;
  }
  .js .nb-mobile {
    display: none;
  }
  .js .nb-mobile[data-open='true'] {
    display: block;
    animation: nb-menu-in var(--dur-base) var(--ease-out);
  }
  .nb-mobile {
    max-height: calc(100svh - var(--header-h) - 12px);
    overflow-y: auto;
  }
  .nb-mobile__link {
    display: block;
    padding: 0.875rem 0;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: inherit;
    text-decoration: none;
  }
  .nb-mobile__link[aria-current='page'] {
    color: var(--salvia-600);
  }
  @keyframes nb-menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.nb-header');
  if (header) {
    const btn = header.querySelector<HTMLButtonElement>('.nb-menu-btn');
    const panel = header.querySelector<HTMLElement>('#mobile-menu');

    // La sombra aparece tras 24 px de scroll.
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // ── Desplegables (Servicios e Idiomas): la barra crece hacia abajo; solo uno abierto a la vez ──
    const desktop = window.matchMedia('(min-width: 1200px)');
    const hoverable = () => desktop.matches && window.matchMedia('(hover: hover)').matches;
    const megas = [...header.querySelectorAll<HTMLButtonElement>('[data-mega-trigger]')]
      .map((trigger) => ({
        trigger,
        panel: document.getElementById(trigger.getAttribute('aria-controls') ?? ''),
        item: trigger.closest<HTMLElement>('[data-mega-item]'),
      }))
      .filter((m): m is { trigger: HTMLButtonElement; panel: HTMLElement; item: HTMLElement } =>
        Boolean(m.panel && m.item),
      );
    type Mega = (typeof megas)[number];
    if (megas.length) {
      let current: Mega | null = null;
      let timer: number | undefined;
      const setMega = (target: Mega | null, returnFocus = false) => {
        window.clearTimeout(timer);
        const previous = current;
        current = target;
        for (const m of megas) {
          const open = m === target;
          m.trigger.setAttribute('aria-expanded', String(open));
          m.panel.dataset.open = String(open);
        }
        header.toggleAttribute('data-mega-open', Boolean(target));
        if (!target && returnFocus) previous?.trigger.focus();
      };
      const later = (target: Mega | null, ms: number) => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => setMega(target), ms);
      };

      for (const m of megas) {
        m.trigger.addEventListener('click', (e) => {
          const open = current !== m;
          setMega(open ? m : null);
          // Con teclado (Enter o Espacio), el foco pasa al primer enlace del panel.
          if (open && (e as MouseEvent).detail === 0)
            m.panel.querySelector<HTMLElement>('a[href], button')?.focus();
        });
        m.item.addEventListener('mouseenter', () => hoverable() && later(m, current ? 0 : 80));
        m.item.addEventListener('mouseleave', () => hoverable() && later(null, 220));
        m.panel.addEventListener('mouseenter', () => hoverable() && window.clearTimeout(timer));
        m.panel.addEventListener('mouseleave', () => hoverable() && later(null, 220));
      }
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && current) {
          e.preventDefault();
          // Si el foco estaba dentro, vuelve al botón; si solo había ratón, no se roba el foco.
          setMega(null, header.contains(document.activeElement));
        }
      });
      header.addEventListener('focusout', (e) => {
        const next = e.relatedTarget as Node | null;
        if (current && next && !current.item.contains(next) && !current.panel.contains(next))
          setMega(null);
      });
      document.addEventListener('click', (e) => {
        if (!header.contains(e.target as Node)) setMega(null);
      });
      desktop.addEventListener('change', () => setMega(null));
    }

    // ── País: cambia moneda y formas jurídicas en toda la página (CSS de [data-cc]) y se recuerda ──
    const root = document.documentElement;
    const countryButtons = [
      ...document.querySelectorAll<HTMLButtonElement>('[data-country-option]'),
    ];
    const syncCountry = () => {
      const active = root.dataset.country ?? 'CH';
      for (const b of countryButtons)
        b.setAttribute('aria-pressed', String(b.dataset.countryOption === active));
    };
    for (const b of countryButtons) {
      b.addEventListener('click', () => {
        const code = b.dataset.countryOption;
        if (!code) return;
        root.dataset.country = code;
        try {
          localStorage.setItem('nb-country', code);
        } catch {
          // Sin almacenamiento: el país vale para esta página.
        }
        syncCountry();
      });
    }
    syncCountry();

    if (btn && panel) {
      const focusables = () =>
        [btn, ...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter(
          (el) => el.offsetParent !== null,
        );

      const setOpen = (open: boolean, returnFocus = true) => {
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute(
          'aria-label',
          (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '',
        );
        panel.dataset.open = String(open);
        header.toggleAttribute('data-menu-open', open);
        document.documentElement.style.overflow = open ? 'hidden' : '';
        window.dispatchEvent(new CustomEvent('nb:scroll-lock', { detail: open }));
        if (open) panel.querySelector<HTMLElement>('a')?.focus();
        else if (returnFocus) btn.focus();
      };

      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      panel.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false, false);
      });

      header.addEventListener('keydown', (e) => {
        if (btn.getAttribute('aria-expanded') !== 'true') return;
        if (e.key === 'Escape') {
          e.preventDefault();
          setOpen(false);
        } else if (e.key === 'Tab') {
          const items = focusables();
          const first = items[0];
          const last = items[items.length - 1];
          const active = document.activeElement;
          if (e.shiftKey && active === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && active === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });

      // Al pasar a escritorio, cerrar el menú.
      window.matchMedia('(min-width: 1200px)').addEventListener('change', (m) => {
        if (m.matches) setOpen(false, false);
      });
    }
  }
</script>
