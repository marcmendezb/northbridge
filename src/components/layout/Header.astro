---
import { Image, Picture } from 'astro:assets';
import promoPhoto from '../../assets/img/home/hero-poster.jpg';
import Icon from '../brand/Icon.astro';
import Arrow from '../brand/Arrow.astro';
import Flag from '../brand/Flag.astro';
import PhoneLink from '../ui/PhoneLink.astro';
import logoMark from '../../assets/brand/logo-header.png';
import { alternates, localeMeta, parsePath, useI18n } from '../../i18n';
import { getBookingCta, getMainNav, getServiceLinks, site } from '../../lib/site';
import {
  COUNTRIES,
  DEFAULT_COUNTRY,
  byCountry,
  countryName,
  currencyOf,
  legalForm,
} from '../../lib/country';
const { t, lp, locale } = useI18n(Astro.currentLocale);
const bookingCta = getBookingCta(locale);
const mainNav = getMainNav(locale);
const serviceLinks = getServiceLinks(locale);
/** The same page in every language. */
const langOptions = alternates(parsePath(Astro.url.pathname).canonical).map((a) => ({
  ...a,
  ...localeMeta[a.locale],
  current: a.locale === locale,
}));
/** Country: currency and legal forms (independent of language). Set by the header script. */
const countryOptions = COUNTRIES.map((code) => ({
  code,
  name: countryName(code, locale),
  meta: `${currencyOf(code)} / ${legalForm(code, 'gmbh')}, ${legalForm(code, 'ag')}`,
  current: code === DEFAULT_COUNTRY,
}));

interface Props {
  /** Reduced header: logo and CTA only. */
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(`${href}/`));
import { vatFor } from '../../lib/vat';
---

<header class="nb-header" data-minimal={minimal ? '' : undefined}>
  <div class="nb-bar">
    <div class="nb-bar__row">
      <a
        href={lp('/')}
        class="nb-bar__logo"
        aria-label={`${site.name}, ${t('nav.home').toLowerCase()}`}
      >
        <Image
          src={logoMark}
          alt=""
          width={168}
          densities={[1, 2]}
          class="nb-bar__logo-img"
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
        <span class="nb-bar__wordmark" aria-hidden="true">
          <span class="nb-bar__name">Northbridge</span> <span class="nb-bar__sub">Advisory</span>
        </span>
      </a>

      {!minimal && (
        <nav aria-label={t('nav.main')} class="nb-nav">
          <ul class="m-0 flex list-none items-center gap-1 p-0">
            {mainNav.map((l) => {
              const hasMega = l.href === lp('/servicios');
              return (
                <li
                  class:list={[hasMega && 'nb-has-menu']}
                  data-mega-item={hasMega ? '' : undefined}
                >
                  {hasMega ? (
                    <>
                      {/* The label links to all services; the arrow opens the dropdown
                          (it also opens on hover). */}
                      <a
                        href={l.href}
                        class="nb-nav__link nb-nav__split"
                        aria-current={isCurrent(l.href) ? 'page' : undefined}
                      >
                        <Fragment set:html={byCountry((c) => vatFor(l.label, c, locale))} />
                      </a>
                      <button
                        type="button"
                        class="nb-nav__link nb-nav__trigger"
                        aria-expanded="false"
                        aria-controls="mega-servicios"
                        data-mega-trigger
                      >
                        <span class="sr-only">
                          {l.label}: {t('nav.openMenu').toLowerCase()}
                        </span>
                        <svg
                          class="nb-nav__chev"
                          viewBox="0 0 16 16"
                          width="14"
                          height="14"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          aria-hidden="true"
                        >
                          <path d="M3 6l5 5 5-5" />
                        </svg>
                      </button>
                    </>
                  ) : (
                    <a
                      href={l.href}
                      class="nb-nav__link"
                      aria-current={isCurrent(l.href) ? 'page' : undefined}
                    >
                      <Fragment set:html={byCountry((c) => vatFor(l.label, c, locale))} />
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </nav>
      )}

      <div class="nb-bar__end">
        {!minimal && (
          <div class="nb-lang" data-mega-item>
            <button
              type="button"
              class="nb-nav__link nb-lang__trigger"
              aria-expanded="false"
              aria-controls="mega-idiomas"
              data-mega-trigger
            >
              <span class="sr-only">
                {t('lang.region')}: <Fragment set:html={byCountry((c) => countryName(c, locale))} />
                , {localeMeta[locale].name}
              </span>
              <span aria-hidden="true" class="nb-lang__codes">
                <Fragment set:html={byCountry((c) => c)} />
                <span class="nb-lang__sep">/</span>
                {localeMeta[locale].short}
              </span>
              <svg
                class="nb-nav__chev"
                viewBox="0 0 16 16"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M3 6l5 5 5-5" />
              </svg>
            </button>
            <ul class="nb-lang__nojs" aria-label={t('lang.label')}>
              {langOptions.map((o) => (
                <li>
                  <a
                    href={o.path}
                    lang={o.htmlLang}
                    hreflang={o.htmlLang}
                    aria-current={o.current ? 'true' : undefined}
                  >
                    {o.short}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <a
          href={minimal ? '#reservar' : bookingCta.href}
          class:list={['nb-cta', minimal && 'nb-cta--always']}
        >
          <span>{t('nav.freeConsultation')}</span>
          <Arrow />
        </a>
        {!minimal && (
          <button
            type="button"
            class="nb-menu-btn"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label={t('nav.openMenu')}
            data-label-open={t('nav.openMenu')}
            data-label-close={t('nav.closeMenu')}
          >
            <span class="nb-menu-btn__text" aria-hidden="true">
              <span class="nb-menu-btn__open">{t('nav.menu')}</span>
              <span class="nb-menu-btn__close">{t('nav.close')}</span>
            </span>
            <svg
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path class="nb-menu-btn__open" d="M3 7h18M3 12h18M3 17h18" />
              <path class="nb-menu-btn__close" d="M5 5l14 14M19 5L5 19" />
            </svg>
          </button>
        )}
      </div>
    </div>

    {!minimal && (
      <div id="mega-servicios" class="nb-mega" data-mega data-open="false">
        <div class="nb-mega__clip">
          <div class="nb-mega__inner">
            <div class="nb-mega__col">
              <p class="nb-mega__head">{t('nav.mega.services')}</p>
              <ul class="nb-mega__list">
                {serviceLinks.map((l) => (
                  <li>
                    <a href={l.href} class="nb-mega__link">
                      <Icon name={l.icon} size={22} />
                      <span>
                        <Fragment set:html={byCountry((c) => vatFor(l.label, c, locale))} />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <a href={lp('/servicios')} class="nb-mega__all">
                {t('nav.mega.seeAll')} <Arrow />
              </a>
            </div>
            <div class="nb-mega__col">
              <p class="nb-mega__head">{t('nav.mega.start')}</p>
              <ul class="nb-mega__list">
                <li>
                  <a href={lp('/precios')} class="nb-mega__link">
                    <span>{t('nav.prices')}</span>
                  </a>
                </li>
                <li>
                  <a href={lp('/calculadora')} class="nb-mega__link">
                    <span>{t('footer.calculator')}</span>
                  </a>
                </li>
                <li>
                  <a href={bookingCta.href} class="nb-mega__link">
                    <span>{t('nav.freeConsultation')}</span>
                  </a>
                </li>
              </ul>
            </div>
            <a href={lp('/calculadora')} class="nb-mega__promo" data-surface="dark">
              <Picture
                src={promoPhoto}
                formats={['avif', 'webp']}
                widths={[480, 720]}
                sizes="360px"
                alt=""
                loading="lazy"
                quality={70}
                class="nb-mega__promo-img"
              />
              <span class="nb-mega__promo-body">
                <span class="nb-mega__promo-title">{t('nav.mega.promoTitle')}</span>
                <span class="nb-mega__promo-text">{t('nav.mega.promoText')}</span>
                <span class="nb-mega__promo-cta">
                  {t('cta.calculate')} <Arrow />
                </span>
              </span>
            </a>
          </div>
        </div>
      </div>
    )}

    {!minimal && (
      <div id="mega-idiomas" class="nb-mega" data-mega data-open="false">
        <div class="nb-mega__clip">
          <div class="nb-mega__inner">
            <div class="nb-mega__col">
              <p class="nb-mega__head" id="mega-country-head">
                {t('lang.country')}
              </p>
              <ul class="nb-mega__list" aria-labelledby="mega-country-head">
                {countryOptions.map((o) => (
                  <li>
                    <button
                      type="button"
                      class="nb-mega__link nb-country"
                      data-country-option={o.code}
                      aria-pressed={o.current ? 'true' : 'false'}
                    >
                      <span class="nb-country__flag">
                        <Flag country={o.code} />
                      </span>
                      <span class="nb-country__body">
                        <span>{o.name}</span>
                        <span class="nb-country__meta">{o.meta}</span>
                      </span>
                    </button>
                  </li>
                ))}
              </ul>
              <p class="nb-mega__info">{t('lang.countryHint')}</p>
            </div>
            <div class="nb-mega__col">
              <p class="nb-mega__head">{t('lang.label')}</p>
              <ul class="nb-mega__list">
                {langOptions.map((o) => (
                  <li>
                    <a
                      href={o.path}
                      lang={o.htmlLang}
                      hreflang={o.htmlLang}
                      class="nb-mega__link"
                      aria-current={o.current ? 'true' : undefined}
                    >
                      <span class="nb-mega__code" aria-hidden="true">
                        {o.short}
                      </span>
                      <span>{o.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <a href={bookingCta.href} class="nb-mega__promo" data-surface="dark">
              <Picture
                src={promoPhoto}
                formats={['avif', 'webp']}
                widths={[480, 720]}
                sizes="360px"
                alt=""
                loading="lazy"
                quality={70}
                class="nb-mega__promo-img"
              />
              <span class="nb-mega__promo-body">
                <span class="nb-mega__promo-title">{t('home.cta.title')}</span>
                <span class="nb-mega__promo-text">{t('home.cta.text')}</span>
                <span class="nb-mega__promo-cta">
                  {bookingCta.label} <Arrow />
                </span>
              </span>
            </a>
          </div>
        </div>
      </div>
    )}

    {!minimal && (
      <div id="mobile-menu" class="nb-mobile" data-open="false" data-lenis-prevent>
        <div class="nb-mobile__inner">
          <nav aria-label={t('nav.main')} class="nb-mobile__nav">
            <ul class="nb-mobile__list" role="list">
              {mainNav.map((l, i) => {
                const hasSub = l.href === lp('/servicios');
                const label = byCountry((c) => vatFor(l.label, c, locale));
                return (
                  <li class="nb-mobile__item" data-mobile-item style={`--i:${i}`}>
                    <div class="nb-mobile__row">
                      <a
                        href={l.href}
                        class="nb-mobile__link"
                        aria-current={isCurrent(l.href) ? 'page' : undefined}
                      >
                        <Fragment set:html={label} />
                      </a>
                      {hasSub && (
                        <button
                          type="button"
                          class="nb-mobile__toggle"
                          aria-expanded="false"
                          aria-controls="mobile-services"
                          data-mobile-toggle
                        >
                          <span class="sr-only">
                            {l.label}: {t('nav.openMenu').toLowerCase()}
                          </span>
                          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                            <path d="M3 6l5 5 5-5" />
                          </svg>
                        </button>
                      )}
                    </div>
                    {hasSub && (
                      <div id="mobile-services" class="nb-mobile__sub" data-mobile-sub>
                        <ul role="list">
                          {serviceLinks.map((sl) => (
                            <li>
                              <a href={sl.href} class="nb-mobile__sublink">
                                <Fragment
                                  set:html={byCountry((c) => vatFor(sl.label, c, locale))}
                                />
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          </nav>

          <div class="nb-mobile__foot" data-mobile-item style={`--i:${mainNav.length}`}>
            <a href={bookingCta.href} class="nb-mobile__cta">
              <span>{bookingCta.label}</span>
              <Arrow />
            </a>
            <p class="nb-mobile__call">
              {t('home.cta.orCall').split('{phone}')[0]}
              <PhoneLink class="nb-tap" />
            </p>
            <div class="nb-mobile__settings">
              <div class="nb-mobile__setting nb-mobile__setting--country">
                <p class="nb-mobile__setting-label" id="mobile-country">
                  {t('lang.country')}
                </p>
                <ul class="nb-mobile__seg" role="list" aria-labelledby="mobile-country">
                  {countryOptions.map((o) => (
                    <li>
                      <button
                        type="button"
                        data-country-option={o.code}
                        aria-pressed={o.current ? 'true' : 'false'}
                        aria-label={`${o.name} (${o.meta})`}
                      >
                        <Flag country={o.code} />
                        <span aria-hidden="true">{o.code}</span>
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="nb-mobile__setting">
                <p class="nb-mobile__setting-label" id="mobile-lang">
                  {t('lang.label')}
                </p>
                <ul class="nb-mobile__seg" role="list" aria-labelledby="mobile-lang">
                  {langOptions.map((o) => (
                    <li>
                      <a
                        href={o.path}
                        lang={o.htmlLang}
                        hreflang={o.htmlLang}
                        aria-current={o.current ? 'true' : undefined}
                      >
                        {o.short}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</header>

<style is:global>
  :root {
    --header-h: 96px;
  }
  @media (max-width: 767px) {
    :root {
      --header-h: 64px;
    }
  }
  /* Phone in landscape: every pixel of height counts. */
  @media (max-height: 500px) and (orientation: landscape) {
    :root {
      --header-h: 60px;
    }
  }

  /* Floating bar: elevated white surface, stuck to the top, with card-style bottom corners (8 px). */
  .nb-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    padding-inline: var(--header-gutter);
    pointer-events: none;
  }
  .nb-bar {
    pointer-events: auto;
    max-width: var(--header-max);
    margin-inline: auto;
    background: var(--white);
    color: var(--navy-800);
    border: 1px solid var(--rule);
    border-top: 0;
    border-radius: 0 0 var(--radius-card, 8px) var(--radius-card, 8px);
    box-shadow: 0 0 0 rgb(21 39 66 / 0);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .nb-header[data-scrolled] .nb-bar {
    border-color: var(--piedra-100);
    box-shadow: 0 10px 32px rgb(21 39 66 / 0.1);
  }
  .nb-bar__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--header-h);
    padding-inline: var(--header-pad);
  }
  @media (min-width: 1200px) {
    .nb-bar__row {
      display: grid;
      grid-template-columns: minmax(max-content, 1fr) auto minmax(max-content, 1fr);
    }
  }
  .nb-bar__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 4px 0;
  }
  /* Horizontal lockup: symbol ≈ 1.09 × the "Northbridge" type size, 0.3 × gap. */
  .nb-bar__logo {
    --wm: 29px;
    gap: calc(var(--wm) * 0.34);
    color: var(--navy-800);
    text-decoration: none;
  }
  .nb-bar__logo-img {
    display: block;
    height: calc(var(--wm) * 1.09);
    width: auto;
  }
  .nb-bar__wordmark {
    display: flex;
    flex-direction: column;
    gap: calc(var(--wm) * 0.16);
    white-space: nowrap;
  }
  .nb-bar__name {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--wm);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.015em;
  }
  .nb-bar__sub {
    font-family: var(--font-sans);
    font-size: calc(var(--wm) * 0.27);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.36em;
    text-transform: uppercase;
  }
  @media (max-width: 479px) {
    .nb-bar__logo {
      --wm: 24px;
    }
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .nb-bar__logo {
      --wm: 22px;
    }
  }
  /* Narrow desktop: the lockup and navigation tighten so German fits. */
  @media (min-width: 1200px) and (max-width: 1439px) {
    .nb-bar__logo {
      --wm: 24px;
    }
    .nb-nav .nb-nav__link {
      padding-inline: 0.5rem;
      font-size: 0.9375rem;
    }
    .nb-bar__row {
      gap: 12px;
    }
    .nb-bar__end > .nb-cta {
      padding-inline: 16px 14px;
    }
  }
  .nb-bar__end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
  }

  .nb-nav {
    display: none;
  }
  @media (min-width: 1200px) {
    .nb-nav {
      display: block;
    }
  }
  .nb-nav__link {
    position: relative;
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--piedra-700);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  /* Hover: the same colour as the dropdown links (Sage 600), no movement. */
  .nb-nav__link[aria-current='page'] {
    color: var(--navy-800);
  }
  .nb-nav__link:hover,
  .nb-nav__link:focus-visible,
  .nb-nav__trigger[aria-expanded='true'] {
    color: var(--salvia-600);
  }

  /* CTA: primary button with an icon on Sage 400 (navy on sage, never white). */
  /* ── Services dropdown (desktop only): the bar grows downwards ── */
  .nb-nav__trigger {
    display: none;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    background: none;
    border: 0;
    font: inherit;
    font-size: 1rem;
    font-weight: 500;
  }
  /* With JS, the "Services" link sits right next to its arrow, which is a separate button. */
  .js .nb-nav__trigger {
    display: inline-flex;
    margin-left: -0.75rem;
    padding-inline: 0.5rem;
  }
  .js .nb-nav__split {
    padding-right: 0.5rem;
  }
  .nb-nav__chev {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .nb-nav__trigger[aria-expanded='true'] .nb-nav__chev {
    transform: rotate(180deg);
  }
  .nb-mega {
    display: none;
  }
  @media (min-width: 1200px) {
    .js .nb-mega {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows var(--dur-base) var(--ease-out),
        visibility 0s linear var(--dur-base);
    }
    .js .nb-mega[data-open='true'] {
      grid-template-rows: 1fr;
      visibility: visible;
      transition:
        grid-template-rows var(--dur-base) var(--ease-out),
        visibility 0s;
    }
  }
  .nb-mega__clip {
    min-height: 0;
    overflow: hidden;
  }
  .nb-mega__inner {
    display: grid;
    grid-template-columns: 1fr 1fr minmax(300px, 400px);
    gap: 24px 56px;
    margin-inline: var(--header-pad);
    padding: 32px 0 28px;
    border-top: 1px solid var(--rule);
  }
  .nb-mega__head {
    margin: 0 0 20px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--piedra-600);
  }
  .nb-mega__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nb-mega__link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--navy-800);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .nb-mega__link .nb-icon {
    color: var(--piedra-600);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nb-mega__link:hover,
  .nb-mega__link:focus-visible {
    color: var(--salvia-600);
    transform: translateX(4px);
  }
  .nb-mega__link:hover .nb-icon,
  .nb-mega__link:focus-visible .nb-icon {
    color: var(--salvia-600);
  }
  .nb-mega__all {
    display: inline-block;
    margin-top: 18px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--navy-600);
  }
  .nb-mega__all:hover {
    color: var(--salvia-600);
  }
  /* Right-hand card: photo and a shortcut to the calculator. */
  .nb-mega__promo {
    position: relative;
    display: flex;
    min-height: 280px;
    overflow: hidden;
    border-radius: var(--radius-card, 8px);
    background: var(--salvia-700);
    color: var(--white);
    text-decoration: none;
    isolation: isolate;
  }
  .nb-mega__promo-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 66% 50%;
    transition: transform 1200ms var(--ease-out);
  }
  .nb-mega__promo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Accent green overlay (Sage 700): white text passes AA even over the light part of the photo. */
    background: color-mix(in srgb, var(--salvia-700) 80%, transparent);
  }
  .nb-mega__promo:hover .nb-mega__promo-img {
    transform: scale(1.04);
  }
  .nb-mega__promo-body {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 24px;
    width: 100%;
  }
  .nb-mega__promo-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .nb-mega__promo-text {
    font-size: 0.9375rem;
