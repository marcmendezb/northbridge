---
import { useI18n } from '../../i18n';
import { site } from '../../lib/site';
const { t, lp } = useI18n(Astro.currentLocale);

interface Crumb {
  label: string;
  href?: string;
  /** Per-country variant (HTML from byCountry); structured data uses `label`. */
  html?: string;
}
interface Props {
  items: Crumb[];
  /** On a dark background (headers with a photo). */
  tone?: 'light' | 'dark';
  class?: string;
}
const { items, tone = 'light', class: className = '' } = Astro.props;
const all: Crumb[] = [{ label: t('nav.home'), href: lp('/') }, ...items];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, site.url).toString() } : {}),
  })),
};
---

<nav
  aria-label={t('nav.breadcrumbs')}
  class:list={['t-small', tone === 'dark' && 'nb-crumbs--dark', className]}
>
  <ol class="m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0">
    {all.map((c, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && (
          <span aria-hidden="true" class="text-piedra-400">
            /
          </span>
        )}
        {c.href && i < all.length - 1 ? (
          <a class="nb-tap" href={c.href}>
            {c.label}
          </a>
        ) : (
          <span aria-current="page" class="text-navy-800">
            {c.html ? <Fragment set:html={c.html} /> : c.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<style is:global>
  .nb-crumbs--dark,
  .nb-crumbs--dark a {
    color: var(--navy-100);
  }
  .nb-crumbs--dark a:hover {
    color: var(--salvia-300);
  }
  .nb-crumbs--dark [aria-current] {
    color: var(--white);
  }
</style>
