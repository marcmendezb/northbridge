---
import Logo from '../brand/Logo.astro';
import Button from '../ui/Button.astro';
import { t, localizedPath } from '../../i18n';
import { bookingCta, legalLinks, mainNav, resourceLinks, serviceLinks, site } from '../../lib/site';

const year = new Date().getFullYear();
const companyLinks = [
  ...mainNav.filter(
    (l) => l.href !== localizedPath('/servicios') && l.href !== localizedPath('/recursos'),
  ),
  { href: bookingCta.href, label: t('nav.freeConsultation') },
];
const columns = [
  { id: 'services', title: t('footer.services'), links: serviceLinks },
  {
    id: 'resources',
    title: t('footer.resources'),
    links: [
      ...resourceLinks,
      { href: localizedPath('/calculadora'), label: t('footer.calculator') },
    ],
  },
  { id: 'company', title: t('footer.company'), links: companyLinks },
];
---

<footer class="nb-footer">
  <div class="nb-footer__grid">
    <div class="nb-footer__brand" data-surface="dark">
      <a href="/" class="relative block w-fit no-underline">
        <Logo tone="negative" size={26} />
      </a>
      <div class="relative flex flex-col items-start gap-6">
        <p class="nb-footer__claim">{t('brand.claim')}</p>
        <Button href={bookingCta.href} on="dark">
          {bookingCta.label}
        </Button>
        <p class="m-0 max-w-[32ch] text-sm text-navy-200">
          © {year} {site.name}. {t('footer.rights')} {t('footer.fictional')}
        </p>
      </div>
    </div>

    <div class="nb-footer__panel">
      <div class="nb-footer__cols">
        {columns.map((c) => (
          <nav aria-labelledby={`footer-${c.id}`}>
            <h2 id={`footer-${c.id}`} class="nb-footer__title">
              {c.title}
            </h2>
            <ul class="m-0 flex list-none flex-col gap-1 p-0">
              {c.links.map((l) => (
                <li>
                  <a class="nb-footer__link" href={l.href}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
        <div>
          <h2 class="nb-footer__title">{t('footer.contact')}</h2>
          <address class="m-0 flex flex-col gap-1 text-[0.9375rem] not-italic leading-relaxed text-piedra-700">
            <span>{site.address.street}</span>
            <span>
              {site.address.postalCode} {site.address.city}
            </span>
            <a class="nb-footer__link mt-3" href={`tel:${site.phone.replace(/\s/g, '')}`}>
              {site.phone}
            </a>
            <a class="nb-footer__link" href={`mailto:${site.email}`}>
              {site.email}
            </a>
            <span class="mt-3 text-piedra-600">{t('footer.hours')}</span>
          </address>
        </div>
      </div>

      <nav aria-label={t('footer.legal')} class="nb-footer__legal">
        <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-1 p-0">
          {legalLinks.map((l) => (
            <li>
              <a class="nb-footer__link" href={l.href}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style is:global>
  .nb-footer {
    padding: clamp(24px, 4vw, 56px) clamp(16px, 4.5vw, 72px);
  }
  .nb-footer__grid {
    display: grid;
    gap: 16px;
    max-width: 1280px;
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .nb-footer__grid {
      grid-template-columns: minmax(300px, 1fr) 2fr;
    }
  }
  .nb-footer__brand {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 64px;
    min-height: 380px;
    padding: clamp(28px, 3vw, 44px);
    border-radius: var(--radius-card, 8px);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-footer__claim {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--piedra-50);
  }
  .nb-footer__panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 56px;
    padding: clamp(28px, 3vw, 48px);
    border-radius: var(--radius-card, 8px);
    background: var(--piedra-100);
  }
  .nb-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 32px;
  }
  @media (min-width: 1280px) {
    .nb-footer__cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .nb-footer__title {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--navy-800);
  }
  .nb-footer__legal {
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
  }
  .nb-footer__link {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--piedra-700);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nb-footer__link:hover {
    color: var(--navy-800);
  }
  .nb-footer__brand .nb-footer__link {
    color: var(--navy-100);
  }
</style>
