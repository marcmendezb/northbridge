---
import Logo from '../brand/Logo.astro';
import Pattern from '../brand/Pattern.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { t, localizedPath } from '../../i18n';
import { bookingCta, legalLinks, resourceLinks, serviceLinks, site } from '../../lib/site';

const year = new Date().getFullYear();
---

<footer data-surface="dark" class="relative overflow-hidden bg-navy-800 text-navy-100">
  <Pattern tone="dark" mask="top" class="absolute inset-0 opacity-50" />
  <Container class="relative py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div class="flex flex-col items-start gap-5">
        <a href="/" class="block no-underline">
          <Logo tone="negative" size={26} />
        </a>
        <p class="m-0 max-w-xs font-serif text-2xl font-light leading-snug text-piedra-50">
          {t('brand.claim')}
        </p>
        <Button href={bookingCta.href} on="dark" class="mt-2">
          {bookingCta.label}
        </Button>
      </div>

      <nav aria-labelledby="footer-services">
        <h2
          id="footer-services"
          class="t-label !font-sans mb-4 !text-[0.75rem] !tracking-[0.16em] text-salvia-300"
        >
          {t('footer.services')}
        </h2>
        <ul class="m-0 flex list-none flex-col gap-1 p-0">
          {serviceLinks.map((l) => (
            <li>
              <a class="nb-footer__link" href={l.href}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="footer-resources">
        <h2
          id="footer-resources"
          class="t-label !font-sans mb-4 !text-[0.75rem] !tracking-[0.16em] text-salvia-300"
        >
          {t('footer.resources')}
        </h2>
        <ul class="m-0 flex list-none flex-col gap-1 p-0">
          {resourceLinks.map((l) => (
            <li>
              <a class="nb-footer__link" href={l.href}>
                {l.label}
              </a>
            </li>
          ))}
          <li>
            <a class="nb-footer__link" href={localizedPath('/calculadora')}>
              {t('footer.calculator')}
            </a>
          </li>
        </ul>
      </nav>

      <div>
        <h2 class="t-label !font-sans mb-4 !text-[0.75rem] !tracking-[0.16em] text-salvia-300">
          {t('footer.contact')}
        </h2>
        <address class="m-0 flex flex-col gap-1 text-[0.9375rem] not-italic leading-relaxed">
          <span>{site.address.street}</span>
          <span>
            {site.address.postalCode} {site.address.city}
          </span>
          <a class="nb-footer__link mt-3" href={`tel:${site.phone.replace(/\s/g, '')}`}>
            {site.phone}
          </a>
          <a class="nb-footer__link" href={`mailto:${site.email}`}>
            {site.email}
          </a>
          <span class="mt-3 text-navy-200">{t('footer.hours')}</span>
        </address>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-navy-600 pt-6 text-sm text-navy-200 md:flex-row md:items-center md:justify-between">
      <p class="m-0">
        © {year} {site.name}. {t('footer.rights')} {t('footer.fictional')}
      </p>
      <nav aria-label={t('footer.legal')}>
        <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-1 p-0">
          {legalLinks.map((l) => (
            <li>
              <a class="nb-footer__link" href={l.href}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </Container>
</footer>

<style is:global>
  .nb-footer__link {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--navy-100);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nb-footer__link:hover {
    color: var(--salvia-300);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
</style>
