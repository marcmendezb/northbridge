---
/** "Keep in mind" box for articles. Used in MDX as <Note>…</Note>. */
import { useI18n } from '../../i18n';
const { t } = useI18n(Astro.currentLocale);
interface Props {
  title?: string;
}
const { title = t('article.note') } = Astro.props;
---

<aside class="nb-note" role="note">
  <p class="nb-note__title">
    <svg viewBox="4 11 40 26" aria-hidden="true" class="nb-note__mark">
      <path d="M4 13H44"></path>
      <path d="M10 37V29A14 14 0 0 1 38 29V37"></path>
    </svg>
    {title}
  </p>
  <div class="nb-note__body">
    <slot />
  </div>
</aside>

<style is:global>
  .nb-note {
    margin-block: 32px;
    padding: 20px 24px;
    border: 1px solid var(--info-icon);
    border-radius: var(--radius-button, 4px);
    background: var(--info-bg);
    color: var(--info-text);
  }
  .nb-note__title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 8px;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .nb-note__mark {
    width: 22px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 4;
  }
  .nb-note__body > :first-child {
    margin-top: 0;
  }
  .nb-note__body > :last-child {
    margin-bottom: 0;
  }
</style>
