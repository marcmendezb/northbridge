---
/** Tax calendar table (src/data/fiscal-calendar/) in the page's language. */
import { FISCAL_CALENDARS } from '../../data/fiscal-calendar';
import type { Country } from '../../lib/country';
import { useI18n } from '../../i18n';
interface Props {
  when: string;
  what: string;
  need: string;
  caption: string;
  /** Calendar country (defaults to Switzerland). */
  country?: Country;
}
const { when, what, need, caption, country = 'CH' } = Astro.props;
const { locale } = useI18n(Astro.currentLocale);
/** By month; the monthly deadlines (contributions) go last. */
const rows = [...(FISCAL_CALENDARS[country] ?? [])].sort(
  (a, b) => Number(Boolean(a.recurring)) - Number(Boolean(b.recurring)) || a.month - b.month,
);
---

<div class="nb-table">
  <table>
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{when}</th>
        <th scope="col">{what}</th>
        <th scope="col">{need}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.when[locale]}</th>
          <td>{r.what[locale]}</td>
          <td>{r.need[locale]}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style is:global>
  .nb-prose tbody th {
    border-bottom: 1px solid var(--piedra-200);
    font-weight: 600;
    white-space: normal;
    min-width: 9rem;
  }
</style>
