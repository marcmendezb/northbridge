---
/**
 * A country's tax year as a four-lane chart (VAT, taxes, payments, payroll) plus a list
 * with the exact date of each deadline. Dates come from each deadline's legal rule
 * (src/lib/fiscal) with the country's holidays: the server renders the build year and the browser
 * recalculates the current year. Rendered once per calendar; `countries` decides which countries see it.
 */
import Arrow from '../brand/Arrow.astro';
import { useI18n, type Messages } from '../../i18n';
import type { Country } from '../../lib/country';
import {
  CALENDAR_NOTES,
  FISCAL_CALENDARS,
  type CalendarCountry,
  type FiscalEvent,
} from '../../data/fiscal-calendar';
import { zurichNow, type CivilDate } from '../../lib/contact/office';
import { HOLIDAYS } from '../../lib/fiscal/deadlines';
import { vatFor } from '../../lib/vat';
import { monthMarks, timeline } from '../../lib/fiscal/timeline';

interface Props {
  calendar: CalendarCountry;
  countries: Country[];
  guideHref?: string;
}
const { calendar, countries, guideHref } = Astro.props;
const cal = calendar.toLowerCase();
const { t, tRaw, locale } = useI18n(Astro.currentLocale);
const y = tRaw<Messages['services']['detail']['year']>('services.detail.year');
/** Lane names using the country's VAT name ("MwSt." outside Switzerland, in German). */
const cats = Object.fromEntries(
  Object.entries(y.cats).map(([k, v]) => [k, vatFor(v, calendar, locale)]),
) as typeof y.cats;
const note = CALENDAR_NOTES[calendar][locale];

type Cat = 'vat' | 'tax' | 'pay' | 'payroll';
/** Lane: the one set in the data or, in the Swiss calendar, inferred from the id. */
const catOf = (e: FiscalEvent): Cat =>
  e.cat ??
  (e.id.startsWith('vat')
    ? 'vat'
    : e.id.startsWith('ahv') || e.id.startsWith('salary')
      ? 'payroll'
      : e.id === 'federal-tax' || e.id === 'cantonal-tax'
        ? 'pay'
        : 'tax');
const events: FiscalEvent[] = FISCAL_CALENDARS[calendar] ?? [];
/** Legal rule for each deadline: the browser uses them to recalculate the current year. */
const ruled = events.flatMap((e) => (e.rule && !e.recurring ? [{ id: e.id, rule: e.rule }] : []));
/** Monthly deadlines (contributions): list only, at the end and without a date. */
const recurring = events
  .filter((e) => e.recurring)
  .map((e) => ({
    id: e.id,
    cat: catOf(e),
    when: e.when[locale],
    what: e.what[locale],
    need: e.need[locale],
  }));
/** Without JS the build year is shown; with JS, the current year. */
const buildYear = zurichNow(new Date()).y;
const items = timeline(ruled, buildYear, HOLIDAYS[calendar]).map((it) => {
  const e = events.find((c) => c.id === it.id)!;
  return {
    ...it,
    cat: catOf(e),
    short: (e.short ?? e.what)[locale],
    extends: e.extends,
    minor: Boolean(e.minor),
    when: e.when[locale],
    what: e.what[locale],
    need: e.need[locale],
  };
});
/** Windows without a legal date (certificates) stay out of the chart: list only. */
/** Lanes with at least one dated deadline (in France, VAT and DSN have none: list only). */
const lanes = (['vat', 'tax', 'pay', 'payroll'] as const)
  .map((cat) => ({ cat, items: items.filter((it) => it.cat === cat && !it.window) }))
  .filter((l) => l.items.length);
/** Legend for minor marks: in Switzerland, AHV contributions; elsewhere, whatever they are there. */
const minorShorts = [...new Set(items.filter((it) => it.minor).map((it) => it.short))];
const minorLabel = calendar === 'CH' ? y.minor : minorShorts.join(', ');
/** Near the end of the year, the label goes to the left of its flag. */
const FLIP_AT = 0.8;
const marks = monthMarks(buildYear);
const dateTag = locale === 'en' ? 'en-GB' : locale;
const fmt = (d: CivilDate, o: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat(dateTag, { timeZone: 'UTC', ...o }).format(
    new Date(Date.UTC(d.y, d.m - 1, d.d, 12)),
  );
const dayMonth = (d: CivilDate) => fmt(d, { day: 'numeric', month: 'long' });
const dayShort = (d: CivilDate) => fmt(d, { day: 'numeric', month: 'short' }).replace(/\.$/, '');
const monthShort = (m: number) =>
  fmt({ y: buildYear, m, d: 15 }, { month: 'short' }).replace(/\.$/, '');
const pct = (f: number) => `${(f * 100).toFixed(3)}%`;
---

<section
  class="nb-yr"
  aria-labelledby={`year-title-${cal}`}
  data-year
  data-cc={countries.join(' ')}
  data-calendar={calendar}
>
  <div class="nb-container">
    <div class="nb-yr__head">
      <div class="nb-yr__intro">
        <p class="nb-yr__eyebrow">{y.label}</p>
        <h2 id={`year-title-${cal}`} class="nb-yr__title" data-reveal>
          {y.title}
        </h2>
        <p class="nb-yr__lead" data-reveal>
          {y.lead}
        </p>
      </div>
      <aside class="nb-yr__next" data-yr-next hidden aria-live="polite">
        <p class="nb-yr__next-label">{y.next}</p>
        <p class="nb-yr__next-date" data-yr-next-date />
        <p class="nb-yr__next-left" data-yr-next-left />
        <p class="nb-yr__next-what" data-yr-next-what />
        <p class="nb-yr__next-when" data-yr-next-when />
        <p class="nb-yr__next-need">
          <span>{y.need}</span>
          <span data-yr-next-need />
        </p>
      </aside>
    </div>

    <div
      class="nb-chart"
      data-yr-ruler
      data-year={buildYear}
      data-locale={locale}
      data-events={JSON.stringify(ruled)}
      data-remind={y.remind}
      data-left-today={y.leftToday}
      data-left-one={y.leftOne}
      data-left-many={y.leftMany}
      role="group"
      aria-label={t('services.detail.year.ruler', { count: items.length })}
    >
      <div class="nb-chart__scroll" data-lenis-prevent-horizontal>
        <div class="nb-chart__frame">
          <ul
            class="nb-chart__names"
            role="list"
            aria-hidden="true"
            style={`--lanes:${lanes.length}`}
          >
            <li class="nb-chart__year" data-yr-year>
              {buildYear}
            </li>
            {lanes.map((l) => (
              <li class:list={['nb-chart__name', `nb-chart__name--${l.cat}`]}>
                <span class="nb-chart__swatch" />
                {cats[l.cat]}
              </li>
            ))}
          </ul>

          <div class="nb-chart__plot" style={`--lanes:${lanes.length}`}>
            <ol class="nb-chart__months" role="list" aria-hidden="true">
              {marks.map((mk) => (
                <li
                  class="nb-chart__month"
                  data-month-label={mk.m}
                  style={`--at:${pct(mk.at)};--w:${pct(mk.w)}`}
                >
                  <span>{monthShort(mk.m)}</span>
                </li>
              ))}
            </ol>

            {lanes.map((l) => (
              <div
                class:list={['nb-chart__lane', `nb-chart__lane--${l.cat}`]}
                style={`grid-row:${lanes.indexOf(l) + 2}`}
              >
                {l.items.map((it) => (
                  <>
                    {it.extends && (
                      <span
                        class="nb-chart__extension"
                        data-yr-ext={it.id}
                        data-from={it.extends}
                        style={`--from:${pct(l.items.find((b) => b.id === it.extends)?.at ?? it.at)};--at:${pct(it.at)}`}
                        aria-hidden="true"
                      />
                    )}
                    {it.window && (
                      <span
                        class="nb-chart__window"
                        data-yr-span={it.id}
                        style={`--from:${pct(it.startAt)};--at:${pct(it.at)}`}
                        aria-hidden="true"
                      />
                    )}
                    {!it.minor && (
                      <span
                        class="nb-chart__runway"
                        data-yr-alert={it.id}
                        style={`--from:${pct(it.remindAt)};--at:${pct(it.at)}`}
                        aria-hidden="true"
                      />
                    )}
                    <a
                      href={`#plazo-${cal}-${it.id}`}
                      class:list={[
                        'nb-chart__flag',
                        it.window && 'is-window',
                        it.extends && 'is-extension',
                        it.minor && 'is-minor',
                        !it.window && it.at > FLIP_AT && 'is-flip',
                      ]}
                      data-yr-dot
                      data-id={it.id}
                      style={`--at:${pct(it.window ? it.startAt : it.at)}`}
                      aria-label={`${it.what}: ${it.window ? it.when : dayMonth(it.due)}`}
                    >
                      <span class="nb-chart__stem" aria-hidden="true" />
                      <span class="nb-chart__pin" aria-hidden="true" />
                      <span class="nb-chart__tag" aria-hidden="true">
                        <span class="nb-chart__next">{y.next}</span>
                        <strong data-yr-flag-date>{it.window ? it.when : dayShort(it.due)}</strong>
                        <span>{it.short}</span>
                      </span>
                      <span class="nb-chart__tip" aria-hidden="true">
                        <span class="nb-chart__tip-what">{it.what}</span>
                        <span class="nb-chart__tip-need">{it.need}</span>
                      </span>
                    </a>
                  </>
                ))}
              </div>
            ))}

            <span class="nb-chart__today" data-yr-today hidden aria-hidden="true">
              <span>{y.today}</span>
            </span>
          </div>
        </div>
      </div>

      <ul class="nb-chart__legend" role="list">
        <li>
          <span class="nb-chart__legend-runway" />
          {y.alert}
        </li>
        {minorShorts.length > 0 && (
          <li>
            <span class="nb-chart__legend-minor" />

            {minorLabel}
          </li>
        )}
        <li>
          <span class="nb-chart__legend-today" />
          {y.today}
        </li>
        <li>
          <span class="nb-chart__legend-next" />
          {y.next}
        </li>
      </ul>
    </div>

    <ol class="nb-yr__list" role="list" data-yr-list>
      {items.map((it) => (
        <li
          class="nb-yr__event"
          id={`plazo-${cal}-${it.id}`}
          data-yr-event={it.id}
          data-window={it.window ? '' : undefined}
          data-reveal
        >
          <p class="nb-yr__date">
            <span data-yr-date>{it.window ? it.when : dayMonth(it.due)}</span>
            {!it.window && (
              <span class="nb-yr__weekday" data-yr-weekday>
                {fmt(it.due, { weekday: 'long' })}
              </span>
            )}
          </p>
          <span class:list={['nb-yr__cat', `nb-yr__cat--${it.cat}`]}>{cats[it.cat]}</span>
          <p class="nb-yr__what">{it.what}</p>
          <p class="nb-yr__when">{it.window ? y.window : it.when}</p>
          <p class="nb-yr__shifted" data-yr-shifted hidden={!it.shifted}>
            {y.shifted}
          </p>
          <p class="nb-yr__need">{it.need}</p>
          <p class="nb-yr__remind" data-yr-remind>
            {y.remind.replace('{date}', dayMonth(it.remind))}
          </p>
        </li>
      ))}
      {recurring.map((e) => (
        <li class="nb-yr__event nb-yr__event--recurring" id={`plazo-${cal}-${e.id}`} data-reveal>
          <p class="nb-yr__date">
            <span>{e.when}</span>
          </p>
          <span class:list={['nb-yr__cat', `nb-yr__cat--${e.cat}`]}>{cats[e.cat]}</span>
          <p class="nb-yr__what">{e.what}</p>
          <p class="nb-yr__need">{e.need}</p>
        </li>
      ))}
    </ol>

    <div class="nb-yr__foot">
      <p>{note}</p>
      {guideHref && (
        <a href={guideHref} class="nb-yr__guide">
          {y.guide}
          <Arrow size={18} />
        </a>
      )}
    </div>
  </div>
</section>

<script>
  import { zurichNow, type CivilDate } from '../../lib/contact/office';
  import { daysBetween, HOLIDAYS, yearFraction } from '../../lib/fiscal/deadlines';
  import { monthMarks, nextDeadline, timeline, type RuledEvent } from '../../lib/fiscal/timeline';

  // The current tax year (Zurich time): exact dates, today and the next deadline.
  // Without JS, the build year stays, also with exact dates.
  // Each mounted calendar (other countries' ones arrive from <template> when the country changes).
  const setup = (section: HTMLElement) => {
    const ruler = section.querySelector<HTMLElement>('[data-yr-ruler]');
    if (!ruler || section.dataset.yearReady) return;
    section.dataset.yearReady = '1';
    const holidays = HOLIDAYS[(section.dataset.calendar ?? 'CH') as keyof typeof HOLIDAYS];
    const ds = ruler.dataset;
    const events = JSON.parse(ds.events ?? '[]') as RuledEvent[];
    const tag = ds.locale === 'en' ? 'en-GB' : (ds.locale ?? 'es');
    const fmt = (d: CivilDate, o: Intl.DateTimeFormatOptions) =>
      new Intl.DateTimeFormat(tag, { timeZone: 'UTC', ...o }).format(
        new Date(Date.UTC(d.y, d.m - 1, d.d, 12)),
      );
    const dayMonth = (d: CivilDate) => fmt(d, { day: 'numeric', month: 'long' });
    const pct = (f: number) => `${(f * 100).toFixed(3)}%`;
    const z = zurichNow(new Date());
    const today = { y: z.y, m: z.m, d: z.d };
    const items = timeline(events, today.y, holidays);
    const q = <T extends Element = HTMLElement>(sel: string) => ruler.querySelector<T>(sel);

    // Ruler for the current year.
    const year = q('[data-yr-year]');
    if (year) year.textContent = String(today.y);
    monthMarks(today.y).forEach((mk) => {
      const label = q(`[data-month-label="${mk.m}"]`);
      label?.style.setProperty('--at', pct(mk.at));
      label?.style.setProperty('--w', pct(mk.w));
      label?.classList.toggle('is-now', mk.m === today.m);
    });
    const dayShort = (d: CivilDate) =>
      fmt(d, { day: 'numeric', month: 'short' }).replace(/\.$/, '');
    const list = section.querySelector<HTMLElement>('[data-yr-list]');
    items.forEach((it) => {
      const runway = q(`[data-yr-alert="${it.id}"]`);
      runway?.style.setProperty('--from', pct(it.remindAt));
      runway?.style.setProperty('--at', pct(it.at));
      const span = q(`[data-yr-span="${it.id}"]`);
      span?.style.setProperty('--from', pct(it.startAt));
      span?.style.setProperty('--at', pct(it.at));
      const ext = q(`[data-yr-ext="${it.id}"]`);
      const base = ext && items.find((b) => b.id === ext.dataset.from);
      if (ext && base) {
        ext.style.setProperty('--from', pct(base.at));
        ext.style.setProperty('--at', pct(it.at));
      }
      // Flag: position, short date, label side and whether it is already past.
      const flag = q(`[data-yr-dot][data-id="${it.id}"]`);
      if (flag) {
        flag.style.setProperty('--at', pct(it.window ? it.startAt : it.at));
        flag.classList.toggle('is-flip', !it.window && it.at > 0.8);
        flag.classList.toggle('is-past', daysBetween(today, it.due) < 0);
        const short = flag.querySelector('[data-yr-flag-date]');
        if (short && !it.window) short.textContent = dayShort(it.due);
      }
      // List: date, weekday, reminder and weekend note; in due-date order.
      const row = list?.querySelector<HTMLElement>(`[data-yr-event="${it.id}"]`);
      if (!row) return;
      if (!('window' in row.dataset)) {
        const date = row.querySelector('[data-yr-date]');
        const weekday = row.querySelector('[data-yr-weekday]');
        if (date) date.textContent = dayMonth(it.due);
        if (weekday) weekday.textContent = fmt(it.due, { weekday: 'long' });
      }
      const shifted = row.querySelector<HTMLElement>('[data-yr-shifted]');
      if (shifted) shifted.hidden = !it.shifted;
      const remind = row.querySelector('[data-yr-remind]');
      if (remind) remind.textContent = (ds.remind ?? '').replace('{date}', dayMonth(it.remind));
      list?.append(row);
    });
    // Monthly deadlines last.
    list?.querySelectorAll('.nb-yr__event--recurring').forEach((r) => list.append(r));

    // Today.
    const mark = q('[data-yr-today]');
    if (mark) {
      mark.style.setProperty('--at', pct(yearFraction(today)));
      mark.hidden = false;
    }

    // Next deadline (may be next year) and the days left.
    const next = nextDeadline(events, today, holidays);
    const panel = section.querySelector<HTMLElement>('[data-yr-next]');
    const source = next && list?.querySelector<HTMLElement>(`[data-yr-event="${next.id}"]`);
    if (next && panel && source) {
      const text = (sel: string) => source.querySelector(sel)?.textContent?.trim() ?? '';
      const set = (sel: string, value: string) => {
        const el = panel.querySelector(sel);
        if (el) el.textContent = value;
      };
      const left =
        next.daysLeft === 0
          ? ds.leftToday
          : next.daysLeft === 1
            ? ds.leftOne
            : (ds.leftMany ?? '').replace('{n}', String(next.daysLeft));
      set(
        '[data-yr-next-date]',
        next.year === today.y
          ? dayMonth(next.due)
          : fmt(next.due, { day: 'numeric', month: 'long', year: 'numeric' }),
      );
      set('[data-yr-next-left]', `${left ?? ''} / ${fmt(next.due, { weekday: 'long' })}`);
      set('[data-yr-next-what]', text('.nb-yr__what'));
      set('[data-yr-next-when]', text('.nb-yr__when'));
      set('[data-yr-next-need]', text('.nb-yr__need'));
      panel.hidden = false;
      source.classList.add('is-next');
      if (next.year === today.y) q(`[data-yr-dot][data-id="${next.id}"]`)?.classList.add('is-next');
      // The panel changes the page height: scroll scenes measure again.
      window.dispatchEvent(new Event('resize'));
    }
  };
  document.querySelectorAll<HTMLElement>('section[data-year]').forEach(setup);
  document.addEventListener('nb:year-mounted', (e) => {
    const section = (e as CustomEvent).detail;
    if (section instanceof HTMLElement) setup(section);
  });
</script>

<style is:global>
  /* ── VAT · The tax year ── */
  .nb-yr {
    padding-block: var(--section-y);
    background: var(--white);
  }
  .nb-yr__head {
    display: grid;
    gap: 40px;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .nb-yr__head {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: clamp(48px, 6vw, 112px);
    }
  }
  .nb-yr__intro {
    display: grid;
    gap: 20px;
  }
  .nb-yr__eyebrow,
  .nb-scope__eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-600);
  }
  .nb-yr__title {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1rem + 4vw, 5.25rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--navy-800);
  }
  .nb-yr__lead {
    margin: 0;
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--piedra-800);
  }
  /* Next deadline: navy panel, the only dark element in the section. */
  .nb-yr__next {
    display: grid;
    gap: 8px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-card, 8px);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-yr__next[hidden] {
    display: none;
  }
  .nb-yr__next p {
    margin: 0;
  }
  .nb-yr__next-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-300);
  }
  .nb-yr__next-date {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.4rem + 1.8vw, 3.25rem);
    font-weight: 300;
    /* Upright: the italic font (144 KB) would be downloaded just for this date and delays the LCP. */
    line-height: 1.05;
    color: var(--white);
  }
  .nb-yr__next-left {
    margin-bottom: 6px !important;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--salvia-300);
  }
  .nb-yr__next-what {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--white);
  }
  .nb-yr__next-when {
    font-size: 0.9375rem;
  }
  .nb-yr__next-need {
    display: grid;
    gap: 2px;
    margin-top: 8px !important;
    padding-top: 14px;
    border-top: 1px solid var(--navy-600);
    font-size: 0.9375rem;
  }
  .nb-yr__next-need span:first-child {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy-200);
  }

  /* ── The yearly chart: lanes (VAT, taxes, payments, payroll) across the twelve months ── */
  .nb-chart {
    --lane: 84px;
    --names: 132px;
    --head: 44px;
    margin-top: clamp(48px, 7vw, 88px);
  }
  /* On narrow screens the year scrolls inside its frame (the page doesn't). */
  .nb-chart__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }
  .nb-chart__frame {
    display: grid;
    grid-template-columns: var(--names) minmax(0, 1fr);
    min-width: 960px;
    border-top: 1.5px solid var(--navy-800);
    border-bottom: 1.5px solid var(--navy-800);
  }
  .nb-chart__names {
    display: grid;
    grid-template-rows: var(--head) repeat(var(--lanes, 4), var(--lane));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nb-chart__year {
    align-self: center;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    font-variant-numeric: tabular-nums;
    color: var(--piedra-600);
  }
  .nb-chart__name {
    display: flex;
    align-items: center;
    gap: 10px;
    border-top: 1px solid var(--piedra-200);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy-800);
  }
  .nb-chart__swatch {
    width: 12px;
    height: 12px;
    border: 2px solid var(--navy-800);
    border-radius: 9999px;
    background: var(--navy-800);
  }
  .nb-chart__name--tax .nb-chart__swatch {
    background: var(--white);
  }
  .nb-chart__name--pay .nb-chart__swatch {
    border-radius: 2px;
  }
