---
/** Pasos con línea conectora que se dibuja con el scroll y remata en arco (docs/06, momento 2). */
interface Step {
  title: string;
  text: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
const cols = steps.length === 4 ? 'md:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-3';
const horizontal = steps.length === 4 ? 'lg' : 'md';
---

<div data-connector class="relative">
  <div
    data-connector-line="h"
    class:list={[
      'absolute top-0 right-6 left-0 hidden h-[1.5px] origin-left bg-navy-800',
      horizontal === 'lg' ? 'lg:block' : 'md:block',
    ]}
  ></div>
  <div
    data-connector-line="v"
    class:list={[
      'absolute top-2 bottom-0 left-[4px] block w-[1.5px] origin-top bg-navy-800',
      horizontal === 'lg' ? 'lg:hidden' : 'md:hidden',
    ]}
  ></div>
  <svg
    data-connector-arch
    class:list={[
      'absolute top-0 right-0 hidden h-[14px] w-6 -translate-y-px text-navy-800',
      horizontal === 'lg' ? 'lg:block' : 'md:block',
    ]}
    viewBox="0 0 24 14"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path d="M1 14V10A11 11 0 0 1 23 10V14" pathLength="1"></path>
  </svg>
  <ol class:list={['m-0 grid list-none gap-12 p-0 md:gap-10', cols]}>
    {steps.map((step) => (
      <li
        data-reveal
        class:list={['relative pl-10 md:pl-0', horizontal === 'lg' ? 'lg:pt-10' : 'md:pt-10']}
      >
        <span
          class:list={[
            'absolute top-[0.35rem] left-0 block h-[9px] w-[9px] rounded-full border-[1.5px] border-navy-800 bg-white',
            horizontal === 'lg' ? 'lg:top-0 lg:-translate-y-1/2' : 'md:top-0 md:-translate-y-1/2',
          ]}
          aria-hidden="true"
        ></span>
        <h3 class="m-0 mb-3">{step.title}</h3>
        <p class="t-body m-0">{step.text}</p>
      </li>
    ))}
  </ol>
</div>
