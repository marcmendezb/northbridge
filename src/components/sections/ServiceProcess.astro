---
/**
 * "How we work" on the service page. A navy band: the headline is sticky on the left and, on the
 * right, large steps joined by a line that fills with the scroll; each step's brand arch
 * lights up as it is reached (serviceScene.ts). Without JS or with reduced
 * motion, everything is lit. No numbering.
 */
interface Step {
  title: string;
  text: string;
}
interface Props {
  steps: Step[];
  label: string;
  title: string;
  /** Countries that see this version (`data-cc`); empty means all. */
  countries?: string;
  uid?: string;
}
const { steps, label, title, countries, uid = '0' } = Astro.props;
---

<section
  class="nb-way-steps"
  data-surface="dark"
  data-steps-path
  data-cc={countries}
  aria-labelledby={`process-title-${uid}`}
>
  <div class="nb-container nb-way-steps__grid">
    <div class="nb-way-steps__head">
      <p class="nb-way-steps__eyebrow">{label}</p>
      <h2
        id={`process-title-${uid}`}
        class="nb-way-steps__title"
        data-split={countries ? undefined : ''}
        data-reveal={countries ? '' : undefined}
      >
        {title}
      </h2>
    </div>

    <ol class="nb-way-steps__list" role="list">
      {steps.map((s, i) => (
        <li class="nb-way-steps__step" data-steps-item>
          {i < steps.length - 1 && (
            <span class="nb-way-steps__rail" aria-hidden="true">
              <span data-steps-fill />
            </span>
          )}
          <svg class="nb-way-steps__mark" viewBox="4 11 40 26" aria-hidden="true">
            <path d="M4 13H44" />
            <path d="M10 37V29A14 14 0 0 1 38 29V37" />
          </svg>
          <h3 class="nb-way-steps__step-title">{s.title}</h3>
          <p class="nb-way-steps__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .nb-way-steps {
    padding-block: var(--section-y);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-way-steps__grid {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .nb-way-steps__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(48px, 6vw, 112px);
      align-items: start;
    }
    .nb-way-steps__head {
      position: sticky;
      top: calc(var(--header-h) + 40px);
    }
  }
  .nb-way-steps__head {
    display: grid;
    gap: 16px;
  }
  .nb-way-steps__eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-300);
  }
  .nb-way-steps__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1rem + 3.6vw, 4.5rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--white);
  }

  /* Steps: each arch joins the next with a segment that fills in white.
     The arch and the segment share --mark so they always stay centred. */
  .nb-way-steps__list {
    --mark: 48px;
    --gutter: 72px;
    --gap: clamp(40px, 5vw, 64px);
    position: relative;
    display: grid;
    gap: var(--gap);
    margin: 0;
    padding: 0 0 0 var(--gutter);
    list-style: none;
  }
  .nb-way-steps__step {
    position: relative;
    display: grid;
    gap: 12px;
  }
  .nb-way-steps__mark {
    position: absolute;
    top: 0;
    left: calc(-1 * var(--gutter));
    width: var(--mark);
    height: calc(var(--mark) * 0.65);
    fill: none;
    stroke: var(--navy-500);
    stroke-width: 4;
    transition: stroke var(--dur-base) var(--ease-out);
  }
  .nb-way-steps__rail {
    position: absolute;
    top: calc(var(--mark) * 0.65 + 8px);
    left: calc(-1 * var(--gutter) + var(--mark) / 2 - 1px);
    width: 2px;
    height: calc(100% + var(--gap) - var(--mark) * 0.65 - 16px);
    background: var(--navy-600);
  }
  .nb-way-steps__rail > span {
    position: absolute;
    inset: 0;
    background: var(--white);
    transform-origin: top;
  }
  .nb-way-steps__step-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1rem + 1.8vw, 3rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--navy-300);
    transition: color var(--dur-base) var(--ease-out);
  }
  .nb-way-steps__text {
    margin: 0;
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--navy-200);
    transition: color var(--dur-base) var(--ease-out);
  }
  /* Lit (reached on scroll; always without JS or with reduced motion). */
  .nb-way-steps__step.is-on .nb-way-steps__mark,
  :root:not(.motion) .nb-way-steps__mark {
    stroke: var(--salvia-300);
  }
  .nb-way-steps__step.is-on .nb-way-steps__step-title,
  :root:not(.motion) .nb-way-steps__step-title {
    color: var(--white);
  }
  .nb-way-steps__step.is-on .nb-way-steps__text,
  :root:not(.motion) .nb-way-steps__text {
    color: var(--navy-100);
  }
  @media (max-width: 639px) {
    .nb-way-steps__list {
      --mark: 36px;
      --gutter: 56px;
    }
  }
</style>
