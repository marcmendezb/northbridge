---
import Section from '../ui/Section.astro';
import { useI18n } from '../../i18n';
const { t } = useI18n(Astro.currentLocale);
/** "Years in Zurich" in Switzerland; "of experience" in other countries. */
const yearsLabel = byCountry((c) => t(c === 'CH' ? 'home.stats.years' : 'home.stats.yearsIntl'));

const stats = [
  { value: 200, suffix: '+', label: t('home.stats.clients'), count: true },
  { value: 10, suffix: '+', label: yearsLabel, count: true },
  { value: 1, suffix: '', label: t('home.stats.contact'), count: false },
];
import { byCountry } from '../../lib/country';
---

<Section tone="navy" class="nb-statement">
  <h2 class="sr-only">{t('home.stats.title')}</h2>
  <dl class="m-0 flex flex-col">
    {stats.map((s) => (
      <div data-reveal class="nb-stat">
        <dt class="sr-only" set:html={`${s.value}${s.suffix} ${s.label}`} />
        <dd class="m-0" aria-hidden="true">
          <span class="nb-stat__num t-figure">
            <span data-count={s.count ? s.value : undefined}>{s.value}</span>
            {s.suffix}
          </span>
          <span class="nb-stat__label" set:html={s.label} />
        </dd>
      </div>
    ))}
  </dl>
</Section>

<style is:global>
  .nb-stat {
    border-top: 1px solid var(--navy-600);
    padding-block: clamp(20px, 3vw, 36px);
  }
  .nb-stat:last-child {
    border-bottom: 1px solid var(--navy-600);
  }
  .nb-stat dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 clamp(16px, 3vw, 48px);
  }
  .nb-stat__num {
    font-size: clamp(4.5rem, 2rem + 11vw, 11rem);
    line-height: 0.9;
    color: var(--salvia-300);
  }
  /* One column for the figures, so every label starts on the same line; on phones it sits below. */
  @media (min-width: 640px) {
    .nb-stat dd {
      flex-wrap: nowrap;
    }
    .nb-stat__num {
      flex: none;
      min-width: 4.2ch;
    }
  }
  @media (max-width: 639px) {
    .nb-stat dd {
      flex-direction: column;
      gap: 8px;
    }
  }
  .nb-stat__label {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 300;
    font-size: clamp(1.5rem, 1rem + 2.2vw, 3rem);
    line-height: 1.1;
    color: var(--piedra-50);
    letter-spacing: -0.01em;
  }
</style>
