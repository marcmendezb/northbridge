---
import { Picture, getImage } from 'astro:assets';
import heroPoster from '../../assets/img/home/hero-poster.jpg';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { useI18n } from '../../i18n';
import { getBookingCta } from '../../lib/site';
const { t, lp, locale } = useI18n(Astro.currentLocale);
/** Credentials: "10+ years in Zurich" in Switzerland; "of experience" in other countries. */
const proofOf = (c: Country) =>
  t(c === 'CH' ? 'home.hero.proof' : 'home.hero.proofIntl').split(' / ');
const facts = proofOf('CH').map((_, i) => byCountry((c) => proofOf(c)[i] ?? ''));
const bookingCta = getBookingCta(locale);
const posterFile = await getImage({ src: heroPoster, format: 'webp', width: 1920, quality: 76 });
import { byCountry, type Country } from '../../lib/country';
import { withCity } from '../../data/offices';
---

<section data-hero class="hero" aria-labelledby="hero-title">
  <div class="hero__stage">
    <!-- Full-bleed photo. On scroll it shrinks until it is framed by the brand's arch. -->
    <div class="hero__photo" data-hero-photo>
      <div class="hero__media" data-hero-media>
        <Picture
          src={heroPoster}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          quality={74}
          class="hero__img"
        />
        <!-- Muted video that plays forwards and backwards: the file already contains both directions, so loop repeats it seamlessly. Without JS or with reduced motion the first frame stays. -->
        <video
          class="hero__video"
          data-hero-video
          data-poster={posterFile.src}
          muted
          loop
          playsinline
          preload="none"
          tabindex="-1"
          aria-hidden="true"
          disablepictureinpicture
          disableRemotePlayback
        >
          <source src="/video/hero-home.webm" type="video/webm" />
          <source src="/video/hero-home.mp4" type="video/mp4" />
        </video>
      </div>

      <!-- Image footer: credentials and scroll cue. It shrinks with the photo and becomes the base of the arch. -->
      <div class="hero__band" data-hero-band data-hero-fade="0.85">
        <div class="hero__band-inner">
          <ul class="hero__facts">
            {facts.map((f) => (
              <li set:html={f} />
            ))}
          </ul>
          <span class="hero__scroll" aria-hidden="true">
            {t('home.hero.scroll')}
            <span class="hero__scroll-arrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path
                  d="M12 4V19M6 13L12 19L18 13"
                  stroke-linecap="butt"
                  stroke-linejoin="miter"
                ></path>
              </svg>
            </span>
          </span>
        </div>
      </div>
    </div>

    <div class="hero__intro" data-surface="dark">
      <div class="hero__intro-inner nb-container">
        <h1 id="hero-title" class="hero__title t-display m-0 text-white">
          <span class="hero__mask">
            <span data-hero-line class="block">
              {t('home.hero.line1')}
            </span>
          </span>
          <span class="hero__mask">
            <span data-hero-line class="block">
              {t('home.hero.line2')}
            </span>
          </span>
        </h1>
        <div class="hero__aside">
          <p data-hero-fade="0.5" class="hero__sub m-0 font-serif font-light text-navy-100">
            <Fragment set:html={byCountry((c) => withCity(t('brand.descriptor'), c, locale))} />
          </p>
          <div data-hero-fade="0.62" class="flex flex-wrap items-center gap-4">
            <Button href={bookingCta.href} on="dark" arrow>
              {t('cta.book')}
            </Button>
            <Button href={lp('/calculadora')} variant="secondary">
              {t('cta.calculate')}
            </Button>
          </div>
        </div>
      </div>
    </div>

    <!-- The promise: appears once the photo has become an arch. Without JS or with reduced motion, it is the block after the hero. -->
    <div class="hero__promise" data-hero-promise data-surface="dark">
      <Container class="hero__promise-inner">
        <p class="hero__eyebrow t-eyebrow m-0 !text-salvia-300">{t('home.proposal.label')}</p>
        <svg
          class="hero__rule"
          data-hero-rule
          viewBox="0 0 400 4"
          preserveAspectRatio="none"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M0 2H400" pathLength="1"></path>
        </svg>
        <p class="hero__promise-title m-0 font-serif font-light text-piedra-50">
          {t('brand.promise')}
        </p>
        <div class="hero__promise-body flex flex-col gap-4">
          <p class="hero__lead m-0">{t('home.proposal.body1')}</p>
          <p class="t-body m-0 !text-navy-100">{t('home.proposal.body2')}</p>
        </div>
        <div class="hero__promise-cta">
          <Button href={lp('/nosotros')} on="dark" arrow>
            {t('home.proposal.cta')}
          </Button>
        </div>
      </Container>
    </div>
  </div>
</section>

<style is:global>
  /* ── Base (no JS, reduced motion and mobile): photo with the text over the navy half and the promise below ── */
  .hero {
    --band-h: 64px;
    --band-gap: 24px;
    position: relative;
    background: var(--navy-800);
  }
  .hero__stage {
    position: relative;
  }
  .hero__photo {
    position: absolute;
    inset: 0 0 auto 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--navy-800);
  }
  .hero__media {
    position: absolute;
    inset: 0;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 18% 50%;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 18% 50%;
    display: block;
  }
  .hero__intro {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + 24px);
    padding-bottom: calc(var(--band-h) + var(--band-gap) + 32px);
  }
  /* Everything aligned left, on the same margin as the header logo (.nb-container). */
  .hero__intro-inner {
    --hero-title: clamp(2.75rem, 0.5rem + 5.2vw, 5.25rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero__title {
    font-size: var(--hero-title);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }
  .hero__mask {
    display: block;
    overflow: hidden;
  }
  .hero__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    margin-top: clamp(24px, 4svh, 40px);
  }
  @media (min-width: 768px) and (min-height: 560px) {
    /* The text column stays clear of the video's light wall. */
    .hero__aside {
      max-width: 36vw;
    }
  }
  /* ── Bottom band ── */
  /* Floating bar at the bottom, mirroring the header: same width, bottom spacing and card corners. */
  .hero__band {
    --band-x: max(var(--header-gutter), (100% - var(--header-max)) / 2);
    position: absolute;
    inset: auto var(--band-x) var(--band-gap) var(--band-x);
    height: var(--band-h);
    border-radius: var(--radius-card, 8px);
    --band-fg: var(--navy-100);
    --band-divider: var(--navy-600);
    background: var(--navy-800);
    border: 1px solid var(--navy-700);
    color: var(--band-fg);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }
  .hero__band-inner {
    padding-inline: var(--header-pad);
    display: flex;
    align-items: center;
    gap: 32px;
    height: 100%;
  }
  .hero__facts {
    display: flex;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero__facts li + li {
    margin-left: 20px;
    padding-left: 20px;
    border-left: 1px solid var(--band-divider);
  }
  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }
  .hero__scroll-arrow {
    display: inline-flex;
    width: 18px;
    height: 18px;
  }
  .hero__scroll-arrow svg {
    width: 100%;
    height: 100%;
    animation: hero-down 2.4s var(--ease-in-out) infinite;
  }
  /* A short nudge down and back: the arrow is always visible and the direction is clear. */
  @keyframes hero-down {
    0%,
    55%,
    100% {
      transform: translateY(0);
    }
    25% {
      transform: translateY(5px);
    }
  }

  .hero__sub {
    max-width: 24rem;
    font-size: 1.25rem;
    line-height: 1.4;
  }
  .hero__promise {
    position: relative;
    padding-block: var(--section-y);
    background: var(--navy-800);
  }
  .hero__promise-inner {
    display: grid;
    gap: 32px;
  }
  .hero__rule {
    display: block;
    width: 100%;
    height: 4px;
    color: var(--navy-400);
  }
  .hero__promise-title {
    font-size: clamp(2.25rem, 1.1rem + 3.7vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .hero__lead {
    max-width: 38rem;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: 1.375rem;
    font-weight: 300;
    line-height: 1.4;
    color: var(--piedra-50);
  }
  @media (min-width: 768px) {
    .hero__promise-inner {
      grid-template-columns: 1.2fr 1fr;
      gap: 64px;
      align-items: end;
    }
    .hero__rule,
    .hero__eyebrow,
    .hero__promise-title,
    .hero__promise-body,
    .hero__promise-cta {
      grid-column: 1 / -1;
    }
  }
  /* On mobile the photo takes the top part and the text sits on plain navy, so it is always readable. */
  @media (max-width: 767px), (max-height: 559px) {
    .hero__photo {
      height: 54svh;
      min-height: 0;
    }
    .hero__img,
    .hero__video {
      object-position: 80% 50%;
    }
    .hero__stage {
      background: var(--navy-800);
    }
    .hero__intro {
      min-height: 0;
      padding-top: calc(54svh + 32px);
    }
    .hero__photo {
      z-index: 0;
    }
    .hero__intro-inner {
      position: relative;
      z-index: 1;
    }
    .hero__intro {
      flex-direction: column;
      align-items: stretch;
      padding-bottom: 0;
    }
    .hero__band {
      --band-gap: 12px;
      height: auto;
      padding-block: 14px;
    }
    .hero__scroll {
      display: none;
    }
  }

  /* ── Scroll scene (desktop with motion only): the hero pins and the photo turns into an arch ── */
  @media (min-width: 768px) and (min-height: 560px) {
    .js.motion:not(.anim-fail) .hero {
      height: 250svh;
    }
    .js.motion:not(.anim-fail) .hero__stage {
      position: sticky;
      top: 0;
      height: 100svh;
      overflow: hidden;
    }
    .js.motion:not(.anim-fail) .hero__photo {
      inset: 0;
      height: 100%;
      min-height: 0;
      background: transparent;
      z-index: 1;
      will-change: clip-path;
    }
    .js.motion:not(.anim-fail) .hero__intro {
      z-index: 2;
      position: absolute;
      inset: 0;
      min-height: 0;
    }
    /* Layer order: promise (bottom, on Stone 50), photo, intro text. */
    .js.motion:not(.anim-fail) .hero__promise {
      position: absolute;
      inset: 0;
      z-index: 0;
      background: var(--navy-800);
      display: flex;
      align-items: center;
      padding: var(--header-h) 0 0;
    }
    .js.motion:not(.anim-fail) .hero__promise-inner {
      width: 100%;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0 clamp(32px, 6vw, 96px);
      align-content: center;
    }
    .js.motion:not(.anim-fail) .hero__promise-inner > * {
      grid-column: 1;
      max-width: min(38rem, 100%);
    }
    .js.motion:not(.anim-fail) .hero__eyebrow {
      margin-bottom: 14px;
    }
    .js.motion:not(.anim-fail) .hero__rule {
      margin-bottom: 32px;
    }
    .js.motion:not(.anim-fail) .hero__promise-body {
      margin-top: 32px;
    }
    .js.motion:not(.anim-fail) .hero__promise-cta {
      margin-top: 36px;
    }
    /* The intro layer, now invisible, must not cover the promise text (selection and clicks). */
    .js.motion:not(.anim-fail) .hero__intro {
      pointer-events: none;
    }
    .js.motion:not(.anim-fail) .hero__intro a {
      pointer-events: auto;
    }
    .js.motion:not(.anim-fail) .hero__promise-inner > * {
      opacity: 0;
    }
  }
</style>

<script>
  // Muted decorative video: always playing (looped) while the hero is on screen.
  // It only stops if the user asks for reduced motion, or when off screen to save CPU.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.addEventListener(
      'playing',
      () => {
        video.setAttribute('data-playing', '');
      },
      { once: true },
    );

    const play = () => void video.play().catch(() => undefined);
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (video.preload === 'auto') play();
        } else video.pause();
      },
      { threshold: 0 },
    ).observe(document.querySelector('[data-hero]')!);

    // Some browsers pause the video when returning to the tab or in battery saver mode: it resumes.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) play();
    });
    video.addEventListener('pause', () => {
      if (
        !document.hidden &&
        video.isConnected &&
        video.dataset.stopped !== 'true' &&
        !video.ended
      ) {
        const rect = document.querySelector('[data-hero]')!.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < window.innerHeight) play();
      }
    });

    // The video doesn't compete with the poster (LCP): it starts loading once the page has finished loading.
    // The poster is set from JS: in the HTML it would download a second image, hidden behind the photo, before the LCP.
    const start = () => {
      if (video.dataset.poster) video.poster = video.dataset.poster;
      video.preload = 'auto';
      play();
    };
    const whenIdle = () =>
      'requestIdleCallback' in window
        ? requestIdleCallback(start, { timeout: 1500 })
        : setTimeout(start, 400);
    if (document.readyState === 'complete') whenIdle();
    else window.addEventListener('load', whenIdle, { once: true });
  }
</script>
