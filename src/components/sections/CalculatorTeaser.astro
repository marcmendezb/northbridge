---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import { localizedPath, t } from '../../i18n';
---

<Section label={t('home.calculator.label')} pattern rule>
  <div class="grid items-end gap-10 md:grid-cols-[1.3fr_1fr] md:gap-16">
    <div data-reveal class="flex flex-col gap-5">
      <h2 class="m-0">{t('home.calculator.title')}</h2>
      <p class="t-body m-0">{t('home.calculator.text')}</p>
      <p class="t-small m-0">{t('home.calculator.note')}</p>
    </div>
    <div data-reveal class="md:justify-self-end">
      <Button variant="secondary" href={localizedPath('/calculadora')} arrow>
        {t('cta.calculate')}
      </Button>
    </div>
  </div>
</Section>
