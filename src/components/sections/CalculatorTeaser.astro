---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import { useI18n } from '../../i18n';
const { t, lp } = useI18n(Astro.currentLocale);
---

<Section tone="navy">
  <div class="grid items-end gap-10 md:grid-cols-[1.3fr_1fr] md:gap-16">
    <div data-reveal class="flex flex-col gap-5">
      <h2 class="t-h2-lg m-0 max-w-[16ch] !text-piedra-50">{t('home.calculator.title')}</h2>
      <p class="t-body m-0 !text-navy-100">{t('home.calculator.text')}</p>
      <p class="t-small m-0 !text-navy-200">{t('home.calculator.note')}</p>
    </div>
    <div data-reveal class="md:justify-self-end">
      <Button on="dark" href={lp('/calculadora')} arrow>
        {t('cta.calculate')}
      </Button>
    </div>
  </div>
</Section>
