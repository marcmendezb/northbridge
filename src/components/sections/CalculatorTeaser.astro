---
/**
 * Teaser de la calculadora: dos tarjetas como el footer. A la izquierda (navy), el mensaje y el CTA;
 * a la derecha (Piedra), una vista previa con las tres preguntas reales y un ejemplo de docs/07
 * calculado con calculate.ts (ningún importe escrito a mano). Al entrar en pantalla la vista previa
 * «se rellena» sola (calcPreview.ts).
 */
import Button from '../ui/Button.astro';
import { useI18n, type MessageKey } from '../../i18n';
import { calculate, type CompanyType } from '../../lib/pricing/calculate';
import { PACKAGES } from '../../lib/pricing/config';
import { formatNumber } from '../../lib/format';
const { t, lp, locale } = useI18n(Astro.currentLocale);

// Ejemplo de docs/07: Pyme (GmbH), 60 facturas, 5 empleados.
const example = { type: 'gmbh' as CompanyType, invoices: 60, employees: 5 };
const result = calculate(example);
const types: CompanyType[] = ['autonomo', 'startup', 'gmbh', 'ag'];
const active = types.indexOf(example.type);
const [min, max] = result.custom ? [0, 0] : result.range;
const pkgName = result.custom ? '' : PACKAGES[result.package].name;
---

<section class="nb-calc nb-container" aria-labelledby="calc-title">
  <div class="nb-calc__grid">
    <div class="nb-calc__card nb-calc__card--dark" data-surface="dark">
      <h2 id="calc-title" class="nb-calc__title" data-split>
        {t('home.calculator.title')}
      </h2>
      <div class="nb-calc__body">
        <p data-reveal class="m-0 text-lg leading-relaxed text-navy-100">
          {t('home.calculator.text')}
        </p>
        <div data-reveal>
          <Button on="dark" href={lp('/calculadora')} arrow>
            {t('cta.calculate')}
          </Button>
        </div>
        <p data-reveal class="m-0 text-sm leading-relaxed text-navy-200">
          {t('home.calculator.note')}
        </p>
      </div>
    </div>

    <a
      href={lp('/calculadora')}
      class="nb-calc__card nb-calc__card--preview"
      data-calc-preview
      aria-label={t('cta.calculate')}
    >
      <div class="nb-calc__field">
        <span class="nb-calc__label">{t('home.calculator.preview.type')}</span>
        <span class="nb-calc__chips" style={`--active:${active}`}>
          <span class="nb-calc__chip-bg" data-calc-chip-bg aria-hidden="true"></span>
          {types.map((ty, i) => (
            <span class="nb-calc__chip" data-active={i === active ? '' : undefined}>
              {t(`home.calculator.preview.types.${ty}` as MessageKey)}
            </span>
          ))}
        </span>
      </div>

      <div class="nb-calc__field">
        <span class="nb-calc__label">
          {t('home.calculator.preview.invoices')}
          <b class="nb-calc__value" data-calc-count={example.invoices}>
            {example.invoices}
          </b>
        </span>
        <span class="nb-calc__track" style={`--v:${example.invoices / 200}`} data-calc-track>
          <span class="nb-calc__fill"></span>
          <span class="nb-calc__knob"></span>
        </span>
      </div>

      <div class="nb-calc__field">
        <span class="nb-calc__label">
          {t('home.calculator.preview.employees')}
          <b class="nb-calc__value" data-calc-count={example.employees}>
            {example.employees}
          </b>
        </span>
        <span class="nb-calc__track" style={`--v:${example.employees / 50}`} data-calc-track>
          <span class="nb-calc__fill"></span>
          <span class="nb-calc__knob"></span>
        </span>
      </div>

      <div class="nb-calc__result" data-calc-result>
        <span class="nb-calc__label">
          {t('home.calculator.preview.result')}
          <span class="nb-calc__pkg">{pkgName}</span>
        </span>
        <span class="nb-calc__price">
          <span class="nb-calc__amount">
            <span data-calc-count={min}>{formatNumber(min, locale)}</span>–
            <span data-calc-count={max}>{formatNumber(max, locale)}</span>
          </span>
          <span class="nb-calc__unit">{t('price.perMonth')}</span>
        </span>
        <span class="nb-calc__vat">{t('price.vatNote')}</span>
      </div>
    </a>
  </div>
</section>

<style is:global>
  .nb-calc {
    padding-block: clamp(24px, 4vw, 56px) var(--section-y);
    background: var(--white);
  }
  .nb-calc__grid {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 1024px) {
    .nb-calc__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
  }
  .nb-calc__card {
    border-radius: var(--radius-card, 8px);
    padding: clamp(28px, 3.4vw, 56px);
  }
  .nb-calc__card--dark {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    min-height: clamp(420px, 40vw, 560px);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-calc__title {
    margin: 0;
    max-width: 12ch;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(2.5rem, 1rem + 3.6vw, 4.5rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--white);
  }
  .nb-calc__body {
    display: grid;
    gap: 24px;
    justify-items: start;
    max-width: 34rem;
  }

  /* Vista previa: Piedra, controles de línea y el resultado como protagonista. */
  .nb-calc__card--preview {
    display: grid;
    align-content: space-between;
    gap: 36px;
    background: var(--piedra-100);
    color: var(--navy-800);
    text-decoration: none;
    transition: background-color var(--dur-base) var(--ease-out);
  }
  .nb-calc__card--preview:hover {
    background: var(--piedra-200);
  }
  .nb-calc__field {
    display: grid;
    gap: 14px;
  }
  .nb-calc__label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--piedra-700);
  }
  .nb-calc__value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--navy-800);
  }
  .nb-calc__chips {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 4px;
    border: 1px solid var(--piedra-300);
    border-radius: var(--radius-button, 4px);
    background: var(--white);
    isolation: isolate;
  }
  .nb-calc__chip-bg {
    position: absolute;
    inset: 4px auto 4px 4px;
    z-index: -1;
    width: calc((100% - 8px) / 4);
    border-radius: var(--radius-tag, 2px);
    background: var(--navy-800);
    transform: translateX(calc(var(--active) * 100%));
  }
  .nb-calc__chip {
    padding: 10px 2px;
    font-size: clamp(0.75rem, 0.55rem + 1vw, 0.875rem);
    font-weight: 600;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--piedra-700);
    transition: color var(--dur-base) var(--ease-out);
  }
  .nb-calc__chip[data-active] {
    color: var(--white);
  }
  .nb-calc__track {
    position: relative;
    display: block;
    height: 2px;
    margin-block: 8px;
    background: var(--piedra-300);
  }
  .nb-calc__fill {
    position: absolute;
    inset: 0;
    background: var(--navy-800);
    transform-origin: left;
    transform: scaleX(var(--v));
  }
  .nb-calc__knob {
    position: absolute;
    top: 50%;
    left: 0;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border: 2px solid var(--navy-800);
    border-radius: 50%;
    background: var(--white);
    transform: translateX(calc(var(--v) * var(--track-w, 0px)));
  }
  .nb-calc__result {
    display: grid;
    gap: 6px;
    padding-top: 28px;
    border-top: 1px solid var(--piedra-300);
  }
  .nb-calc__pkg {
    padding: 4px 10px;
    border-radius: var(--radius-tag, 2px);
    background: var(--salvia-400);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--navy-800);
  }
  .nb-calc__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }
  .nb-calc__amount {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(2.75rem, 1.5rem + 3vw, 4.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .nb-calc__unit {
    font-size: 1rem;
    color: var(--piedra-700);
  }
  .nb-calc__vat {
    font-size: 0.8125rem;
    color: var(--piedra-600);
  }
</style>

<script>
  // El pomo se coloca en píxeles (transform) según el ancho real de la pista.
  const setTracks = () =>
    document.querySelectorAll<HTMLElement>('[data-calc-track]').forEach((track) => {
      track.style.setProperty('--track-w', `${track.clientWidth}px`);
    });
  setTracks();
  window.addEventListener('resize', setTracks, { passive: true });
</script>
