---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.astro';
import Icon from '../brand/Icon.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import { localizedPath, t } from '../../i18n';

const featured = ['contabilidad', 'iva', 'nominas'];
const services = (await getCollection('servicios'))
  .filter((s) => featured.includes(s.data.icon))
  .sort((a, b) => a.data.order - b.data.order);
---

<Section
  tone="piedra"
  label={t('home.services.label')}
  title={t('home.services.title')}
  lead={t('home.services.lead')}
  rule
>
  <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-3">
    {services.map((s) => (
      <li data-reveal class="flex">
        <Card href={localizedPath(`/servicios/${s.id}`)} class="flex w-full flex-col gap-4 p-8">
          <Icon name={s.data.icon} size={40} />
          <h3 class="m-0 text-[1.5rem]">{s.data.title}</h3>
          <p class="t-small m-0 !text-piedra-700">{s.data.summary}</p>
        </Card>
      </li>
    ))}
  </ul>
  <div data-reveal class="mt-10">
    <Button variant="ghost" href={localizedPath('/servicios')} arrow>
      {t('home.services.more')}
    </Button>
  </div>
</Section>
