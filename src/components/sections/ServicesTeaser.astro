---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../brand/Icon.astro';
import Arrow from '../brand/Arrow.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import contabilidad from '../../assets/img/services/contabilidad.jpeg';
import iva from '../../assets/img/services/iva.jpeg';
import nominas from '../../assets/img/services/nominas.jpeg';
import constitucion from '../../assets/img/services/constitucion.jpeg';
import startups from '../../assets/img/services/startup.jpeg';
import { useI18n } from '../../i18n';
import { entryKey, getServiceVariants, getServices } from '../../lib/content';
import { byCountry, type Country } from '../../lib/country';
const { t, lp, locale } = useI18n(Astro.currentLocale);

const featured = ['contabilidad', 'iva', 'nominas'];
const services = await Promise.all(
  (await getServices(locale))
    .filter((s) => featured.includes(s.data.icon))
    .map(async (s) => {
      // Título y resumen de la versión de cada país (servicios-pais).
      const v = await getServiceVariants(s, locale);
      const of = (c: Country) => v.find((g) => g.countries.includes(c))!.text;
      return Object.assign(s, {
        titleHtml: byCountry((c) => of(c).title),
        summaryHtml: byCountry((c) => of(c).summary),
      });
    }),
);
/** Foto de cada servicio: aparece sobre el cursor al pasar por su fila (solo con ratón). */
const photos: Record<string, ImageMetadata> = {
  contabilidad,
  iva,
  nominas,
  constitucion,
  startups,
};
---

<Section tone="base" title={t('home.services.title')} lead={t('home.services.lead')}>
  <ol class="nb-rows m-0 list-none p-0" data-rows>
    {services.map((s) => (
      <li data-reveal class="nb-row">
        <a
          href={lp(`/servicios/${entryKey(s)}`)}
          class="nb-row__link nb-trace"
          data-row-photo={s.data.icon}
        >
          <span class="nb-row__main">
            <span class="nb-row__title" set:html={s.titleHtml} />
            <span class="nb-row__sum" set:html={s.summaryHtml} />
          </span>
          <Icon name={s.data.icon} size={44} class="nb-row__icon" />
          <span class="nb-row__arrow">
            <Arrow size={30} />
          </span>
        </a>
      </li>
    ))}
  </ol>
  <div class="nb-rows__float" data-rows-float aria-hidden="true">
    {services.map((s) => (
      <Picture
        src={photos[s.data.icon]}
        formats={['avif', 'webp']}
        widths={[400, 720]}
        sizes="360px"
        alt=""
        loading="lazy"
        quality={72}
        class="nb-rows__photo"
        data-photo={s.data.icon}
      />
    ))}
  </div>
  <div class="nb-rows__float nb-fan" data-fan-float aria-hidden="true">
    {Object.entries(photos).map(([key, src], i) => (
      <span class="nb-fan__card" data-fan-card style={`--i:${i - 2}`}>
        <Picture
          src={src}
          formats={['avif', 'webp']}
          widths={[400]}
          sizes="200px"
          alt=""
          loading="lazy"
          quality={70}
          class="nb-fan__img"
          data-fan-photo={key}
        />
      </span>
    ))}
  </div>
  <div data-reveal class="mt-12">
    <Button variant="ghost" href={lp('/servicios')} arrow data-fan-trigger>
      {t('home.services.more')}
    </Button>
  </div>
</Section>

<style is:global>
  .nb-rows {
    border-top: 1.5px solid var(--navy-800);
  }
  .nb-row {
    border-bottom: 1px solid var(--piedra-300);
  }
  .nb-row__link {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 8px 24px;
    padding-block: clamp(24px, 3.5vw, 44px);
    color: var(--navy-800);
    text-decoration: none;
    isolation: isolate;
  }
  /* Relleno navy que sube desde abajo (transform), con el texto invertido. */
  .nb-row__link::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--header-pad) * -1);
    z-index: -1;
    background: var(--navy-800);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .nb-row__link > * {
    transition:
      color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .nb-row__main {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .nb-row__title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.75rem, 1rem + 3.2vw, 3.5rem);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.015em;
  }
  .nb-row__sum {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--piedra-700);
    max-width: 38rem;
  }
  .nb-row__icon {
    display: none;
  }
  .nb-row__arrow {
    display: none;
  }
  @media (min-width: 768px) {
    .nb-row__link {
      grid-template-columns: 1fr auto auto;
    }
    .nb-row__icon {
      display: inline-block;
    }
    .nb-row__arrow {
      display: inline-flex;
    }
  }
  @media (hover: hover) {
    .nb-row__link:hover::before,
    .nb-row__link:focus-visible::before {
      transform: scaleY(1);
    }
    .nb-row__link:hover .nb-row__title,
    .nb-row__link:focus-visible .nb-row__title {
      color: var(--white);
      transform: translateX(12px);
    }
    .nb-row__link:hover .nb-row__sum,
    .nb-row__link:focus-visible .nb-row__sum {
      color: var(--navy-100);
      transform: translateX(12px);
    }
    .nb-row__link:hover .nb-row__icon,
    .nb-row__link:focus-visible .nb-row__icon,
    .nb-row__link:hover .nb-row__arrow,
    .nb-row__link:focus-visible .nb-row__arrow {
      color: var(--white);
    }
  }

  /* Foto flotante: sigue al cursor por encima, con un leve retraso (solo transform y opacity). */
  .nb-rows__float {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    width: clamp(240px, 22vw, 340px);
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-card, 8px);
    background: var(--piedra-100);
    box-shadow: 0 18px 40px rgb(21 39 66 / 0.18);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    will-change: transform, opacity;
  }
  .nb-rows__float[data-visible] {
    visibility: visible;
  }
  .nb-rows__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Las fotos dejan la mitad izquierda en navy: se encuadra el motivo. */
    object-position: 78% 50%;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 420ms var(--ease-out),
      transform 900ms var(--ease-out);
  }
  .nb-rows__photo[data-active] {
    opacity: 1;
    transform: scale(1);
  }
  /* «Ver los 5 servicios»: las cinco fotos como cartas apiladas que se abren en abanico. */
  .nb-fan {
    width: clamp(130px, 10vw, 160px);
    aspect-ratio: 3 / 4;
    overflow: visible;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }
  .nb-fan__card {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--radius-card, 8px);
    background: var(--piedra-100);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.7),
      0 12px 28px rgb(21 39 66 / 0.18);
    /* Apiladas: casi superpuestas, con un leve desfase. */
    transform: translate(calc(var(--i) * 3px), calc(var(--i) * -2px))
      rotate(calc(var(--i) * 1.5deg));
    transition: transform 650ms var(--ease-out);
    transition-delay: calc((var(--i) + 2) * 35ms);
  }
  /* Abiertas en abanico, desde el centro. */
  .nb-fan[data-open] .nb-fan__card {
    transform: translate(calc(var(--i) * 32%), calc(var(--i) * var(--i) * 3px))
      rotate(calc(var(--i) * 4deg));
  }
  .nb-fan__card picture {
    display: contents;
  }
  .nb-fan__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 76% 50%;
  }
  @media (hover: none), (pointer: coarse) {
    .nb-rows__float {
      display: none;
    }
  }
</style>

<script>
  // Fotos que siguen al cursor en «Cómo te ayudamos». Solo con ratón fino; sin JS no aparecen.
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Borde inferior del header flotante: por encima de él no se ve nada. */
  const headerBottom = () => document.querySelector('.nb-bar')?.getBoundingClientRect().bottom ?? 0;

  /**
   * Capa flotante que sigue al cursor, con un leve retraso (transform y opacidad). Va encima del
   * cursor; si ahí chocaría con el header, pasa debajo.
   */
  function follower(float: HTMLElement, lift = 20) {
    const pos = { x: 0, y: 0 };
    const target = { x: 0, y: 0 };
    let shown = 0;
    let visible = false;
    let frame = 0;
    /** Desplazamiento vertical respecto al cursor: negativo = encima. */
    let offset = 0;
    const wanted = () => {
      const h = float.offsetHeight + lift;
      return target.y - h >= headerBottom() + 12 ? -h : lift;
    };
    const render = () => {
      const k = reduce ? 1 : 0.16;
      pos.x += (target.x - pos.x) * k;
      pos.y += (target.y - pos.y) * k;
      const goal = wanted();
      offset += (goal - offset) * (reduce ? 1 : 0.2);
      shown += ((visible ? 1 : 0) - shown) * (reduce ? 1 : 0.18);
      const scale = reduce ? 1 : 0.9 + shown * 0.1;
      float.style.transformOrigin = goal < 0 ? '50% 100%' : '50% 0%';
      float.style.transform = `translate3d(${pos.x}px, ${pos.y + offset}px, 0) translate(-50%, 0) scale(${scale})`;
      float.style.opacity = String(shown);
      const settled =
        Math.abs(target.x - pos.x) < 0.1 &&
        Math.abs(target.y - pos.y) < 0.1 &&
        Math.abs(goal - offset) < 0.1 &&
        Math.abs((visible ? 1 : 0) - shown) < 0.01;
      if (settled && !visible) float.removeAttribute('data-visible');
      frame = settled ? 0 : requestAnimationFrame(render);
    };
    const tick = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };
    return {
      get visible() {
        return visible;
      },
      show(e: PointerEvent) {
        if (!visible) {
          // Aparece justo donde está el cursor, sin viajar desde la posición anterior.
          pos.x = target.x = e.clientX;
          pos.y = target.y = e.clientY;
          offset = wanted();
        }
        visible = true;
        float.setAttribute('data-visible', '');
        tick();
      },
      move(e: PointerEvent) {
        target.x = e.clientX;
        target.y = e.clientY;
        tick();
      },
      hide() {
        visible = false;
        tick();
      },
    };
  }

  /** Esconde la capa si la página se desplaza bajo el cursor quieto y este ya no está encima. */
  const hideOnScroll = (area: Element, f: ReturnType<typeof follower>) =>
    window.addEventListener(
      'scroll',
      () => {
        if (f.visible && !area.matches(':hover')) f.hide();
      },
      { passive: true },
    );

  const rows = document.querySelector<HTMLElement>('[data-rows]');
  const float = document.querySelector<HTMLElement>('[data-rows-float]');
  if (rows && float && fine.matches) {
    const f = follower(float);
    const photos = [...float.querySelectorAll<HTMLElement>('[data-photo]')];
    rows.querySelectorAll<HTMLElement>('[data-row-photo]').forEach((link) => {
      link.addEventListener('pointerenter', (e) => {
        photos.forEach((p) =>
          p.toggleAttribute('data-active', p.dataset.photo === link.dataset.rowPhoto),
        );
        f.show(e);
      });
    });
    rows.addEventListener('pointermove', (e) => f.move(e));
    rows.addEventListener('pointerleave', () => f.hide());
    hideOnScroll(rows, f);
  }

  // «Ver los 5 servicios»: las cinco cartas siguen al cursor y se abren en abanico.
  const trigger = document.querySelector<HTMLElement>('[data-fan-trigger]');
  const fan = document.querySelector<HTMLElement>('[data-fan-float]');
  if (trigger && fan && fine.matches) {
    const f = follower(fan, 40);
    trigger.addEventListener('pointerenter', (e) => {
      f.show(e);
      // Un fotograma después, para que el abanico parta de la pila.
      requestAnimationFrame(() => fan.setAttribute('data-open', ''));
    });
    trigger.addEventListener('pointermove', (e) => f.move(e));
    trigger.addEventListener('pointerleave', () => {
      f.hide();
      fan.removeAttribute('data-open');
    });
    hideOnScroll(trigger, f);
  }
</script>
