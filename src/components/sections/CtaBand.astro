---
/**
 * Cierre «20 minutos para ordenar tus números» (servicios, artículos, calculadora).
 * Los 20 minutos dibujados: una regla de la llamada, de 0 a 20, con lo que pasa en cada mitad y,
 * después, el precio por escrito en 24 horas. Con el scroll, un cabezal recorre la llamada y el
 * reloj corre (clockScene.ts). Sin JS o con movimiento reducido: la regla completa y «20:00».
 */
import Button from '../ui/Button.astro';
import { getBookingCta, site } from '../../lib/site';
import { useI18n, type Messages } from '../../i18n';
const { t, tRaw, locale } = useI18n(Astro.currentLocale);
const bookingCta = getBookingCta(locale);

interface Props {
  title?: string;
  text?: string;
}
const { title = t('home.cta.title'), text = t('home.cta.text') } = Astro.props;
const expect = tRaw<Messages['booking']['expect']>('booking.expect');
const guarantees = tRaw<string[]>('booking.guarantees');
const tel = `tel:${site.phone.replace(/\s/g, '')}`;
const min = t('home.cta.min');
const [callBefore, callAfter] = t('home.cta.orCall').split('{phone}');
const ticks = Array.from({ length: 21 }, (_, i) => i);
---

<section class="nb-clock" data-surface="dark" data-clock aria-labelledby="clock-title">
  <div class="nb-container nb-clock__grid">
    <div class="nb-clock__text">
      <p class="nb-clock__eyebrow">{t('booking.label')}</p>
      <h2 id="clock-title" class="nb-clock__title" data-split>
        {title}
      </h2>
      <p class="nb-clock__lead" data-reveal>
        {text}
      </p>
      <div class="nb-clock__actions" data-reveal>
        <Button href={bookingCta.href} on="dark" arrow>
          {bookingCta.label}
        </Button>
        <p class="nb-clock__call-us">
          {callBefore}
          <a href={tel}>{site.phone}</a>
          {callAfter}
        </p>
      </div>
    </div>

    <figure class="nb-clock__call">
      <figcaption class="nb-clock__label">{t('home.cta.clockLabel')}</figcaption>
      <p class="nb-clock__time" aria-hidden="true">
        <span data-clock-time>20:00</span>
        <span class="nb-clock__unit">{min}</span>
      </p>

      <div class="nb-clock__track" data-clock-track aria-hidden="true">
        <span class="nb-clock__rail"></span>
        <span class="nb-clock__fill" data-clock-fill></span>
        {ticks.map((i) => (
          <span
            class:list={['nb-clock__tick', i % 5 === 0 && 'nb-clock__tick--major']}
            style={`--at:${(i / 20) * 100}%`}
          >
            {i % 5 === 0 && <span>{i}</span>}
          </span>
        ))}
        <span class="nb-clock__head" data-clock-head></span>
        <span class="nb-clock__after" data-clock-after>
          <span>{t('home.cta.after')}</span>
        </span>
      </div>

      <ol class="nb-clock__moments" role="list">
        {expect.map((e, i) => (
          <li
            class:list={['nb-clock__moment', i === 2 && 'nb-clock__moment--after']}
            data-clock-moment
          >
            <span class="nb-clock__when" aria-hidden="true">
              {i === 0 ? `0–10 ${min}` : i === 1 ? `10–20 ${min}` : t('home.cta.after')}
            </span>
            <span class="nb-clock__what">{e.title}</span>
            <span class="nb-clock__detail">{e.text}</span>
          </li>
        ))}
      </ol>

      <ul class="nb-clock__promises" role="list" data-reveal>
        {guarantees.map((g) => (
          <li>{g}</li>
        ))}
      </ul>
    </figure>
  </div>
</section>

<style is:global>
  .nb-clock {
    position: relative;
    padding-block: var(--section-y);
    overflow: clip;
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-clock__grid {
    display: grid;
    gap: clamp(48px, 6vw, 96px);
  }
  @media (min-width: 1024px) {
    .nb-clock__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: center;
    }
  }
  .nb-clock__text {
    display: grid;
    justify-items: start;
    gap: 24px;
  }
  .nb-clock__eyebrow,
  .nb-clock__label {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-300);
  }
  .nb-clock__title {
    margin: 0;
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 1rem + 4.5vw, 5.5rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--white);
  }
  .nb-clock__lead {
    margin: 0;
    max-width: 28rem;
    font-size: 1.125rem;
    line-height: 1.55;
  }
  .nb-clock__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    padding-top: 4px;
  }
  .nb-clock__call-us {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--navy-200);
  }
  .nb-clock__call-us a {
    color: var(--white);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.3);
    text-underline-offset: 5px;
  }
  .nb-clock__call-us a:hover {
    text-decoration-color: currentColor;
  }

  /* La llamada: reloj, regla de 20 minutos y lo que pasa en ella. */
  .nb-clock__call {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: clamp(24px, 3.5vw, 48px);
    border: 1px solid var(--navy-600);
    border-radius: var(--radius-card, 8px);
  }
  .nb-clock__time {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 2rem + 6vw, 7.5rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--white);
  }
  .nb-clock__unit {
    font-family: var(--font-text, inherit);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--navy-200);
  }
  .nb-clock__track {
    position: relative;
    height: 56px;
    margin: 12px 0 0;
    /* Hueco a la derecha para el «+24 h». */
    margin-right: clamp(56px, 8vw, 88px);
  }
  .nb-clock__rail,
  .nb-clock__fill {
    position: absolute;
    inset: 12px 0 auto;
    height: 2px;
  }
  .nb-clock__rail {
    background: var(--navy-600);
  }
  .nb-clock__fill {
    background: var(--white);
    transform-origin: left center;
  }
  .nb-clock__tick {
    position: absolute;
    top: 7px;
    left: var(--at);
    width: 1px;
    height: 12px;
    background: var(--navy-500);
  }
  .nb-clock__tick--major {
    top: 3px;
    height: 20px;
    background: var(--navy-200);
  }
  .nb-clock__tick span {
    position: absolute;
    top: 28px;
    left: 50%;
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--navy-200);
    transform: translateX(-50%);
  }
  .nb-clock__head {
    position: absolute;
    top: -6px;
    left: 0;
    width: 2px;
    height: 38px;
    margin-left: -1px;
    background: var(--salvia-300);
  }
  /* Después de colgar: el precio por escrito, en las 24 horas siguientes. */
  .nb-clock__after {
    position: absolute;
    top: 12px;
    left: 100%;
    display: flex;
    align-items: center;
    width: clamp(56px, 8vw, 88px);
    height: 2px;
    border-top: 2px dashed var(--navy-500);
  }
  .nb-clock__after span {
    position: absolute;
    top: 16px;
    right: 0;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--salvia-300);
  }
  .nb-clock__moments {
    display: grid;
    gap: 20px 24px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .nb-clock__moments {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .nb-clock__moment {
    display: grid;
    align-content: start;
    gap: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--navy-600);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .nb-clock__moment.is-on {
    border-color: var(--white);
  }
  .nb-clock__moment--after.is-on {
    border-color: var(--salvia-300);
  }
  .nb-clock__when {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy-200);
  }
  .nb-clock__moment--after .nb-clock__when {
    color: var(--salvia-300);
  }
  .nb-clock__what {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.15;
    color: var(--white);
  }
  .nb-clock__detail {
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .nb-clock__promises {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .nb-clock__promises li {
    padding: 6px 12px;
    border: 1px solid var(--navy-500);
    border-radius: var(--radius-button, 4px);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--white);
  }
  @media (max-width: 479px) {
    .nb-clock__tick span {
      font-size: 0.6875rem;
    }
  }
</style>
