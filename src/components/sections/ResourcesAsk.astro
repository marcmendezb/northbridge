---
/**
 * Resources closing section: "Your case isn't in any guide?". The person types the question here
 * and it arrives prefilled in the contact form (`/contacto?mensaje=…`). Without JS it is a regular
 * form (GET); with JS, the examples rotate in the field and the chips fill it in.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import lea from '../../assets/img/about/team/lea-brunner.jpeg';
import tobias from '../../assets/img/about/team/tobias-vogel.jpeg';
import nora from '../../assets/img/about/team/nora-steiner.jpeg';
import marc from '../../assets/img/about/team/marc-bernasconi.jpeg';
import { useI18n } from '../../i18n';
import { getBookingCta } from '../../lib/site';
import { byCountry, COUNTRIES, type Country } from '../../lib/country';
import { vatFor } from '../../lib/vat';

const { t, tRaw, lp, locale } = useI18n(Astro.currentLocale);
const bookingCta = getBookingCta(locale);
const examples = tRaw<string[]>('resources.askExamples');
/** Each example with the VAT name for each country: one chip per variant, with `data-cc` if it varies. */
const chips = examples.flatMap((q) => {
  const groups = new Map<string, Country[]>();
  for (const c of COUNTRIES) {
    const text = vatFor(q, c, locale);
    groups.set(text, [...(groups.get(text) ?? []), c]);
  }
  return [...groups].map(([text, cs]) => ({
    text,
    cc: groups.size > 1 ? cs.join(' ') : undefined,
  }));
});
const team: { name: string; src: ImageMetadata }[] = [
  { name: 'Lea Brunner', src: lea },
  { name: 'Tobias Vogel', src: tobias },
  { name: 'Nora Steiner', src: nora },
  { name: 'Marc Bernasconi', src: marc },
];
---

<section class="nb-ask" data-surface="dark" aria-labelledby="ask-title" data-ask>
  <div class="nb-container nb-ask__grid">
    <div class="nb-ask__intro">
      <p class="nb-ask__label">{t('resources.askLabel')}</p>
      <h2 class="nb-ask__title" id="ask-title" data-split>
        {t('resources.ctaTitle')}
      </h2>
      <p class="nb-ask__text" data-reveal>
        {t('resources.askText')}
      </p>
      <div class="nb-ask__team" data-reveal>
        <span class="nb-ask__faces" aria-hidden="true">
          {team.map((m) => (
            <span class="nb-ask__face">
              <Picture
                src={m.src}
                formats={['avif', 'webp']}
                widths={[96]}
                sizes="48px"
                alt=""
                loading="lazy"
                quality={70}
              />
            </span>
          ))}
        </span>
        <span class="nb-ask__team-text">{t('resources.askTeam')}</span>
      </div>
    </div>

    <form class="nb-ask__form" action={lp('/contacto')} method="get" data-reveal>
      <label class="nb-ask__field-label" for="ask-question">
        {t('resources.askField')}
      </label>
      <div class="nb-ask__field">
        <textarea
          id="ask-question"
          name="mensaje"
          rows="3"
          maxlength="600"
          placeholder={examples[0]}
          data-ask-input
        ></textarea>
        <span
          class="nb-ask__hint"
          aria-hidden="true"
          data-ask-hint
          set:html={byCountry((c) => vatFor(examples[0], c, locale))}
        />
        <span class="nb-ask__line" aria-hidden="true"></span>
      </div>
      <div class="nb-ask__chips" role="group" aria-label={t('resources.askField')}>
        {chips.map((q) => (
          <button type="button" class="nb-ask__chip" data-ask-chip data-cc={q.cc}>
            {q.text}
          </button>
        ))}
      </div>
      <div class="nb-ask__actions">
        <Button type="submit" on="dark" arrow>
          {t('resources.askSubmit')}
        </Button>
        <a href={bookingCta.href} class="nb-ask__book">
          {t('resources.askOr')}
        </a>
      </div>
    </form>
  </div>
</section>

<style is:global>
  .nb-ask {
    padding-block: var(--section-y);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-ask__grid {
    display: grid;
    gap: 56px;
  }
  @media (min-width: 1024px) {
    .nb-ask__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 96px;
      align-items: start;
    }
  }
  .nb-ask__intro {
    display: grid;
    gap: 24px;
    align-content: start;
  }
  .nb-ask__label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-300);
  }
  .nb-ask__title {
    margin: 0;
    max-width: 11ch;
    font-size: clamp(2.75rem, 1rem + 4.6vw, 5.5rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--white);
  }
  .nb-ask__text {
    margin: 0;
    max-width: 30rem;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .nb-ask__team {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
  }
  .nb-ask__faces {
    display: flex;
  }
  /* Small overlapping arch portraits: the team that answers. */
  .nb-ask__face {
    width: 40px;
    height: 52px;
    margin-left: -8px;
    overflow: hidden;
    border: 2px solid var(--navy-800);
    border-radius: 9999px 9999px 0 0;
    background: var(--navy-700);
  }
  .nb-ask__face:first-child {
    margin-left: 0;
  }
  .nb-ask__face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
  }
  .nb-ask__team-text {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--white);
  }

  /* The field: you write as if on paper, in the headline typeface. */
  .nb-ask__form {
    display: grid;
    gap: 20px;
    margin: 0;
  }
  .nb-ask__field-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-200);
  }
  .nb-ask__field {
    position: relative;
  }
  .nb-ask__field textarea,
  .nb-ask__hint {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.75rem, 1rem + 2.2vw, 2.75rem);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .nb-ask__field textarea {
    display: block;
    width: 100%;
    min-height: 3.6em;
    padding: 0 0 16px;
    border: 0;
    background: transparent;
    color: var(--white);
    resize: none;
    caret-color: var(--salvia-300);
  }
  .nb-ask__field textarea::placeholder {
    color: var(--navy-300);
  }
  .nb-ask__field textarea:focus {
    outline: none;
  }
  /* With JS, the example lives in a layer that crossfades (the placeholder can't be animated). */
  .js .nb-ask__field textarea::placeholder {
    color: transparent;
  }
  .nb-ask__hint {
    display: none;
    position: absolute;
    inset: 0 0 auto;
    color: var(--navy-300);
    pointer-events: none;
    transition:
      opacity 500ms var(--ease-out),
      transform 500ms var(--ease-out);
  }
  .js .nb-ask__hint {
    display: block;
  }
  .nb-ask__hint[data-hidden] {
    opacity: 0;
    transform: translateY(8px);
  }
  .nb-ask__field:has(textarea:not(:placeholder-shown)) .nb-ask__hint {
    display: none;
  }
  .nb-ask__line {
    display: block;
    height: 1.5px;
    background: var(--navy-500);
    transform-origin: left;
    transition: background-color var(--dur-base) var(--ease-out);
  }
  .nb-ask__field:focus-within .nb-ask__line {
    background: var(--salvia-300);
  }
  .nb-ask__chips {
    display: none;
    flex-wrap: wrap;
    gap: 8px;
  }
  .js .nb-ask__chips {
    display: flex;
  }
  .nb-ask__chip {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--navy-600);
    border-radius: var(--radius-button, 4px);
    background: transparent;
    font: inherit;
    font-size: 0.875rem;
    color: var(--navy-100);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .nb-ask__chip:hover {
    border-color: var(--navy-200);
    color: var(--white);
  }
  .nb-ask__chip:focus-visible {
    outline: 2px solid var(--salvia-300);
    outline-offset: 2px;
  }
  .nb-ask__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 8px;
  }
  .nb-ask__book {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--white);
    text-decoration: none;
  }
  .nb-ask__book:hover {
    color: var(--salvia-300);
  }
</style>

<script>
  // Examples rotating in the field (without reduced motion) and chips that fill it in.
  document.querySelectorAll<HTMLElement>('[data-ask]').forEach((root) => {
    const input = root.querySelector<HTMLTextAreaElement>('[data-ask-input]');
    const hint = root.querySelector<HTMLElement>('[data-ask-hint]');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-ask-chip]')];
    if (!input || !hint) return;
    // Only the active country's chips (the others are hidden with `data-cc`).
    const visible = () => chips.filter((c) => c.offsetParent !== null);
    const examples = () => visible().map((c) => c.textContent?.trim() ?? '');
    input.placeholder = examples()[0] ?? input.placeholder;

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        input.value = chip.textContent?.trim() ?? '';
        input.focus();
        input.setSelectionRange(input.value.length, input.value.length);
      });
    }

    if (matchMedia('(prefers-reduced-motion: reduce)').matches || chips.length < 2) return;
    let i = 0;
    let timer = 0;
    const next = () => {
      if (input.value || document.activeElement === input) return;
      hint.setAttribute('data-hidden', '');
      window.setTimeout(() => {
        const list = examples();
        i = (i + 1) % list.length;
        hint.textContent = list[i];
        hint.removeAttribute('data-hidden');
      }, 500);
    };
    // Only rotates while the section is on screen.
    new IntersectionObserver(([entry]) => {
      window.clearInterval(timer);
      if (entry.isIntersecting) timer = window.setInterval(next, 3200);
    }).observe(root);
  });
</script>
