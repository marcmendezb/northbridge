---
/**
 * Testimonios editoriales: una cita grande a la vez, sin rotación automática.
 * Navegación con líneas (la activa se alarga), anterior/siguiente y flechas del teclado.
 * Sin JS, las tres citas se ven seguidas. Comillas grandes en lugar de numeración.
 */
import Section from '../ui/Section.astro';
import { localeMeta, useI18n } from '../../i18n';
import { getTestimonials } from '../../lib/content';
const { t, locale } = useI18n(Astro.currentLocale);

const items = await getTestimonials(locale);
const [open] = localeMeta[locale].quotes;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .slice(0, 2)
    .join('');
const chevron = (dir: 'prev' | 'next') => (dir === 'prev' ? 'M15 5l-7 7 7 7' : 'M9 5l7 7-7 7');
---

<Section tone="piedra" title={t('home.testimonials.title')}>
  <div class="nb-tst" data-tst role="region" aria-label={t('home.testimonials.region')}>
    <span class="nb-tst__mark" aria-hidden="true">
      {open.trim()}
    </span>

    <div class="nb-tst__main">
      <ul class="nb-tst__slides" data-tst-slides>
        {items.map((it, i) => (
          <li class="nb-slide" data-active={i === 0 ? '' : undefined}>
            <figure class="nb-tst__figure">
              <blockquote class="nb-tst__quote">
                <p>{it.data.quote}</p>
              </blockquote>
              <figcaption class="nb-tst__author">
                <span class="nb-tst__avatar" aria-hidden="true">
                  {initials(it.data.author)}
                </span>
                <span class="nb-tst__who">
                  <span class="nb-tst__name">{it.data.author}</span>
                  <span class="nb-tst__role">
                    {it.data.role}
                    <span class="nb-tst__sep" aria-hidden="true">
                      /
                    </span>
                    <span class="nb-tst__company">{it.data.company}</span>
                  </span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <div class="nb-tst__nav">
        <ul class="nb-tst__lines">
          {items.map((it, i) => (
            <li>
              <button
                type="button"
                class="nb-tst__line"
                data-index={i}
                aria-label={`${t('home.testimonials.goTo')}: ${it.data.author}`}
                aria-current={i === 0 ? 'true' : undefined}
              >
                <span aria-hidden="true" />
              </button>
            </li>
          ))}
        </ul>
        <div class="nb-tst__arrows">
          {(['prev', 'next'] as const).map((dir) => (
            <button
              type="button"
              class="nb-tst__arrow"
              data-dir={dir}
              aria-label={t(dir === 'prev' ? 'home.testimonials.prev' : 'home.testimonials.next')}
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="butt"
                stroke-linejoin="miter"
                aria-hidden="true"
              >
                <path d={chevron(dir)} />
              </svg>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</Section>

<style is:global>
  .nb-tst {
    display: grid;
    gap: 8px 48px;
    max-width: 64rem;
  }
  @media (min-width: 768px) {
    .nb-tst {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
  /* Comillas grandes en Piedra: el ancla visual que en la referencia ocupaba el número. */
  .nb-tst__mark {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(6rem, 4rem + 6vw, 10rem);
    font-weight: 300;
    line-height: 0.8;
    color: var(--piedra-300);
    user-select: none;
  }
  .nb-tst__slides {
    display: grid;
    gap: 56px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nb-tst__figure {
    margin: 0;
  }
  .nb-tst__quote {
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.625rem, 1rem + 2.2vw, 2.75rem);
    font-weight: 300;
    line-height: 1.22;
    letter-spacing: -0.012em;
    color: var(--navy-800);
    text-wrap: pretty;
  }
  .nb-tst__quote p {
    margin: 0;
  }
  .nb-tst__author {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
  }
  /* Monograma con forma de arco (el arco solo enmarca retratos). */
  .nb-tst__avatar {
    display: inline-flex;
    align-items: flex-end;
    justify-content: center;
    width: 48px;
    height: 56px;
    padding-bottom: 10px;
    border-radius: 999px 999px 0 0;
    background: var(--navy-800);
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    color: var(--white);
  }
  .nb-tst__who {
    display: grid;
    gap: 2px;
  }
  .nb-tst__name {
    font-weight: 600;
    color: var(--navy-800);
  }
  .nb-tst__role {
    font-size: 0.9375rem;
    color: var(--piedra-700);
  }
  .nb-tst__sep {
    margin-inline: 8px;
    color: var(--piedra-300);
  }
  .nb-tst__company {
    transition: color var(--dur-base) var(--ease-out);
  }
  .nb-tst__author:hover .nb-tst__company {
    color: var(--navy-800);
  }
  .nb-tst__nav {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--piedra-300);
  }
  .nb-tst__lines {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nb-tst__line {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .nb-tst__line span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--piedra-400);
    transition:
      width 500ms var(--ease-out),
      background-color 500ms var(--ease-out);
  }
  .nb-tst__line:hover span {
    width: 32px;
    background: var(--piedra-600);
  }
  .nb-tst__line[aria-current] span {
    width: 48px;
    background: var(--navy-800);
  }
  .nb-tst__arrows {
    display: flex;
    gap: 4px;
  }
  .nb-tst__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-button, 4px);
    background: none;
    color: var(--piedra-600);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .nb-tst__arrow:hover {
    background: var(--piedra-200);
    color: var(--navy-800);
  }

  /* Con JS: una cita a la vez, con salida lateral corta y entrada suave. */
  .js .nb-tst__nav {
    display: flex;
  }
  .js .nb-tst__slides {
    grid-template-areas: 'stack';
    gap: 0;
  }
  .js .nb-tst__slides > .nb-slide {
    grid-area: stack;
    visibility: hidden;
    opacity: 0;
    transform: translateX(16px);
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out),
      visibility 0s linear 300ms;
  }
  .js .nb-tst__slides > .nb-slide[data-active] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 500ms var(--ease-out) 150ms,
      transform 500ms var(--ease-out) 150ms,
      visibility 0s;
  }
  .js .nb-tst__slides > .nb-slide[data-leaving] {
    transform: translateX(-16px);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tst]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.nb-slide'));
    const lines = Array.from(root.querySelectorAll<HTMLButtonElement>('.nb-tst__line'));
    let index = 0;

    const go = (next: number) => {
      next = (next + slides.length) % slides.length;
      if (next === index) return;
      const prev = slides[index];
      prev.setAttribute('data-leaving', '');
      prev.removeAttribute('data-active');
      window.setTimeout(() => prev.removeAttribute('data-leaving'), 320);
      slides[next].setAttribute('data-active', '');
      lines[index].removeAttribute('aria-current');
      lines[next].setAttribute('aria-current', 'true');
      index = next;
    };

    lines.forEach((line, i) => line.addEventListener('click', () => go(i)));
    root
      .querySelectorAll<HTMLButtonElement>('.nb-tst__arrow')
      .forEach((btn) =>
        btn.addEventListener('click', () => go(index + (btn.dataset.dir === 'prev' ? -1 : 1))),
      );
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(index - 1);
      else if (e.key === 'ArrowRight') go(index + 1);
    });
  });
</script>
