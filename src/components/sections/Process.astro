---
import Section from '../ui/Section.astro';
import ProcessSteps from './ProcessSteps.astro';
import { useI18n } from '../../i18n';
const { t, tRaw } = useI18n(Astro.currentLocale);
const steps = tRaw<{ title: string; text: string }[]>('home.process.steps');
---

<Section tone="base" title={t('home.process.title')}>
  <ProcessSteps steps={steps} />
</Section>
