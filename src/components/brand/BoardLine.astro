---
/** Section divider with an arch at its start (1.5 stroke). */
interface Props {
  tone?: 'navy' | 'salvia';
  class?: string;
}
const { tone = 'navy', class: className = '' } = Astro.props;
---

<svg
  class:list={[
    'block h-5 w-full',
    tone === 'navy' ? 'text-navy-800' : 'text-salvia-400',
    className,
  ]}
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
>
  <path d="M0 2H4000"></path>
  <path d="M4 20V14A12 12 0 0 1 28 14V20"></path>
</svg>
