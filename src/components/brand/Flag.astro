---
/**
 * Flat flag for a country in the selector (no emojis: SVG using the colours in tokens.css).
 * Switzerland is square; the rest are 3:2. A 1 px rule separates it from the white background.
 */
import type { Country } from '../../lib/country';
interface Props {
  country: Country;
  class?: string;
}
const { country, class: className = '' } = Astro.props;
const square = country === 'CH';
---

<span class:list={['nb-flag', square && 'nb-flag--square', className]} aria-hidden="true">
  {country === 'CH' && (
    <svg viewBox="0 0 32 32">
      <rect width="32" height="32" fill="var(--flag-red)" />
      <path d="M13 6h6v7h7v6h-7v7h-6v-7H6v-6h7z" fill="var(--white)" />
    </svg>
  )}
  {country === 'ES' && (
    <svg viewBox="0 0 30 20" preserveAspectRatio="none">
      <rect width="30" height="20" fill="var(--flag-red)" />
      <rect y="5" width="30" height="10" fill="var(--flag-yellow)" />
    </svg>
  )}
  {country === 'DE' && (
    <svg viewBox="0 0 30 18" preserveAspectRatio="none">
      <rect width="30" height="6" fill="var(--flag-black)" />
      <rect y="6" width="30" height="6" fill="var(--flag-red)" />
      <rect y="12" width="30" height="6" fill="var(--flag-gold)" />
    </svg>
  )}
  {country === 'FR' && (
    <svg viewBox="0 0 30 20" preserveAspectRatio="none">
      <rect width="10" height="20" fill="var(--flag-blue)" />
      <rect x="10" width="10" height="20" fill="var(--white)" />
      <rect x="20" width="10" height="20" fill="var(--flag-red)" />
    </svg>
  )}
  {country === 'IT' && (
    <svg viewBox="0 0 30 20" preserveAspectRatio="none">
      <rect width="10" height="20" fill="var(--flag-green)" />
      <rect x="10" width="10" height="20" fill="var(--white)" />
      <rect x="20" width="10" height="20" fill="var(--flag-red)" />
    </svg>
  )}
</span>

<style is:global>
  .nb-flag {
    display: inline-flex;
    flex: none;
    width: 18px;
    height: 12px;
    overflow: hidden;
    border-radius: 1px;
    position: relative;
  }
  .nb-flag--square {
    width: 12px;
    margin-inline: 3px;
  }
  .nb-flag svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Inner rule: keeps the white stripes from blending into the panel. */
  .nb-flag::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 0.5px rgb(21 39 66 / 0.22);
  }
</style>
