---
import { uid } from '../../lib/uid';

/** Viaduct pattern (48 × 40 tile, 1.5 stroke). `dark` paints its own Navy 800 background; `light` sits on top of Stone 50. */
interface Props {
  tone?: 'dark' | 'light';
  /** Fades the pattern to transparent so it doesn't compete with the text. */
  mask?: 'none' | 'top' | 'bottom' | 'left' | 'right';
  class?: string;
}
const { tone = 'dark', mask = 'none', class: className = '' } = Astro.props;
const id = uid('nb-viaducto');
const masks = {
  none: '',
  top: 'linear-gradient(to bottom, transparent, black 70%)',
  bottom: 'linear-gradient(to top, transparent, black 70%)',
  left: 'linear-gradient(to right, transparent, black 70%)',
  right: 'linear-gradient(to left, transparent, black 70%)',
};
const maskStyle =
  mask === 'none' ? '' : `mask-image:${masks[mask]};-webkit-mask-image:${masks[mask]};`;
---

<div
  class:list={[
    'nb-pattern',
    tone === 'dark' ? 'bg-navy-800 text-navy-600' : 'text-navy-200',
    className,
  ]}
  style={maskStyle}
  aria-hidden="true"
>
  <svg width="100%" height="100%" class="block">
    <defs>
      <pattern id={id} patternUnits="userSpaceOnUse" width="48" height="40">
        <path d="M0 9H48" fill="none" stroke="currentColor" stroke-width="1.5"></path>
        <path
          d="M4 40V29A20 20 0 0 1 44 29V40"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        ></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
  </svg>
</div>
