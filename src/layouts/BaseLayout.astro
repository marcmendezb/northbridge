---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '../styles/global.css';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import instrumentLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { alternates, localeMeta, parsePath, useI18n } from '../i18n';
import { site } from '../lib/site';
import { readTokens } from '../lib/contrast';
import { ogImage } from '../lib/seo';
const { t, locale } = useI18n(Astro.currentLocale);

const themeColor = readTokens()['navy-800'];

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Content starts under the floating header (full-bleed hero). */
  overlayHeader?: boolean;
  minimalHeader?: boolean;
  /** Pages without a footer. */
  hideFooter?: boolean;
  /** Page-specific structured data (e.g. the organisation on Home and Contact). */
  jsonLd?: object;
}
const {
  title,
  description = t('brand.descriptor'),
  noindex = false,
  overlayHeader = false,
  minimalHeader = false,
  hideFooter = false,
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${t('brand.claim')}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const shareImage = ogImage(locale, Astro.site ?? site.url);
const alternateLinks = alternates(parsePath(Astro.url.pathname).canonical).map((a) => ({
  locale: a.locale,
  href: new URL(a.path, Astro.site ?? site.url).toString(),
}));
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('motion');
      // Country (currency and legal forms), set before first paint: the one chosen in the header or, if none,
      // the one suggested by the browser (time zone and language region). No external services.
      (() => {
        const valid = /^(CH|ES|DE|FR|IT)$/;
        let country = null;
        try {
          country = localStorage.getItem('nb-country');
        } catch {
          // No storage available: infer it.
        }
        if (!valid.test(country || '')) {
          const zones = {
            'Europe/Zurich': 'CH',
            'Europe/Madrid': 'ES',
            'Atlantic/Canary': 'ES',
            'Africa/Ceuta': 'ES',
            'Europe/Berlin': 'DE',
            'Europe/Busingen': 'DE',
            'Europe/Paris': 'FR',
            'Europe/Rome': 'IT',
          };
          const zone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
          const regions = (navigator.languages || [navigator.language])
            .map((l) => (l.split('-')[1] || '').toUpperCase())
            .filter((r) => valid.test(r));
          country = zones[zone] || regions[0] || null;
        }
        if (country) document.documentElement.dataset.country = country;
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={localeMeta[locale].og} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}. ${t('brand.claim')}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {alternateLinks.map((a) => (
      <link rel="alternate" hreflang={localeMeta[a.locale].htmlLang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateLinks[0].href} />
    <script is:inline>
      // Language on arrival from another site: the one for the location (time zone), or the browser's
      // if it isn't one of the five countries. Never if one was already picked in the selector, and never for bots or
      // automated browsers (SEO and tests).
      (() => {
        try {
          if (localStorage.getItem('nb-lang')) return;
          if (navigator.webdriver || /bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent))
            return;
          if (document.referrer && new URL(document.referrer).origin === location.origin) return;
          const supported = ['es', 'en', 'de', 'fr', 'it'];
          const prefs = (navigator.languages || [navigator.language]).map((l) =>
            l.split('-')[0].toLowerCase(),
          );
          // Switzerland has three languages: the first one the browser prefers, otherwise German.
          const local = {
            'Europe/Zurich': ['de', 'fr', 'it'],
            'Europe/Madrid': ['es'],
            'Atlantic/Canary': ['es'],
            'Africa/Ceuta': ['es'],
            'Europe/Berlin': ['de'],
            'Europe/Busingen': ['de'],
            'Europe/Paris': ['fr'],
            'Europe/Rome': ['it'],
          }[Intl.DateTimeFormat().resolvedOptions().timeZone || ''];
          const wanted = local
            ? prefs.find((l) => local.includes(l)) || local[0]
            : prefs.find((l) => supported.includes(l));
          const current = document.documentElement.lang.split('-')[0];
          if (!wanted || wanted === current) return;
          const link = [...document.querySelectorAll('link[rel="alternate"][hreflang]')].find(
            (l) => l.getAttribute('hreflang').split('-')[0] === wanted,
          );
          if (!link) return;
          const target = new URL(link.href).pathname + location.search + location.hash;
          if (target !== location.pathname + location.search + location.hash)
            location.replace(target);
        } catch {
          // No storage or URL support: keep the page language.
        }
      })();
    </script>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preload" as="font" type="font/woff2" href={newsreaderLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={instrumentLatin} crossorigin />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only-focusable fixed top-3 left-3 z-50 rounded-button bg-navy-800 px-4 py-3 text-sm font-semibold text-white no-underline"
    >
      {t('nav.skipToContent')}
    </a>
    <Header minimal={minimalHeader} />
    <main
      id="contenido"
      tabindex="-1"
      class:list={['flex-1 outline-none', !overlayHeader && 'pt-[var(--header-h)]']}
    >
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <script>
      // Smooth scroll on every page; GSAP only where there are scenes. None of it with reduced motion.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Both modules are requested together so the hero doesn't wait for smooth scroll.
        const hasScenes = document.querySelector(
          '[data-hero],[data-reveal],[data-count],[data-split],[data-viaduct],[data-reveal-media],[data-journey],[data-calc-preview],[data-final],[data-price-deck],[data-pricing],[data-about-hero],[data-contact-hero],[data-service-hero],[data-clock]',
        );
        Promise.all([
          import('../components/animations/smoothScroll'),
          hasScenes ? import('../components/animations/init') : null,
        ])
          .then(async ([smooth, scenes]) => {
            smooth.startSmoothScroll();
            await scenes?.initPage();
          })
          .catch(() => document.documentElement.classList.add('anim-fail'));
      }
    </script>
  </body>
</html>
