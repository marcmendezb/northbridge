---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Flag from '../components/brand/Flag.astro';
import ResourcesAsk from '../components/sections/ResourcesAsk.astro';
import { Picture } from 'astro:assets';
import Arrow from '../components/brand/Arrow.astro';
import { topicCovers } from '../lib/covers';
import { FISCAL_CALENDARS } from '../data/fiscal-calendar';
import { COUNTRIES, countryName } from '../lib/country';
import { localeMeta } from '../i18n';
import { blogCategories } from '../content.config';
import { useI18n, type MessageKey } from '../i18n';
import {
  entryKey,
  getArticles,
  getTeam,
  guideCountries,
  guideFor,
  readingMinutes,
} from '../lib/content';
import { formatDate } from '../lib/format';

const { t, lp, locale } = useI18n(Astro.currentLocale);
const articles = await getArticles(locale);
const team = await getTeam(locale);
const authorName = (key: string) => team.find((m) => entryKey(m) === key)?.data.name ?? '';
/** Only categories that have articles. */
const categories = blogCategories.filter((c) => articles.some((a) => a.data.category === c));
const catLabel = (c: string) => t(`resources.categories.${c}` as MessageKey);
/** Countries each guide is shown in (its own, or the Swiss one as a fallback). */
const shownIn = guideCountries(articles);
const lastChecked = new Date(Math.max(...articles.map((a) => a.data.checkedAt.getTime())));
/** "Coming up": each country's calendar (the Swiss one as a fallback) and its full guide. */
const monthName = new Intl.DateTimeFormat(localeMeta[locale].intl, { month: 'long' });
const upcoming = COUNTRIES.map((c) => {
  const country = FISCAL_CALENDARS[c] ? c : 'CH';
  const guide = guideFor(articles, 'calendario', country);
  return {
    c,
    // Without monthly deadlines or minor instalments: only the main due dates here.
    events: (FISCAL_CALENDARS[country] ?? [])
      .filter((e) => !e.recurring && !e.minor)
      .sort((a, b) => a.month - b.month),
    href: guide ? lp(`/recursos/${entryKey(guide)}`) : lp('/recursos'),
  };
});
---

<BaseLayout title={t('resources.seoTitle')} description={t('resources.seoDescription')}>
  <header class="nb-rh">
    <div class="nb-container nb-rh__inner">
      <div class="nb-rh__main">
        <Breadcrumbs items={[{ label: t('nav.resources') }]} />
        <p class="nb-rh__label">{t('resources.title')}</p>
        <h1 class="nb-rh__title" data-split>
          {t('resources.heroTitle')}
        </h1>
        <p class="nb-rh__lead" data-reveal>
          {t('resources.heroLead')}
        </p>
      </div>
      <aside class="nb-rh__country" data-reveal>
        <span class="nb-rh__for">{t('resources.forCountry')}</span>
        {COUNTRIES.map((c) => (
          <span class="nb-rh__name" data-cc={c}>
            <Flag country={c} class="nb-rh__flag" />
            {countryName(c, locale)}
          </span>
        ))}
        <span class="nb-rh__hint">{t('resources.countryHint')}</span>
        <span class="nb-rh__checked">
          {t('article.checked', { date: formatDate(lastChecked, locale) }).split('.')[0]}.
        </span>
      </aside>
    </div>
  </header>

  <section class="nb-res nb-container" data-filter-scope>
    <div class="nb-res__filters" role="group" aria-label={t('resources.filterLabel')} data-filters>
      <button type="button" class="nb-res__chip" aria-pressed="true" data-filter="all">
        {t('resources.all')}
      </button>
      {categories.map((c) => (
        <button type="button" class="nb-res__chip" aria-pressed="false" data-filter={c}>
          {catLabel(c)}
        </button>
      ))}
    </div>

    <ul class="nb-res__grid">
      {articles.map((a) => (
        <li
          class:list={['nb-res__item', a.data.featured && 'nb-res__item--featured']}
          data-category={a.data.category}
          data-cc={(shownIn.get(a.id) ?? []).join(' ')}
          data-reveal
        >
          <a href={lp(`/recursos/${entryKey(a)}`)} class="nb-res__card">
            {topicCovers[a.data.topic] && (
              <span class="nb-res__cover">
                <Picture
                  src={topicCovers[a.data.topic]}
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200]}
                  sizes={
                    a.data.featured
                      ? '(min-width: 768px) 50vw, 100vw'
                      : '(min-width: 768px) 45vw, 100vw'
                  }
                  alt=""
                  loading={a.data.featured ? 'eager' : 'lazy'}
                  quality={72}
                  class="nb-res__img"
                />
              </span>
            )}
            <span class="nb-res__body">
              <span class="nb-res__meta">
                <span class="nb-res__cat">{catLabel(a.data.category)}</span>
                {a.data.featured && <span class="nb-res__featured">{t('resources.featured')}</span>}
              </span>
              <span class="nb-res__title">{a.data.title}</span>
              <span class="nb-res__desc">{a.data.description}</span>
              <span class="nb-res__foot">
                <span>
                  {authorName(a.data.author)} / {formatDate(a.data.publishedAt, locale)} /{' '}
                  {t('resources.readingTime', { n: readingMinutes(a.body) })}
                </span>
                <span class="nb-res__read">
                  {t('resources.read')} <Arrow />
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
  </section>

  <section class="nb-next" aria-labelledby="next-title">
    <div class="nb-container nb-next__inner">
      <div class="nb-next__head">
        <p class="nb-next__label">{t('resources.upcomingLabel')}</p>
        <h2 class="nb-next__title" id="next-title" data-split>
          {t('resources.upcomingTitle')}
        </h2>
        <p class="nb-next__note" data-reveal>
          {t('resources.upcomingNote')}
        </p>
      </div>
      {upcoming.map((u) => (
        <div class="nb-next__country" data-cc={u.c} data-upcoming>
          <ol class="nb-next__list">
            {u.events.map((e, i) => (
              <li class="nb-next__item" data-month={e.month} hidden={i > 3 ? true : undefined}>
                <span class="nb-next__month">
                  {monthName.format(new Date(2026, e.month - 1, 1))}
                </span>
                <span class="nb-next__what">{e.what[locale]}</span>
                <span class="nb-next__when">{e.when[locale]}</span>
              </li>
            ))}
          </ol>
          <a href={u.href} class="nb-next__link">
            {t('resources.upcomingLink')} <Arrow />
          </a>
        </div>
      ))}
    </div>
  </section>

  <ResourcesAsk />
</BaseLayout>

<style is:global>
  /* ── Editorial header ── */
  .nb-rh {
    background: var(--white);
    border-bottom: 1px solid var(--piedra-200);
  }
  .nb-rh__inner {
    display: grid;
    gap: 40px;
    padding-block: clamp(32px, 5vw, 72px) clamp(40px, 6vw, 88px);
  }
  @media (min-width: 1024px) {
    .nb-rh__inner {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.8fr);
      align-items: end;
      gap: 80px;
    }
  }
  .nb-rh__main {
    display: grid;
    gap: 20px;
  }
  .nb-rh__label,
  .nb-next__label {
    margin: 12px 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-600);
  }
  .nb-rh__title {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2.75rem, 1rem + 5.4vw, 6.5rem);
    font-weight: 300;
    line-height: 0.96;
    letter-spacing: -0.03em;
  }
  .nb-rh__lead {
    margin: 0;
    max-width: 36rem;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--piedra-800);
  }
  /* Active country: flag and name, as in the header selector. */
  .nb-rh__country {
    display: grid;
    gap: 8px;
    padding-top: 20px;
    border-top: 1.5px solid var(--navy-800);
  }
  .nb-rh__for {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--piedra-600);
  }
  .nb-rh__name {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1rem + 2.4vw, 3rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--navy-800);
  }
  .nb-rh__name .nb-flag {
    width: 30px;
    height: 20px;
  }
  .nb-rh__name .nb-flag--square {
    width: 20px;
    margin-inline: 5px;
  }
  .nb-rh__hint,
  .nb-rh__checked {
    font-size: 0.875rem;
    color: var(--piedra-600);
  }

  /* ── Coming up ── */
  .nb-next {
    padding-block: var(--section-y);
    background: var(--piedra-100);
  }
  .nb-next__inner {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1024px) {
    .nb-next__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
      gap: 80px;
      align-items: start;
    }
  }
  .nb-next__head {
    display: grid;
    gap: 12px;
  }
  .nb-next__title {
    margin: 0;
    font-size: clamp(2.25rem, 1rem + 3vw, 3.75rem);
    font-weight: 300;
    line-height: 1.05;
  }
  .nb-next__note {
    margin: 0;
    color: var(--piedra-700);
  }
  .nb-next__country {
    display: grid;
    gap: 24px;
  }
  .nb-next__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--navy-800);
  }
  .nb-next__item {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 4px 24px;
    padding-block: 20px;
    border-bottom: 1px solid var(--piedra-300);
  }
  .nb-next__item[hidden] {
    display: none;
  }
  .nb-next__month {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 1vw, 2rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--navy-800);
    text-transform: capitalize;
  }
  .nb-next__what {
    font-weight: 600;
    color: var(--navy-800);
  }
  .nb-next__when {
    font-size: 0.9375rem;
    color: var(--piedra-700);
  }
  @media (max-width: 559px) {
    .nb-next__item {
      grid-template-columns: minmax(0, 1fr);
    }
    .nb-next__month {
      grid-row: auto;
    }
  }
  .nb-next__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
    color: var(--navy-600);
    text-decoration: none;
  }
  .nb-next__link:hover {
    color: var(--salvia-600);
  }

  .nb-res {
    display: grid;
    gap: 32px;
    padding-block: clamp(32px, 5vw, 64px) var(--section-y);
  }
  /* Without JS there's no filter: all guides are shown. */
  .nb-res__filters {
    display: none;
    flex-wrap: wrap;
    gap: 8px;
  }
  .js .nb-res__filters {
    display: flex;
  }
  .nb-res__chip {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--piedra-300);
    border-radius: var(--radius-button, 4px);
    background: var(--white);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--navy-800);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .nb-res__chip:hover {
    border-color: var(--navy-800);
  }
  .nb-res__chip[aria-pressed='true'] {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--white);
  }
  .nb-res__chip:focus-visible {
    outline: 2px solid var(--navy-600);
    outline-offset: 3px;
  }
  .nb-res__grid {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .nb-res__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .nb-res__item--featured {
      grid-column: 1 / -1;
    }
  }
  .nb-res__item[hidden] {
    display: none;
  }
  .nb-res__card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--piedra-200);
    border-radius: var(--radius-card, 8px);
    background: var(--white);
    color: var(--navy-800);
    text-decoration: none;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }
  .nb-res__card:hover {
    border-color: var(--navy-800);
  }
  .nb-res__body {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: clamp(24px, 3vw, 40px);
  }
  /* Cover: the photo zooms in very slowly on hover. */
  .nb-res__cover {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--piedra-100);
  }
  .nb-res__cover picture {
    display: contents;
  }
  .nb-res__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1400ms var(--ease-out);
  }
  .nb-res__card:hover .nb-res__img {
    transform: scale(1.04);
  }
  @media (min-width: 768px) {
    .nb-res__item--featured .nb-res__card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: none;
    }
    .nb-res__item--featured .nb-res__cover {
      order: 2;
      aspect-ratio: auto;
      min-height: 420px;
    }
  }
  .nb-res__item--featured .nb-res__card {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--white);
  }
  .nb-res__item--featured .nb-res__card:hover {
    background: var(--navy-700);
  }
  .nb-res__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .nb-res__cat,
  .nb-res__featured {
    padding: 4px 8px;
    border-radius: var(--radius-tag, 2px);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .nb-res__cat {
    background: var(--piedra-100);
    color: var(--piedra-700);
  }
  .nb-res__featured {
    background: var(--salvia-400);
    color: var(--navy-800);
  }
  .nb-res__item--featured .nb-res__cat {
    background: var(--navy-700);
    color: var(--navy-100);
  }
  .nb-res__title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.625rem, 1rem + 1.6vw, 2.25rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }
  .nb-res__item--featured .nb-res__title {
    max-width: 18ch;
    font-size: clamp(2rem, 1rem + 3vw, 3.75rem);
    font-weight: 300;
  }
  .nb-res__desc {
    max-width: 44rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--piedra-700);
  }
  .nb-res__item--featured .nb-res__desc {
    color: var(--navy-100);
  }
  .nb-res__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--piedra-200);
    font-size: 0.875rem;
    color: var(--piedra-600);
  }
  .nb-res__item--featured .nb-res__foot {
    border-color: var(--navy-600);
    color: var(--navy-200);
  }
  .nb-res__read {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--navy-800);
  }
  .nb-res__item--featured .nb-res__read {
    color: var(--white);
  }
</style>

<script>
  // Topic filter with minimal JS. Without JS the buttons are hidden and all guides are shown.
  document.querySelectorAll<HTMLElement>('[data-filter-scope]').forEach((scope) => {
    const buttons = [...scope.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...scope.querySelectorAll<HTMLElement>('[data-category]')];
    const status = scope.querySelector<HTMLElement>('[data-filter-status]');
    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        const value = btn.dataset.filter;
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
        for (const item of items)
          item.hidden = !(value === 'all' || item.dataset.category === value);
        // Only the active country's guides count (the rest are hidden by CSS).
        const shown = items.filter((item) => item.offsetParent !== null).length;
        if (status) status.textContent = `${btn.textContent?.trim()}: ${shown}`;
      });
    }
  });

  // "Coming up": the next four due dates from the current month (wrapping into next year).
  const month = new Date().getMonth() + 1;
  document.querySelectorAll<HTMLElement>('[data-upcoming]').forEach((block) => {
    const list = block.querySelector('ol');
    const items = [...block.querySelectorAll<HTMLElement>('[data-month]')];
    if (!list || !items.length) return;
    const ordered = [
      ...items.filter((i) => Number(i.dataset.month) >= month),
      ...items.filter((i) => Number(i.dataset.month) < month),
    ];
    ordered.forEach((item, i) => {
      item.hidden = i > 3;
      list.append(item);
    });
  });
</script>
