---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Accordion from '../components/ui/Accordion.astro';
import BookingEmbed from '../components/islands/BookingEmbed.tsx';
import lea from '../assets/img/about/team/lea-brunner.jpeg';
import conversation from '../assets/img/about/office/nb-consulta-conversacion-01.jpeg';
import { localeMeta, useI18n, type Messages } from '../i18n';
import { site } from '../lib/site';

const { t, tRaw, lp, locale } = useI18n(Astro.currentLocale);
const s = tRaw<Messages['booking']>('booking');
const tel = `tel:${site.phone.replace(/\s/g, '')}`;
/** Cal.com solo si hay un enlace real configurado (PUBLIC_CAL_LINK); si no, demostración. */
const calLink = import.meta.env.PUBLIC_CAL_LINK as string | undefined;
import { byCountry } from '../lib/country';
import { OFFICES } from '../data/offices';
---

<BaseLayout title={s.seoTitle} description={s.seoDescription}>
  <section class="nb-bk nb-container">
    <div class="nb-bk__intro">
      <Breadcrumbs items={[{ label: s.label }]} />
      <p class="nb-bk__label">{s.label}</p>
      <h1 class="nb-bk__title" data-split>
        {t('home.cta.title')}
      </h1>
      <p class="nb-bk__lead" data-reveal>
        {s.lead}
      </p>
      <ul class="nb-bk__guarantees" data-reveal>
        {s.guarantees.map((g) => (
          <li>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M2.5 8.5l3.5 3.5 7.5-8"></path>
            </svg>
            {g}
          </li>
        ))}
      </ul>

      <div class="nb-bk__photo" data-reveal-media>
        <Picture
          src={conversation}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          alt=""
          loading="eager"
          quality={74}
          class="nb-bk__photo-img"
        />
      </div>

      <h2 class="nb-bk__h">{s.expectTitle}</h2>
      <ol class="nb-bk__expect">
        {s.expect.map((e) => (
          <li data-reveal>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
          </li>
        ))}
      </ol>

      <div class="nb-bk__meet" data-reveal>
        <div class="nb-bk__arch">
          <Picture
            src={lea}
            formats={['avif', 'webp']}
            widths={[200, 320]}
            sizes="140px"
            alt="Lea Brunner"
            quality={72}
          />
        </div>
        <div>
          <h2 class="nb-bk__h nb-bk__h--small">{s.meetTitle}</h2>
          <p class="nb-bk__meet-text">{s.meetText}</p>
        </div>
      </div>
    </div>

    <div class="nb-bk__panel" id="reservar">
      <h2 class="nb-bk__h nb-bk__h--panel">{s.calendarTitle}</h2>
      <p
        class="nb-bk__panel-lead"
        set:html={byCountry((c) => s.calendarLead.replace('{city}', OFFICES[c].cityName[locale]))}
      />
      <BookingEmbed
        client:load
        s={s}
        demo={tRaw<Messages['demo']>('demo')}
        intl={localeMeta[locale].intl}
        thanksHref={lp('/gracias')}
        calLink={calLink}
      />
      <div class="nb-bk__phone">
        <p class="nb-bk__phone-title">{s.phoneTitle}</p>
        <p class="nb-bk__phone-text">
          {s.phoneText.split('{phone}')[0]}
          <a href={tel}>{site.phone}</a>
          {s.phoneText.split('{phone}')[1]}
        </p>
      </div>
    </div>
  </section>

  <section class="nb-bk-faq">
    <div class="nb-container nb-bk-faq__inner">
      <h2 class="m-0">{s.faqTitle}</h2>
      <Accordion items={[...s.faq]} level="h3" openFirst />
    </div>
  </section>
</BaseLayout>

<style is:global>
  .nb-bk {
    display: grid;
    gap: 40px;
    align-items: start;
    padding-block: clamp(32px, 5vw, 72px) var(--section-y);
  }
  @media (min-width: 1024px) {
    .nb-bk {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: 72px;
    }
    .nb-bk__panel {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
  .nb-bk__intro {
    display: grid;
    gap: 24px;
  }
  .nb-bk__label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-600);
  }
  .nb-bk__title {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2.5rem, 1rem + 4.4vw, 5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .nb-bk__lead {
    margin: 0;
    max-width: 36rem;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--piedra-800);
  }
  .nb-bk__guarantees {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
    color: var(--navy-800);
  }
  .nb-bk__guarantees li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .nb-bk__guarantees svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--salvia-600);
    stroke-width: 1.5;
  }
  .nb-bk__photo {
    aspect-ratio: 16 / 10;
    margin-top: 8px;
    overflow: hidden;
    border-radius: var(--radius-card, 8px);
    background: var(--piedra-100);
  }
  .nb-bk__photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nb-bk__h {
    margin: 24px 0 0;
    font-size: clamp(1.5rem, 1rem + 1vw, 2rem);
    font-weight: 400;
  }
  .nb-bk__h--small {
    margin: 0 0 8px;
    font-size: 1.375rem;
  }
  .nb-bk__h--panel {
    margin: 0;
    color: var(--white);
  }
  .nb-bk__expect {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--navy-800);
  }
  .nb-bk__expect li {
    display: grid;
    gap: 4px;
    padding-block: 18px;
    border-bottom: 1px solid var(--piedra-200);
  }
  .nb-bk__expect h3 {
    margin: 0;
    font-size: 1.25rem;
  }
  .nb-bk__expect p {
    margin: 0;
    color: var(--piedra-700);
  }
  .nb-bk__meet {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    align-items: end;
    gap: 24px;
    margin-top: 8px;
  }
  .nb-bk__arch {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 9999px 9999px 0 0;
    background: var(--piedra-200);
  }
  .nb-bk__arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }
  .nb-bk__meet-text {
    margin: 0;
    color: var(--piedra-800);
  }

  .nb-bk__panel {
    display: grid;
    gap: 20px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-card, 8px);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-bk__panel-lead {
    margin: -8px 0 0;
    font-size: 0.9375rem;
    color: var(--navy-200);
  }
  .nb-bk__phone {
    padding-top: 20px;
    border-top: 1px solid var(--navy-600);
  }
  .nb-bk__phone-title {
    margin: 0 0 4px;
    font-weight: 600;
    color: var(--white);
  }
  .nb-bk__phone-text {
    margin: 0;
    font-size: 0.9375rem;
  }
  .nb-bk__phone a {
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
  }
  .nb-bk__phone a:hover {
    color: var(--salvia-300);
  }

  /* Calendario (isla BookingEmbed). */
  .nb-book {
    display: grid;
    gap: 20px;
    margin: 0;
  }
  .nb-book__set {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .nb-book__set:disabled {
    opacity: 0.45;
  }
  .nb-book__legend {
    margin-bottom: 10px;
    padding: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy-200);
  }
  .nb-book__days {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
    min-height: 68px;
  }
  .nb-book__times {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
    gap: 6px;
  }
  .nb-book__day,
  .nb-book__time {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 10px 4px;
    border: 1px solid var(--navy-600);
    border-radius: var(--radius-button, 4px);
    color: var(--white);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .nb-book__time {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .nb-book__day input,
  .nb-book__time input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .nb-book__day:hover,
  .nb-book__time:hover {
    border-color: var(--navy-200);
  }
  .nb-book__day:has(input:checked),
  .nb-book__time:has(input:checked) {
    border-color: var(--white);
    background: var(--white);
    color: var(--navy-800);
  }
  .nb-book__day:has(input:focus-visible),
  .nb-book__time:has(input:focus-visible) {
    outline: 2px solid var(--salvia-300);
    outline-offset: 2px;
  }
  .nb-book__weekday {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .nb-book__date {
    font-family: var(--font-display);
    font-size: 1.125rem;
  }
  .nb-book__status {
    margin: 0;
    min-height: 1.5em;
    font-size: 0.9375rem;
    color: var(--white);
  }
  .nb-book__confirm {
    justify-self: start;
    min-height: 48px;
    padding: 0 22px;
    border: 0;
    border-radius: var(--radius-button, 4px);
    background: var(--white);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--navy-800);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .nb-book__confirm:hover:not(:disabled) {
    background: var(--piedra-100);
  }
  .nb-book__confirm:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .nb-book__confirm:focus-visible {
    outline: 2px solid var(--salvia-300);
    outline-offset: 3px;
  }
  .nb-book__demo {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--navy-300);
  }
  .nb-book__consent-title {
    margin: 0;
    font-weight: 600;
    color: var(--white);
  }
  .nb-book__consent-text {
    margin: 0;
    font-size: 0.9375rem;
  }
  .nb-book__frame {
    width: 100%;
    min-height: 640px;
    border: 0;
    border-radius: var(--radius-button, 4px);
    background: var(--white);
  }

  .nb-bk-faq {
    padding-block: var(--section-y);
    background: var(--piedra-100);
  }
  .nb-bk-faq__inner {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 768px) {
    .nb-bk-faq__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: 64px;
    }
  }
</style>
