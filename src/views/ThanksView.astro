---
import BaseLayout from '../layouts/BaseLayout.astro';
import BridgeMark from '../components/brand/BridgeMark.astro';
import Arrow from '../components/brand/Arrow.astro';
import { localeMeta, useI18n } from '../i18n';

const { t, tRaw, lp, locale } = useI18n(Astro.currentLocale);
const next = tRaw<string[]>('thanks.next');
const nextDay = t('thanks.nextDay');
---

<BaseLayout title={t('thanks.seoTitle')} noindex overlayHeader>
  <section class="nb-thanks" data-surface="dark">
    <div class="nb-container nb-thanks__inner">
      <BridgeMark animate class="nb-thanks__mark" strokeWidth={2.5} />
      <h1 class="nb-thanks__title">{t('thanks.title')}</h1>
      <p class="nb-thanks__lead">{t('thanks.lead')}</p>
      <p
        class="nb-thanks__booked"
        data-booked
        data-template={t('thanks.booked')}
        data-intl={localeMeta[locale].intl}
        hidden
      ></p>

      <div class="nb-thanks__next">
        <h2 class="nb-thanks__h">{t('thanks.nextTitle')}</h2>
        <ol>
          {next.map((step) => (
            <li>
              <svg class="nb-thanks__n" viewBox="4 11 40 26" aria-hidden="true">
                <path d="M4 13H44"></path>
                <path d="M10 37V29A14 14 0 0 1 38 29V37"></path>
              </svg>
              <span
                data-next-day={step.includes('{date}') ? '' : undefined}
                data-template={step}
                data-intl={localeMeta[locale].intl}
              >
                {step.replace('{date}', nextDay)}
              </span>
            </li>
          ))}
        </ol>
      </div>

      <div class="nb-thanks__more">
        <p class="nb-thanks__h">{t('thanks.meanwhile')}</p>
        <a href={lp('/recursos/calendario-fiscal-para-pymes')}>
          {t('thanks.readGuide')} <Arrow />
        </a>
        <a href={lp('/calculadora')}>
          {t('thanks.tryCalculator')} <Arrow />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .nb-thanks {
    min-height: 100svh;
    padding-top: var(--header-h);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-thanks__inner {
    display: grid;
    justify-items: start;
    gap: 24px;
    padding-block: clamp(48px, 8vw, 120px);
  }
  .nb-thanks__mark {
    width: clamp(88px, 9vw, 120px);
    height: auto;
    color: var(--white);
  }
  .nb-thanks__title {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.5rem, 1rem + 5vw, 5.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--white);
  }
  .nb-thanks__lead,
  .nb-thanks__booked {
    margin: 0;
    max-width: 36rem;
    font-size: 1.1875rem;
    line-height: 1.55;
  }
  .nb-thanks__booked {
    padding: 12px 16px;
    border: 1px solid var(--navy-600);
    border-radius: var(--radius-button, 4px);
    color: var(--white);
  }
  .nb-thanks__next {
    width: 100%;
    max-width: 44rem;
    margin-top: 24px;
  }
  .nb-thanks__h {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-200);
  }
  .nb-thanks__next ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--navy-600);
  }
  .nb-thanks__next li {
    display: flex;
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--navy-600);
    font-size: 1.0625rem;
    color: var(--white);
  }
  /* Sin numeración: el símbolo, pequeño, marca cada paso. */
  .nb-thanks__n {
    flex: none;
    width: 22px;
    height: 14px;
    margin-top: 0.45em;
    fill: none;
    stroke: var(--salvia-300);
    stroke-width: 4;
  }
  .nb-thanks__more {
    display: grid;
    gap: 8px;
    margin-top: 16px;
  }
  .nb-thanks__more a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
    color: var(--white);
    text-decoration: none;
  }
  .nb-thanks__more a:hover {
    color: var(--salvia-300);
  }
</style>

<script>
  // Fechas concretas (docs/02: «El 30 de noviembre», no «próximamente»), calculadas en el navegador.
  const nextWorkingDay = () => {
    const d = new Date();
    do d.setDate(d.getDate() + 1);
    while (d.getDay() === 0 || d.getDay() === 6);
    return d;
  };
  document.querySelectorAll<HTMLElement>('[data-next-day]').forEach((el) => {
    const fmt = new Intl.DateTimeFormat(el.dataset.intl, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
    });
    el.textContent = (el.dataset.template ?? '').replace('{date}', fmt.format(nextWorkingDay()));
  });

  // Si viene de la reserva: «Tu consulta: martes, 28 de octubre a las 10:30».
  const booked = document.querySelector<HTMLElement>('[data-booked]');
  const q = new URLSearchParams(location.search);
  const fecha = q.get('fecha');
  const hora = q.get('hora');
  if (booked && fecha && hora && /^\d{4}-\d{2}-\d{2}$/.test(fecha) && /^\d{2}:\d{2}$/.test(hora)) {
    const [y, m, d] = fecha.split('-').map(Number);
    const fmt = new Intl.DateTimeFormat(booked.dataset.intl, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
    });
    booked.textContent = (booked.dataset.template ?? '')
      .replace('{date}', fmt.format(new Date(y, m - 1, d)))
      .replace('{time}', hora);
    booked.hidden = false;
  }
</script>
