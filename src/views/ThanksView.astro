---
/**
 * Confirmación: tu mensaje cruza el puente. El símbolo a escala de pantalla; un punto sale de la
 * pata izquierda (tú, ahora) y recorre el arco hasta la derecha (quien lo lee). Bajo el arco, un
 * reloj con el tiempo real que falta para la respuesta, o para la consulta si se ha reservado.
 * Sin JS se ve completo y quieto, con textos generales.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/brand/Arrow.astro';
import lea from '../assets/img/about/team/lea-brunner.jpeg';
import { localeMeta, useI18n, type Messages } from '../i18n';
import { entryKey, getArticles, getTeam, guideCountries } from '../lib/content';

const { tRaw, lp, locale } = useI18n(Astro.currentLocale);
const s = tRaw<Messages['thanks']>('thanks');
const reader = (await getTeam(locale))[0];
const readerName = reader?.data.name ?? 'Lea Brunner';
const [readerBefore = '', readerAfter = ''] = s.reader.split('{name}');
const [bookedBefore = '', bookedAfter = ''] = s.readerBooked.split('{name}');
/** El calendario fiscal del país activo (o el suizo si aún no tiene). */
const guides = await getArticles(locale);
const shownIn = guideCountries(guides);
const calendars = guides.filter((g) => g.data.topic === 'calendario');

/** Geometría del símbolo (tablero y arco tangente), en unidades del viewBox. */
const W = 1200;
const H = 500;
const LEG = 150;
const R = (W - 2 * LEG) / 2;
const ROUTE = `M${LEG} ${H} V${8 + R} A${R} ${R} 0 0 1 ${W - LEG} ${8 + R} V${H}`;
---

<BaseLayout title={s.seoTitle} noindex overlayHeader>
  <section
    class="nb-ty"
    data-surface="dark"
    data-thanks
    data-locale={locale}
    data-intl={localeMeta[locale].intl}
  >
    <div class="nb-container nb-ty__inner">
      <div class="nb-cross">
        <div class="nb-cross__stage">
          <h1 class="nb-ty__title" data-booked-text={s.titleBooked}>
            {s.title}
          </h1>
          <svg
            class="nb-cross__svg"
            viewBox={`0 0 ${W} ${H}`}
            fill="none"
            aria-hidden="true"
            data-cross
          >
            <path class="nb-cross__deck" d={`M0 8H${W}`}></path>
            <path class="nb-cross__arch" d={ROUTE}></path>
            <path class="nb-cross__trace" d={ROUTE} data-route></path>
            <g class="nb-cross__dot" data-dot transform={`translate(${W - LEG} ${H})`}>
              <circle r="9"></circle>
            </g>
          </svg>

          <!-- El reloj, bajo el arco: solo con JS (sin él, las fechas de las patas lo dicen todo). -->
          <div class="nb-tyclock" data-clock hidden>
            <p class="nb-tyclock__label" data-booked-text={s.countdownBooked}>
              {s.countdown}
            </p>
            <p class="nb-tyclock__time" aria-hidden="true">
              <span>
                <b data-h>00</b>
                <small>{s.hours}</small>
              </span>
              <i>:</i>
              <span>
                <b data-m>00</b>
                <small>{s.minutes}</small>
              </span>
              <i>:</i>
              <span>
                <b data-s>00</b>
                <small>{s.seconds}</small>
              </span>
            </p>
            <p class="sr-only" data-clock-sr data-template={s.countdownSr}></p>
          </div>
        </div>

        <h2 class="sr-only">{s.bridgeTitle}</h2>
        <ol class="nb-cross__feet" role="list">
          <li class="nb-cross__foot nb-cross__foot--from">
            <p class="nb-cross__who">{s.you}</p>
            <p class="nb-cross__when" data-now data-template={s.now}>
              {s.today}
            </p>
            <p class="nb-cross__what" data-booked-text={s.bookedNow}>
              {s.received}
            </p>
          </li>
          <li class="nb-cross__foot nb-cross__foot--to">
            <div class="nb-cross__portrait">
              <Picture
                src={lea}
                formats={['avif', 'webp']}
                widths={[160, 320]}
                sizes="88px"
                alt=""
                quality={74}
                class="nb-cross__img"
              />
            </div>
            <p class="nb-cross__who">
              <span data-reader>
                {readerBefore}
                <strong>{readerName}</strong>
                {readerAfter}
              </span>
              <span
                data-reader-booked
                data-before={bookedBefore}
                data-after={bookedAfter}
                data-name={readerName}
                hidden
              ></span>
            </p>
            <p
              class="nb-cross__when"
              data-reply
              data-template={s.replyWhen}
              data-booked-template={s.callWhen}
            >
              {s.replyFallback}
            </p>
            <p class="nb-cross__what" data-booked-text={s.call}>
              {s.reply}
            </p>
          </li>
          <li class="nb-cross__after">
            <p class="nb-cross__when">{s.after}</p>
            <p class="nb-cross__what">{s.proposal}</p>
          </li>
        </ol>
      </div>

      <div class="nb-ty__foot">
        <div class="nb-ty__more">
          <p class="nb-ty__meanwhile">{s.meanwhile}</p>
          {calendars.map((g) => (
            <a href={lp(`/recursos/${entryKey(g)}`)} data-cc={(shownIn.get(g.id) ?? []).join(' ')}>
              {s.readGuide} <Arrow />
            </a>
          ))}
          <a href={lp('/calculadora')}>
            {s.tryCalculator} <Arrow />
          </a>
        </div>
        <p class="nb-ty__demo">{s.demo}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .nb-ty {
    position: relative;
    overflow: clip;
    min-height: 100svh;
    padding-top: var(--header-h);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-ty__inner {
    display: grid;
    gap: clamp(32px, 4vw, 56px);
    padding-block: clamp(32px, 4vw, 56px) clamp(40px, 5vw, 72px);
  }
  .nb-ty__title {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(2.75rem, 1rem + 5vw, 5.25rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--white);
    text-wrap: balance;
  }

  /* ── El puente: el símbolo a escala de pantalla. En móvil, titular encima y reloj debajo;
     en escritorio, los dos bajo el arco. ── */
  .nb-cross__stage {
    position: relative;
    display: grid;
    gap: 28px;
  }
  @media (min-width: 760px) {
    .nb-cross__stage {
      display: block;
    }
    .nb-ty__title {
      position: absolute;
      inset: 15% 18% auto;
      margin-inline: auto;
      font-size: clamp(2.5rem, 0.8rem + 3.6vw, 4.5rem);
      text-align: center;
    }
  }
  .nb-cross__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .nb-cross__deck,
  .nb-cross__arch {
    stroke: var(--navy-200);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .nb-cross__arch {
    stroke: var(--navy-600);
  }
  /* El recorrido del mensaje: salvia, trazado detrás del punto. */
  .nb-cross__trace {
    stroke: var(--salvia-300);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .nb-cross__dot circle {
    fill: var(--navy-800);
    stroke: var(--salvia-300);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  /* ── El reloj, bajo el arco ── */
  .nb-tyclock {
    display: grid;
    justify-items: center;
    gap: 14px;
    text-align: center;
  }
  @media (min-width: 760px) {
    .nb-tyclock {
      position: absolute;
      inset: 52% 18% auto;
      margin: 0;
    }
  }
  .nb-tyclock[hidden] {
    display: none;
  }
  .nb-tyclock__label {
    margin: 0;
    font-size: 1rem;
    color: var(--navy-200);
  }
  .nb-tyclock__time {
    display: flex;
    align-items: flex-start;
    gap: clamp(6px, 1.2vw, 16px);
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 300;
    line-height: 1;
    color: var(--white);
  }
  .nb-tyclock__time span {
    display: grid;
    justify-items: center;
    gap: 10px;
  }
  .nb-tyclock__time b {
    font-size: clamp(3.25rem, 1rem + 5.2vw, 6.5rem);
    font-weight: 300;
    font-variant-numeric: lining-nums tabular-nums;
    letter-spacing: -0.03em;
  }
  .nb-tyclock__time i {
    font-size: clamp(2.5rem, 1rem + 3.6vw, 4.75rem);
    font-style: normal;
    color: var(--navy-600);
    transform: translateY(0.08em);
  }
  .nb-tyclock__time small {
    font-family: var(--font-text);
    font-size: 0.8125rem;
    color: var(--navy-200);
  }

  /* ── Las patas: tú y quien lo lee; después, en la línea del suelo ── */
  .nb-cross__feet {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 24px 0 0;
    list-style: none;
    border-top: 1px solid var(--navy-600);
  }
  .nb-cross__foot,
  .nb-cross__after {
    display: grid;
    align-content: start;
    gap: 6px;
  }
  .nb-cross__who {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 300;
    color: var(--navy-200);
  }
  .nb-cross__who strong {
    font-weight: 400;
    color: var(--white);
  }
  .nb-cross__when {
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: 300;
    line-height: 1.15;
    color: var(--white);
    text-wrap: balance;
  }
  .nb-cross__what {
    margin: 0;
    max-width: 30ch;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--navy-100);
    text-wrap: pretty;
  }
  .nb-cross__after :is(.nb-cross__when, .nb-cross__what) {
    color: var(--navy-200);
  }
  .nb-cross__portrait {
    width: 72px;
    aspect-ratio: 3 / 4;
    margin-bottom: 8px;
    overflow: hidden;
    border-radius: 9999px 9999px 0 0;
    background: var(--navy-700);
  }
  .nb-cross__portrait picture {
    display: contents;
  }
  .nb-cross__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Escritorio: cada pata bajo su arco (12,5 % y 87,5 % del ancho), después en el centro. */
  @media (min-width: 760px) {
    .nb-cross__feet {
      grid-template-columns: 25% 1fr 25%;
      gap: 0;
      padding-top: 28px;
    }
    .nb-cross__foot--from {
      grid-column: 1;
      grid-row: 1;
      justify-items: center;
      text-align: center;
    }
    .nb-cross__foot--to {
      grid-column: 3;
      grid-row: 1;
      justify-items: center;
      text-align: center;
    }
    .nb-cross__after {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      justify-items: center;
      padding-inline: 24px;
      text-align: center;
    }
    .nb-cross__portrait {
      margin-top: -64px;
    }
  }

  /* ── Pie ── */
  .nb-ty__foot {
    display: grid;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--navy-600);
  }
  @media (min-width: 900px) {
    .nb-ty__foot {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      align-items: end;
    }
  }
  .nb-ty__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 32px;
  }
  .nb-ty__meanwhile {
    margin: 0;
    width: 100%;
    font-size: 0.9375rem;
    color: var(--navy-200);
  }
  .nb-ty__more a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
    color: var(--white);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nb-ty__more a:hover {
    color: var(--salvia-300);
  }
  .nb-ty__more a:focus-visible {
    outline: 2px solid var(--salvia-300);
    outline-offset: 3px;
  }
  .nb-ty__demo {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--navy-200);
  }

  /* ── Entrada: titular, tablero y arco; el mensaje cruza con JS ── */
  @media (prefers-reduced-motion: no-preference) {
    .js.motion .nb-ty__title {
      animation: nb-ty-rise var(--dur-slow) var(--ease-out) both;
    }
    .js.motion .nb-cross__deck {
      transform-origin: 0 0;
      animation: nb-ty-deck 1.2s var(--ease-out) 0.3s both;
    }
    .js.motion .nb-cross__arch,
    .js.motion .nb-cross__feet,
    .js.motion .nb-tyclock {
      animation: nb-ty-fade 1s var(--ease-out) 0.6s both;
    }
    .js.motion .nb-cross__foot--to,
    .js.motion .nb-cross__after {
      animation: nb-ty-rise 0.9s var(--ease-out) 3.2s both;
    }
    .js.motion .nb-ty__foot {
      animation: nb-ty-fade var(--dur-slow) var(--ease-out) 3.4s both;
    }
  }
  @keyframes nb-ty-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes nb-ty-deck {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes nb-ty-fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  import { formatDay, replyDay, type CivilDate } from '../lib/contact/office';
  import { OFFICE_CLOSED } from '../lib/contact/closed-days';
  import type { Country } from '../lib/country';

  const root = document.documentElement;
  const section = document.querySelector<HTMLElement>('[data-thanks]');

  /** Hora civil de Zúrich (las cinco oficinas comparten huso) a instante real. */
  const zurich = ({ y, m, d }: CivilDate, h: number, min: number) => {
    const guess = Date.UTC(y, m - 1, d, h, min);
    const parts = Object.fromEntries(
      new Intl.DateTimeFormat('en-US', {
        timeZone: 'Europe/Zurich',
        hourCycle: 'h23',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
      })
        .formatToParts(new Date(guess))
        .map((p) => [p.type, p.value]),
    );
    const seen = Date.UTC(+parts.year, +parts.month - 1, +parts.day, +parts.hour, +parts.minute);
    return new Date(guess - (seen - guess));
  };

  if (section) {
    const locale = section.dataset.locale ?? 'es';
    const intl = section.dataset.intl ?? locale;
    const now = new Date();
    const cap = (text: string) => text.charAt(0).toLocaleUpperCase(intl) + text.slice(1);
    const pad = (n: number) => String(n).padStart(2, '0');

    // Tú, ahora.
    const nowEl = section.querySelector<HTMLElement>('[data-now]');
    const time = new Intl.DateTimeFormat(intl, { hour: '2-digit', minute: '2-digit' }).format(now);
    if (nowEl) nowEl.textContent = (nowEl.dataset.template ?? '').replace('{time}', time);

    // ¿Viene de la reserva? Entonces el segundo tramo es la consulta.
    const q = new URLSearchParams(location.search);
    const fecha = q.get('fecha') ?? '';
    const hora = q.get('hora') ?? '';
    const booked = /^\d{4}-\d{2}-\d{2}$/.test(fecha) && /^\d{2}:\d{2}$/.test(hora);
    const reply = section.querySelector<HTMLElement>('[data-reply]');
    /** Momento al que cuenta el reloj (se rehace si cambia el país). */
    const goal: { at: Date | null } = { at: null };

    if (booked) {
      section.querySelectorAll<HTMLElement>('[data-booked-text]').forEach((el) => {
        el.textContent = el.dataset.bookedText ?? el.textContent;
      });
      const plain = section.querySelector<HTMLElement>('[data-reader]');
      const alt = section.querySelector<HTMLElement>('[data-reader-booked]');
      if (plain && alt) {
        const strong = document.createElement('strong');
        strong.textContent = alt.dataset.name ?? '';
        alt.replaceChildren(alt.dataset.before ?? '', strong, alt.dataset.after ?? '');
        plain.hidden = true;
        alt.hidden = false;
      }
      const [y, m, d] = fecha.split('-').map(Number);
      const [hh, mm] = hora.split(':').map(Number);
      if (reply)
        reply.textContent = cap(
          (reply.dataset.bookedTemplate ?? '')
            .replace('{date}', formatDay({ y, m, d }, locale))
            .replace('{time}', hora),
        );
      goal.at = zurich({ y, m, d }, hh, mm);
    } else if (reply) {
      // Antes de las 12:00 del siguiente día laborable de la oficina del país elegido.
      const render = () => {
        const country = (root.dataset.country ?? 'CH') as Country;
        const day = replyDay(now, OFFICE_CLOSED[country] ?? OFFICE_CLOSED.CH);
        reply.textContent = cap(
          (reply.dataset.template ?? '').replace('{date}', formatDay(day, locale)),
        );
        goal.at = zurich(day, 12, 0);
      };
      render();
      new MutationObserver(render).observe(root, { attributeFilter: ['data-country'] });
    }

    // El reloj: horas, minutos y segundos reales hasta ese momento.
    const clock = section.querySelector<HTMLElement>('[data-clock]');
    if (clock && goal.at) {
      const [h, m, sEl] = (['[data-h]', '[data-m]', '[data-s]'] as const).map((sel) =>
        clock.querySelector<HTMLElement>(sel),
      );
      const sr = clock.querySelector<HTMLElement>('[data-clock-sr]');
      const label = clock.querySelector<HTMLElement>('.nb-tyclock__label')?.textContent ?? '';
      const tick = () => {
        const left = Math.max(0, Math.floor(((goal.at?.getTime() ?? 0) - Date.now()) / 1000));
        if (h) h.textContent = pad(Math.floor(left / 3600));
        if (m) m.textContent = pad(Math.floor((left % 3600) / 60));
        if (sEl) sEl.textContent = pad(left % 60);
        return left;
      };
      const left = tick();
      if (sr)
        sr.textContent = (sr.dataset.template ?? '')
          .replace('{label}', label)
          .replace('{h}', String(Math.floor(left / 3600)))
          .replace('{m}', String(Math.floor((left % 3600) / 60)));
      clock.hidden = false;
      const timer = window.setInterval(() => {
        if (tick() === 0) window.clearInterval(timer);
      }, 1000);
    }

    // El mensaje cruza el puente: el punto recorre el arco y deja el trazo salvia detrás.
    const svg = section.querySelector<SVGSVGElement>('[data-cross]');
    const route = svg?.querySelector<SVGPathElement>('[data-route]');
    const dot = svg?.querySelector<SVGGElement>('[data-dot]');
    if (svg && route && dot) {
      const total = route.getTotalLength();
      const place = (t: number) => {
        const p = route.getPointAtLength(total * t);
        dot.setAttribute('transform', `translate(${p.x} ${p.y})`);
        // Con non-scaling-stroke, el guion se mide en píxeles de pantalla: se escala la longitud.
        const screen = total * (svg.getBoundingClientRect().width / svg.viewBox.baseVal.width);
        route.style.strokeDasharray = `${screen} ${screen}`;
        route.style.strokeDashoffset = `${screen * (1 - t)}`;
      };
      const still = !root.classList.contains('motion');
      if (still) place(1);
      else {
        place(0);
        const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
        const start = performance.now() + 900;
        const run = (ts: number) => {
          const t = Math.min(1, Math.max(0, (ts - start) / 2400));
          place(ease(t));
          if (t < 1) requestAnimationFrame(run);
        };
        requestAnimationFrame(run);
      }
    }
  }
</script>
