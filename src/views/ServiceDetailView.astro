---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Button from '../components/ui/Button.astro';
import PriceTag from '../components/ui/PriceTag.astro';
import Accordion from '../components/ui/Accordion.astro';
import Arrow from '../components/brand/Arrow.astro';
import ServiceProcess from '../components/sections/ServiceProcess.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import contabilidad from '../assets/img/services/contabilidad.jpeg';
import iva from '../assets/img/services/iva.jpeg';
import nominas from '../assets/img/services/nominas.jpeg';
import constitucion from '../assets/img/services/constitucion.jpeg';
import startups from '../assets/img/services/startup.jpeg';
import { useI18n } from '../i18n';
import { entryKey, getArticles, getServiceVariants, guideFor } from '../lib/content';
import { getBookingCta, getServiceLinks } from '../lib/site';
import { describePricing } from '../lib/pricing/display';
import { byCountry, COUNTRIES, currencyOf, legalForm, type Country } from '../lib/country';
import { vatFor } from '../lib/vat';
import { FISCAL_CALENDARS, type CalendarCountry } from '../data/fiscal-calendar';
import YearCalendar from '../components/sections/YearCalendar.astro';

interface Props {
  entry: CollectionEntry<'servicios'>;
  related: CollectionEntry<'servicios'>[];
}
const { entry, related } = Astro.props;
const { t, lp, locale } = useI18n(Astro.currentLocale);
const bookingCta = getBookingCta(locale);
const d = entry.data;
const key = entryKey(entry);
/** Country-specific texts (servicios-pais); countries without their own version see the Swiss one. */
const variants = await getServiceVariants(entry, locale);
const textOf = (c: Country) => variants.find((v) => v.countries.includes(c))!.text;
const ccOf = (countries: Country[]) => (variants.length > 1 ? countries.join(' ') : undefined);
const titleHtml = byCountry((c) => textOf(c).title);
const titleVaries = new Set(variants.map((v) => v.text.title)).size > 1;
/** Breadcrumbs: the service's neutral name (the title may include a country's legal forms). */
const crumbLabel = getServiceLinks(locale).find((l) => l.key === key)?.label ?? d.title;
const relatedHtml = await Promise.all(
  related.map(async (r) => {
    const rv = await getServiceVariants(r, locale);
    const rt = (c: Country) => rv.find((v) => v.countries.includes(c))!.text;
    return {
      entry: r,
      title: byCountry((c) => rt(c).title),
      summary: byCountry((c) => rt(c).summary),
    };
  }),
);

const photos: Record<string, ImageMetadata> = {
  'contabilidad-y-cierres': contabilidad,
  'iva-y-fiscalidad': iva,
  'nominas-y-seguros-sociales': nominas,
  'constitucion-de-empresas': constitucion,
  'asesoria-para-startups': startups,
};
const photo = photos[key] ?? contabilidad;

/** The details may mention an amount: one variant per country (currency). */
const prices = d.pricing.map((p) => {
  const base = describePricing(p, locale);
  const detail = base.detail
    ? byCountry((c) => describePricing(p, locale, currencyOf(c)).detail ?? '')
    : undefined;
  const labelHtml =
    p.ref === 'gmbh' || p.ref === 'ag'
      ? byCountry((c) => legalForm(c, p.ref as 'gmbh' | 'ag'))
      : p.label;
  return { ...p, ...base, detail, labelHtml };
});
const mentionsVat = JSON.stringify(d).includes('MWST');

/* ── VAT service signature: each country's tax year (YearCalendar) ── */
const showYear = key === 'iva-y-fiscalidad';
/** Each country's calendar; those without their own see the Swiss one. */
const calendarOf = (c: Country): CalendarCountry =>
  c in FISCAL_CALENDARS ? (c as CalendarCountry) : 'CH';
const articles = showYear ? await getArticles(locale) : [];
const yearGroups = (['CH', 'ES', 'DE', 'FR', 'IT'] as const)
  .map((calendar) => ({
    calendar,
    countries: COUNTRIES.filter((c) => calendarOf(c) === calendar),
    guide: guideFor(articles, 'calendario', calendar),
  }))
  .filter((g) => g.countries.length);

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout title={d.seo.title} description={d.seo.description} overlayHeader>
  <!-- Header: the service in large type and its photo, which opens up on scroll -->
  <header class="nb-sx" data-surface="dark" data-service-hero>
    <div class="nb-container nb-sx__inner">
      <Breadcrumbs
        items={[
          { label: t('nav.services'), href: lp('/servicios') },
          { label: crumbLabel, html: byCountry((c) => vatFor(crumbLabel, c, locale)) },
        ]}
        tone="dark"
      />
      {titleVaries ? (
        <h1 class="nb-sx__title" data-reveal set:html={titleHtml} />
      ) : (
        <h1 class="nb-sx__title" data-split>
          {d.title}
        </h1>
      )}
      <div class="nb-sx__foot">
        <p class="nb-sx__lead" data-reveal set:html={byCountry((c) => textOf(c).summary)} />
        <div class="nb-sx__actions" data-reveal>
          <Button href={bookingCta.href} on="dark" arrow>
            {bookingCta.label}
          </Button>
          <Button variant="ghost" on="dark" href={lp('/calculadora')}>
            {t('services.detail.priceCalc')}
          </Button>
        </div>
      </div>
    </div>
    <div class="nb-container">
      <figure class="nb-sx__photo" data-sx-photo aria-hidden="true">
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          widths={[640, 800, 1024, 1440, 2048]}
          sizes="(min-width: 1360px) 1280px, 94vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          quality={68}
          class="nb-sx__img"
        />
      </figure>
    </div>
  </header>

  {showYear &&
    yearGroups.map((g) =>
      g.calendar === 'CH' ? (
        <YearCalendar
          calendar={g.calendar}
          countries={g.countries}
          guideHref={g.guide ? lp(`/recursos/${entryKey(g.guide)}`) : undefined}
        />
      ) : (
        <template data-year-template={g.countries.join(' ')}>
          <YearCalendar
            calendar={g.calendar}
            countries={g.countries}
            guideHref={g.guide ? lp(`/recursos/${entryKey(g.guide)}`) : undefined}
          />
        </template>
      ),
    )}
  {showYear && <script is:inline>
    // Other countries' calendars sit in <template> (inert: no styles, layout or animation).
    // Only the selected country's one is mounted, before the other scripts run; if the country changes
    // later, the new one comes in already in its final state (without the entrance animation).
    (() => {
      const root = document.documentElement;
      let late = false;
      // The Swiss calendar is rendered in the HTML (that is what shows without JS); for another country it also
      // moves into a <template> so it doesn't weigh on the page while hidden.
      const ch = document.querySelector('section[data-year][data-calendar="CH"]');
      if (ch && (root.dataset.country || 'CH') !== 'CH') {
        const tpl = document.createElement('template');
        tpl.dataset.yearTemplate = ch.dataset.cc || 'CH';
        ch.before(tpl);
        tpl.content.append(ch);
      }
      const mount = () => {
        const country = root.dataset.country || 'CH';
        document.querySelectorAll('template[data-year-template]').forEach((tpl) => {
          if (tpl.dataset.mounted || !tpl.dataset.yearTemplate.split(' ').includes(country)) return;
          const frag = tpl.content.cloneNode(true);
          if (late)
            frag
              .querySelectorAll(
                '[data-reveal], [data-yr-dot], [data-yr-span], [data-yr-alert], [data-yr-today]',
              )
              .forEach((el) => {
                el.style.opacity = '1';
                el.style.transform = 'none';
              });
          const section = frag.firstElementChild;
          tpl.after(frag);
          tpl.dataset.mounted = '1';
          if (late) document.dispatchEvent(new CustomEvent('nb:year-mounted', { detail: section }));
        });
        late = true;
      };
      mount();
      new MutationObserver(mount).observe(root, { attributeFilter: ['data-country'] });
    })();
  </script>}

  <!-- What's included: a ledger, one line per thing we do -->
  <section class="nb-scope" aria-labelledby="includes-title">
    <div class="nb-container nb-scope__grid">
      <div class="nb-scope__aside">
        <p class="nb-scope__eyebrow">{t('services.detail.labelScope')}</p>
        <h2 id="includes-title" class="nb-scope__title" data-split>
          {t('services.detail.includes')}
        </h2>
      </div>
      <div>
        {variants.map((v) => (
          <ul class="nb-incl" role="list" data-cc={ccOf(v.countries)}>
            {v.text.includes.map((item) => (
              <li class="nb-incl__row" data-incl-row>
                <span class="nb-incl__rule" data-incl-rule aria-hidden="true" />
                <span class="nb-incl__text">{item}</span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- Who it's for: three statements to recognise yourself in -->
  <section class="nb-who" aria-labelledby="who-title">
    <div class="nb-container">
      <div class="nb-who__head">
        <h2 id="who-title" class="nb-who__title" data-split>
          {t('services.detail.forWhom')}
        </h2>
        <p class="nb-who__lead" data-reveal>
          {t('services.detail.forWhomLead')}
        </p>
      </div>
      {variants.map((v) => (
        <ul class="nb-who__list" role="list" data-who data-cc={ccOf(v.countries)}>
          {v.text.forWhom.map((w) => (
            <li class="nb-who__item">
              <svg class="nb-who__mark" viewBox="4 11 40 26" aria-hidden="true">
                <path d="M4 13H44" />
                <path d="M10 37V29A14 14 0 0 1 38 29V37" />
              </svg>
              <p>{w}</p>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <!-- Process: crossing the bridge, one arch per step -->
  {variants.map((v, i) => (
    <ServiceProcess
      steps={v.text.process}
      label={t('services.detail.labelProcess')}
      title={t('services.detail.process')}
      countries={ccOf(v.countries)}
      uid={String(i)}
    />
  ))}

  <!-- Price: a receipt, with what it costs and what gets agreed afterwards -->
  <section class="nb-receipt-wrap" aria-labelledby="price-title">
    <div class="nb-container nb-receipt-wrap__grid">
      <div class="nb-receipt-wrap__text">
        <p class="nb-scope__eyebrow">{t('services.detail.labelPrice')}</p>
        <h2 id="price-title" class="nb-receipt-wrap__title" data-split>
          {t('services.detail.price')}
        </h2>
        <p class="nb-receipt-wrap__note" data-reveal>
          {prices.some((p) => p.mode === 'fixed')
            ? t('services.detail.priceFixedNote')
            : t('home.calculator.note')}
        </p>
        <div data-reveal>
          <Button variant="ghost" href={lp('/calculadora')} arrow>
            {t('services.detail.priceCalc')}
          </Button>
        </div>
      </div>
      <div class="nb-receipt" data-receipt>
        <div class="nb-receipt__head">
          <svg class="nb-receipt__mark" viewBox="4 11 40 26" aria-hidden="true">
            <path d="M4 13H44" />
            <path d="M10 37V29A14 14 0 0 1 38 29V37" />
          </svg>
          <span set:html={titleHtml} />
        </div>
        <ul class="nb-receipt__rows" role="list">
          {prices.map((p, i) => (
            <li class="nb-receipt__row">
              <div class="nb-receipt__line">
                {p.label !== d.title && <span class="nb-receipt__label" set:html={p.labelHtml} />}
                <span class="nb-receipt__value">
                  {p.amount ? (
                    <PriceTag amount={p.amount} once={p.once} firstVat={!mentionsVat && i === 0} />
                  ) : (
                    p.headline
                  )}
                </span>
              </div>
              {p.detail && <p class="nb-receipt__detail" set:html={p.detail} />}
            </li>
          ))}
        </ul>
        <p class="nb-receipt__foot">{t('services.detail.priceFixedNote')}</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="nb-sfaq" aria-labelledby="faq-title">
    <div class="nb-container nb-sfaq__grid">
      <div class="nb-sfaq__aside">
        <p class="nb-scope__eyebrow">{t('services.detail.labelFaq')}</p>
        <h2 id="faq-title" class="nb-sfaq__title" data-split>
          {t('services.detail.faq')}
        </h2>
      </div>
      <div>
        {variants.map((v) => (
          <div data-cc={ccOf(v.countries)}>
            <Accordion items={v.text.faq} level="h3" openFirst />
          </div>
        ))}
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </section>

  <!-- Related services, with their photos -->
  <section class="nb-rel" aria-labelledby="related-title">
    <div class="nb-container">
      <div class="nb-rel__head">
        <h2 id="related-title" class="nb-rel__title" data-split>
          {t('services.detail.related')}
        </h2>
        <a href={lp('/servicios')} class="nb-rel__all nb-tap">
          {t('services.detail.seeAll')}
          <Arrow size={18} />
        </a>
      </div>
      <ul class="nb-rel__list" role="list">
        {relatedHtml.map(({ entry: r, title, summary }) => (
          <li data-reveal>
            <a href={lp(`/servicios/${entryKey(r)}`)} class="nb-rel__card">
              <span class="nb-rel__media">
                <Picture
                  src={photos[entryKey(r)] ?? contabilidad}
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 768px) 46vw, 92vw"
                  alt=""
                  quality={72}
                  class="nb-rel__img"
                />
              </span>
              <span class="nb-rel__body">
                <span class="nb-rel__name" set:html={title} />
                <span class="nb-rel__summary" set:html={summary} />
              </span>
              <span class="nb-rel__arrow">
                <Arrow size={24} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style is:global>
  /* ── Header ── */
  .nb-sx {
    position: relative;
    background: var(--navy-800);
    color: var(--navy-100);
  }
  /* The navy goes halfway down the photo; the other half is already the page. */
  .nb-sx::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: clamp(120px, 18vw, 260px);
    background: var(--white);
  }
  .nb-sx__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 24px;
    padding-block: calc(var(--header-h) + 40px) clamp(40px, 5vw, 72px);
  }
  .nb-sx__title {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(3rem, 0.8rem + 7vw, 8.5rem);
    font-weight: 300;
    line-height: 0.94;
    letter-spacing: -0.04em;
    color: var(--white);
    text-wrap: balance;
  }
  .nb-sx__foot {
    display: grid;
    gap: 28px;
    padding-top: 28px;
    border-top: 1px solid rgb(255 255 255 / 0.22);
  }
  @media (min-width: 900px) {
    .nb-sx__foot {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
    }
    .nb-sx__actions {
      justify-self: end;
    }
  }
  .nb-sx__lead {
    margin: 0;
    max-width: 36rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1rem + 0.9vw, 1.875rem);
    font-weight: 300;
    line-height: 1.3;
    color: var(--white);
  }
  .nb-sx__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .nb-sx__photo {
    position: relative;
    z-index: 1;
    margin: 0;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: var(--radius-card, 8px);
    background: var(--navy-700);
  }
  @media (max-width: 767px) {
    .nb-sx__photo {
      aspect-ratio: 4 / 3;
    }
  }
  .nb-sx__photo picture {
    display: contents;
  }
  .nb-sx__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── What's included ── */
  .nb-scope {
    padding-block: var(--section-y);
    background: var(--piedra-50);
  }
  .nb-scope__grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1024px) {
    .nb-scope__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(48px, 6vw, 112px);
      align-items: start;
    }
    .nb-scope__aside {
      position: sticky;
      top: calc(var(--header-h) + 40px);
    }
  }
  .nb-scope__aside {
    display: grid;
    gap: 16px;
  }
  .nb-scope__title,
  .nb-receipt-wrap__title,
  .nb-sfaq__title,
  .nb-rel__title,
  .nb-who__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1rem + 3vw, 4rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--navy-800);
  }
  .nb-incl {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--navy-800);
  }
  .nb-incl__row {
    position: relative;
    padding-block: clamp(20px, 2.4vw, 30px);
  }
  .nb-incl__rule {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--navy-800);
    transform-origin: left center;
  }
  .nb-incl__text {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1rem + 0.9vw, 1.875rem);
    font-weight: 300;
    line-height: 1.25;
    color: var(--navy-800);
  }

  /* ── Who it's for ── */
  .nb-who {
    padding-block: var(--section-y);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-who .nb-who__title {
    color: var(--white);
  }
  .nb-who__head {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  @media (min-width: 900px) {
    .nb-who__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }
  }
  .nb-who__lead {
    margin: 0;
    max-width: 30rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .nb-who__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .nb-who__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .nb-who__item {
    display: grid;
    align-content: start;
    gap: 28px;
    padding: 32px 0;
    border-top: 1px solid var(--navy-600);
  }
  @media (min-width: 900px) {
    .nb-who__item {
      padding: 36px clamp(20px, 2.5vw, 40px) 8px;
      border-top: 0;
      border-left: 1px solid var(--navy-600);
    }
    .nb-who__item:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
  .nb-who__mark {
    width: 40px;
    height: 26px;
    fill: none;
    stroke: var(--salvia-300);
    stroke-width: 4;
  }
  .nb-who__item p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 1vw, 2rem);
    font-weight: 300;
    line-height: 1.25;
    color: var(--white);
  }

  /* ── Price ── */
  .nb-receipt-wrap {
    padding-block: var(--section-y);
    background: var(--piedra-100);
  }
  .nb-receipt-wrap__grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .nb-receipt-wrap__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(48px, 6vw, 112px);
    }
  }
  .nb-receipt-wrap__text {
    display: grid;
    justify-items: start;
    gap: 20px;
  }
  .nb-receipt-wrap__note {
    margin: 0;
    max-width: 30rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--piedra-800);
  }
  .nb-receipt {
    display: grid;
    gap: 24px;
    padding: clamp(24px, 4vw, 48px);
    border-radius: var(--radius-card, 8px);
    background: var(--white);
    box-shadow: 0 1px 2px rgb(21 39 66 / 0.06);
  }
  .nb-receipt__head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 20px;
    border-bottom: 1.5px solid var(--navy-800);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy-800);
  }
  .nb-receipt__mark {
    width: 31px;
    height: 20px;
    fill: none;
    stroke: var(--navy-800);
    stroke-width: 4;
  }
  .nb-receipt__rows {
    display: grid;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Label on top, amount below: any text fits, including "Included from Essential". */
  .nb-receipt__line {
    display: grid;
    gap: 6px;
  }
  .nb-receipt__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--piedra-600);
  }
  .nb-receipt__value {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 1.2vw, 2.5rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--navy-800);
  }
  .nb-receipt__row + .nb-receipt__row {
    padding-top: 22px;
    border-top: 1px dashed var(--piedra-300);
  }
  .nb-receipt__detail {
    margin: 8px 0 0;
    font-size: 0.875rem;
