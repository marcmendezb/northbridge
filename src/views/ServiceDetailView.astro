---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Button from '../components/ui/Button.astro';
import PriceTag from '../components/ui/PriceTag.astro';
import Accordion from '../components/ui/Accordion.astro';
import Icon from '../components/brand/Icon.astro';
import Arrow from '../components/brand/Arrow.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import contabilidad from '../assets/img/services/contabilidad.jpeg';
import iva from '../assets/img/services/iva.jpeg';
import nominas from '../assets/img/services/nominas.jpeg';
import constitucion from '../assets/img/services/constitucion.jpeg';
import startups from '../assets/img/services/startup.jpeg';
import { useI18n, type Messages } from '../i18n';
import { entryKey, getArticles, getServices, guideFor } from '../lib/content';
import { getBookingCta } from '../lib/site';
import { describePricing } from '../lib/pricing/display';
import { byCountry, currencyOf } from '../lib/country';
import { FISCAL_CALENDARS } from '../data/fiscal-calendar';

interface Props {
  entry: CollectionEntry<'servicios'>;
  related: CollectionEntry<'servicios'>[];
}
const { entry, related } = Astro.props;
const { t, tRaw, lp, locale } = useI18n(Astro.currentLocale);
const bookingCta = getBookingCta(locale);
const d = entry.data;
const key = entryKey(entry);
const all = await getServices(locale);
const index = all.findIndex((s) => entryKey(s) === key) + 1;
const two = (n: number) => String(n).padStart(2, '0');

const photos: Record<string, ImageMetadata> = {
  'contabilidad-y-cierres': contabilidad,
  'iva-y-fiscalidad': iva,
  'nominas-y-seguros-sociales': nominas,
  'constitucion-de-empresas': constitucion,
  'asesoria-para-startups': startups,
};
const photo = photos[key] ?? contabilidad;

/** El detalle puede citar un importe: una variante por país (moneda). */
const prices = d.pricing.map((p) => {
  const base = describePricing(p, locale);
  const detail = base.detail
    ? byCountry((c) => describePricing(p, locale, currencyOf(c)).detail ?? '')
    : undefined;
  return { ...p, ...base, detail };
});
const mentionsVat = JSON.stringify(d).includes('MWST');

/* ── Firma del servicio de IVA: el año fiscal como una regla, con cada plazo en su mes ── */
const y = tRaw<Messages['services']['detail']['year']>('services.detail.year');
const showYear = key === 'iva-y-fiscalidad';
type Cat = 'vat' | 'tax' | 'payroll';
const catOf = (id: string): Cat =>
  id.startsWith('vat')
    ? 'vat'
    : id.startsWith('ahv') || id.startsWith('salary')
      ? 'payroll'
      : 'tax';
const events = (FISCAL_CALENDARS.CH ?? []).map((e) => ({
  id: e.id,
  month: e.month,
  cat: catOf(e.id),
  when: e.when[locale],
  what: e.what[locale],
  need: e.need[locale],
}));
const monthName = (m: number, month: 'short' | 'long') =>
  new Intl.DateTimeFormat(locale, { month, timeZone: 'UTC' })
    .format(new Date(Date.UTC(2026, m - 1, 15)))
    .replace('.', '');
const months = Array.from({ length: 12 }, (_, i) => ({
  n: i + 1,
  short: monthName(i + 1, 'short'),
  long: monthName(i + 1, 'long'),
  events: events.filter((e) => e.month === i + 1),
}));
/** Posición en la regla (0–100 %): el plazo, en el centro de su mes; varios en un mes, en columna. */
const at = (month: number) => ((month - 0.5) / 12) * 100;
const alertAt = (month: number) => ((month - 0.5 - 1 / 3) / 12) * 100;
const articles = showYear ? await getArticles(locale) : [];
const guide = guideFor(articles, 'calendario', 'CH');

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout title={d.seo.title} description={d.seo.description} overlayHeader>
  <!-- 1 · Cabecera: el servicio en grande y su foto, que se abre al bajar -->
  <header class="nb-sx" data-surface="dark" data-service-hero>
    <div class="nb-container nb-sx__inner">
      <Breadcrumbs
        items={[{ label: t('nav.services'), href: lp('/servicios') }, { label: d.title }]}
        tone="dark"
      />
      <p class="nb-sx__index" data-reveal>
        <Icon name={d.icon} size={28} />
        <span>{t('services.detail.index', { n: two(index), total: two(all.length) })}</span>
      </p>
      <h1 class="nb-sx__title" data-split>
        {d.title}
      </h1>
      <div class="nb-sx__foot">
        <p class="nb-sx__lead" data-reveal>
          {d.summary}
        </p>
        <div class="nb-sx__actions" data-reveal>
          <Button href={bookingCta.href} on="dark" arrow>
            {bookingCta.label}
          </Button>
          <Button variant="ghost" on="dark" href={lp('/calculadora')}>
            {t('services.detail.priceCalc')}
          </Button>
        </div>
      </div>
    </div>
    <div class="nb-container">
      <figure class="nb-sx__photo" data-sx-photo aria-hidden="true">
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          widths={[640, 1024, 1440, 2048]}
          sizes="(min-width: 1360px) 1280px, 94vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          quality={74}
          class="nb-sx__img"
        />
      </figure>
    </div>
  </header>

  {showYear && (
    <section class="nb-yr" aria-labelledby="year-title" data-year>
      <div class="nb-container">
        <div class="nb-yr__head">
          <div class="nb-yr__intro">
            <p class="nb-yr__eyebrow">{y.label}</p>
            <h2 id="year-title" class="nb-yr__title" data-split>
              {y.title}
            </h2>
            <p class="nb-yr__lead" data-reveal>
              {y.lead}
            </p>
          </div>
          <aside class="nb-yr__next" data-yr-next hidden aria-live="polite">
            <p class="nb-yr__next-label">{y.next}</p>
            <p class="nb-yr__next-month" data-yr-next-month />
            <p class="nb-yr__next-what" data-yr-next-what />
            <p class="nb-yr__next-when" data-yr-next-when />
            <p class="nb-yr__next-need">
              <span>{y.need}</span>
              <span data-yr-next-need />
            </p>
          </aside>
        </div>

        <div
          class="nb-yr__ruler"
          data-yr-ruler
          role="img"
          aria-label={t('services.detail.year.ruler', { count: events.length })}
        >
          <span class="nb-yr__line" data-yr-line />
          {months.map((m) => (
            <span class="nb-yr__tick" style={`--at:${((m.n - 1) / 12) * 100}%`} />
          ))}
          {events.map((e) => (
            <span class="nb-yr__alert" data-yr-alert style={`--at:${alertAt(e.month)}%`} />
          ))}
          {months.map((m) =>
            m.events.map((e, i) => (
              <span
                class:list={['nb-yr__dot', `nb-yr__dot--${e.cat}`]}
                data-yr-dot
                data-id={e.id}
                data-month={e.month}
                style={`--at:${at(e.month)}%;--row:${i}`}
              />
            )),
          )}
          <span class="nb-yr__today" data-yr-today hidden>
            <span>{y.today}</span>
          </span>
          <ol class="nb-yr__months" role="list" aria-hidden="true">
            {months.map((m) => (
              <li data-month-label={m.n}>{m.short}</li>
            ))}
          </ol>
        </div>

        <ul class="nb-yr__legend" role="list">
          {(['vat', 'tax', 'payroll'] as const).map((c) => (
            <li>
              <span class:list={['nb-yr__dot', 'nb-yr__dot--static', `nb-yr__dot--${c}`]} />
              {y.cats[c]}
            </li>
          ))}
          <li>
            <span class="nb-yr__alert nb-yr__alert--static" />
            {y.alert}
          </li>
        </ul>

        <ol class="nb-yr__list" role="list">
          {months
            .filter((m) => m.events.length)
            .map((m) => (
              <li class="nb-yr__month" data-reveal>
                <h3 class="nb-yr__month-name">{m.long}</h3>
                <ul class="nb-yr__events" role="list">
                  {m.events.map((e) => (
                    <li
                      class="nb-yr__event"
                      id={`plazo-${e.id}`}
                      data-yr-event={e.id}
                      data-month={e.month}
                      data-month-name={m.long}
                    >
                      <span class:list={['nb-yr__cat', `nb-yr__cat--${e.cat}`]}>
                        {y.cats[e.cat]}
                      </span>
                      <p class="nb-yr__what">{e.what}</p>
                      <p class="nb-yr__when">{e.when}</p>
                      <p class="nb-yr__need">{e.need}</p>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
        </ol>

        <div class="nb-yr__foot">
          <p>{y.note}</p>
          {guide && (
            <a href={lp(`/recursos/${entryKey(guide)}`)} class="nb-yr__guide">
              {y.guide}
              <Arrow size={18} />
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- 2 · Qué incluye: un libro mayor, una línea por cosa que hacemos -->
  <section class="nb-scope" aria-labelledby="includes-title">
    <div class="nb-container nb-scope__grid">
      <div class="nb-scope__aside">
        <p class="nb-scope__eyebrow">{t('services.detail.labelScope')}</p>
        <h2 id="includes-title" class="nb-scope__title" data-split>
          {t('services.detail.includes')}
        </h2>
        <p class="nb-scope__count" aria-hidden="true">
          {two(d.includes.length)}
        </p>
      </div>
      <ol class="nb-incl" role="list">
        {d.includes.map((item, i) => (
          <li class="nb-incl__row" data-incl-row>
            <span class="nb-incl__rule" data-incl-rule aria-hidden="true" />
            <span class="nb-incl__n" aria-hidden="true">
              {two(i + 1)}
            </span>
            <span class="nb-incl__text">{item}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3 · Para quién: tres frases en las que reconocerse -->
  <section class="nb-who" aria-labelledby="who-title">
    <div class="nb-container">
      <div class="nb-who__head">
        <h2 id="who-title" class="nb-who__title" data-split>
          {t('services.detail.forWhom')}
        </h2>
        <p class="nb-who__lead" data-reveal>
          {t('services.detail.forWhomLead')}
        </p>
      </div>
      <ul class="nb-who__list" role="list" data-who>
        {d.forWhom.map((w) => (
          <li class="nb-who__item">
            <svg class="nb-who__mark" viewBox="4 11 40 26" aria-hidden="true">
              <path d="M4 13H44" />
              <path d="M10 37V29A14 14 0 0 1 38 29V37" />
            </svg>
            <p>{w}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 · Proceso: el viaducto de la marca, un arco por paso -->
  <section class="nb-proc" aria-labelledby="process-title">
    <div class="nb-container">
      <p class="nb-scope__eyebrow">{t('services.detail.labelProcess')}</p>
      <h2 id="process-title" class="nb-proc__title" data-split>
        {t('services.detail.process')}
      </h2>
      <ProcessSteps steps={d.process} />
    </div>
  </section>

  <!-- 5 · Precio: un recibo, con lo que cuesta y lo que se cierra después -->
  <section class="nb-receipt-wrap" aria-labelledby="price-title">
    <div class="nb-container nb-receipt-wrap__grid">
      <div class="nb-receipt-wrap__text">
        <p class="nb-scope__eyebrow">{t('services.detail.labelPrice')}</p>
        <h2 id="price-title" class="nb-receipt-wrap__title" data-split>
          {t('services.detail.price')}
        </h2>
        <p class="nb-receipt-wrap__note" data-reveal>
          {prices.some((p) => p.mode === 'fixed')
            ? t('services.detail.priceFixedNote')
            : t('home.calculator.note')}
        </p>
        <div data-reveal>
          <Button variant="ghost" href={lp('/calculadora')} arrow>
            {t('services.detail.priceCalc')}
          </Button>
        </div>
      </div>
      <div class="nb-receipt" data-receipt>
        <div class="nb-receipt__head">
          <svg class="nb-receipt__mark" viewBox="4 11 40 26" aria-hidden="true">
            <path d="M4 13H44" />
            <path d="M10 37V29A14 14 0 0 1 38 29V37" />
          </svg>
          <span>{d.title}</span>
        </div>
        <ul class="nb-receipt__rows" role="list">
          {prices.map((p, i) => (
            <li class="nb-receipt__row">
              <div class="nb-receipt__line">
                {p.label !== d.title && <span class="nb-receipt__label">{p.label}</span>}
                <span class="nb-receipt__value">
                  {p.amount ? (
                    <PriceTag amount={p.amount} once={p.once} firstVat={!mentionsVat && i === 0} />
                  ) : (
                    p.headline
                  )}
                </span>
              </div>
              {p.detail && <p class="nb-receipt__detail" set:html={p.detail} />}
            </li>
          ))}
        </ul>
        <p class="nb-receipt__foot">{t('services.detail.priceFixedNote')}</p>
      </div>
    </div>
  </section>

  <!-- 6 · Preguntas -->
  <section class="nb-sfaq" aria-labelledby="faq-title">
    <div class="nb-container nb-sfaq__grid">
      <div class="nb-sfaq__aside">
        <p class="nb-scope__eyebrow">{t('services.detail.labelFaq')}</p>
        <h2 id="faq-title" class="nb-sfaq__title" data-split>
          {t('services.detail.faq')}
        </h2>
      </div>
      <Accordion items={d.faq} level="h3" openFirst />
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </section>

  <!-- 7 · Relacionados: con su foto -->
  <section class="nb-rel" aria-labelledby="related-title">
    <div class="nb-container">
      <div class="nb-rel__head">
        <h2 id="related-title" class="nb-rel__title" data-split>
          {t('services.detail.related')}
        </h2>
        <a href={lp('/servicios')} class="nb-rel__all">
          {t('services.detail.seeAll')}
          <Arrow size={18} />
        </a>
      </div>
      <ul class="nb-rel__list" role="list">
        {related.map((r) => (
          <li data-reveal>
            <a href={lp(`/servicios/${entryKey(r)}`)} class="nb-rel__card">
              <span class="nb-rel__media">
                <Picture
                  src={photos[entryKey(r)] ?? contabilidad}
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 768px) 46vw, 92vw"
                  alt=""
                  quality={72}
                  class="nb-rel__img"
                />
              </span>
              <span class="nb-rel__body">
                <span class="nb-rel__name">{r.data.title}</span>
                <span class="nb-rel__summary">{r.data.summary}</span>
              </span>
              <span class="nb-rel__arrow">
                <Arrow size={24} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  import { zurichNow } from '../lib/contact/office';

  // Hoy en la regla del año y el próximo plazo (por mes, en hora de Zúrich). Sin JS, solo la lista.
  const ruler = document.querySelector<HTMLElement>('[data-yr-ruler]');
  if (ruler) {
    const z = zurichNow(new Date());
    const days = new Date(Date.UTC(z.y, z.m, 0)).getUTCDate();
    const today = ruler.querySelector<HTMLElement>('[data-yr-today]');
    if (today) {
      today.style.setProperty('--at', `${((z.m - 1 + (z.d - 1) / days) / 12) * 100}%`);
      today.hidden = false;
    }
    ruler.querySelector(`[data-month-label="${z.m}"]`)?.classList.add('is-now');

    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-yr-event]'));
    const next = rows.find((r) => Number(r.dataset.month) >= z.m) ?? rows[0];
    const panel = document.querySelector<HTMLElement>('[data-yr-next]');
    if (next && panel) {
      const text = (sel: string) => next.querySelector(sel)?.textContent ?? '';
      const set = (sel: string, value: string) => {
        const el = panel.querySelector(sel);
        if (el) el.textContent = value;
      };
      set('[data-yr-next-month]', next.dataset.monthName ?? '');
      set('[data-yr-next-what]', text('.nb-yr__what'));
      set('[data-yr-next-when]', text('.nb-yr__when'));
      set('[data-yr-next-need]', text('.nb-yr__need'));
      panel.hidden = false;
      // La ficha cambia la altura de la página: las escenas de scroll vuelven a medir.
      window.dispatchEvent(new Event('resize'));
      next.classList.add('is-next');
      ruler
        .querySelector(`[data-yr-dot][data-id="${next.dataset.yrEvent}"]`)
        ?.classList.add('is-next');
    }
  }
</script>

<style is:global>
  /* ── 1 · Cabecera ── */
  .nb-sx {
    position: relative;
    background: var(--navy-800);
    color: var(--navy-100);
  }
  /* El navy baja hasta la mitad de la foto; la otra mitad ya es la página. */
  .nb-sx::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: clamp(120px, 18vw, 260px);
    background: var(--white);
  }
  .nb-sx__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 24px;
    padding-block: calc(var(--header-h) + 40px) clamp(40px, 5vw, 72px);
  }
  .nb-sx__index {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 8px 0 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-300);
  }
  .nb-sx__index svg {
    color: var(--white);
  }
  .nb-sx__title {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(3rem, 0.8rem + 7vw, 8.5rem);
    font-weight: 300;
    line-height: 0.94;
    letter-spacing: -0.04em;
    color: var(--white);
    text-wrap: balance;
  }
  .nb-sx__foot {
    display: grid;
    gap: 28px;
    padding-top: 28px;
    border-top: 1px solid rgb(255 255 255 / 0.22);
  }
  @media (min-width: 900px) {
    .nb-sx__foot {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
    }
    .nb-sx__actions {
      justify-self: end;
    }
  }
  .nb-sx__lead {
    margin: 0;
    max-width: 36rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1rem + 0.9vw, 1.875rem);
    font-weight: 300;
    line-height: 1.3;
    color: var(--white);
  }
  .nb-sx__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .nb-sx__photo {
    position: relative;
    z-index: 1;
    margin: 0;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: var(--radius-card, 8px);
    background: var(--navy-700);
  }
  @media (max-width: 767px) {
    .nb-sx__photo {
      aspect-ratio: 4 / 3;
    }
  }
  .nb-sx__photo picture {
    display: contents;
  }
  .nb-sx__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── IVA · El año fiscal ── */
  .nb-yr {
    padding-block: var(--section-y);
    background: var(--white);
  }
  .nb-yr__head {
    display: grid;
    gap: 40px;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .nb-yr__head {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: clamp(48px, 6vw, 112px);
    }
  }
  .nb-yr__intro {
    display: grid;
    gap: 20px;
  }
  .nb-yr__eyebrow,
  .nb-scope__eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-600);
  }
  .nb-yr__title {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1rem + 4vw, 5.25rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--navy-800);
  }
  .nb-yr__lead {
    margin: 0;
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--piedra-800);
  }
  /* Próximo plazo: ficha navy, la única pieza oscura de la sección. */
  .nb-yr__next {
    display: grid;
    gap: 8px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-card, 8px);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-yr__next[hidden] {
    display: none;
  }
  .nb-yr__next p {
    margin: 0;
  }
  .nb-yr__next-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-300);
  }
  .nb-yr__next-month {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.5rem + 2vw, 3.5rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1;
    text-transform: capitalize;
    color: var(--white);
  }
  .nb-yr__next-what {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--white);
  }
  .nb-yr__next-when {
    font-size: 0.9375rem;
  }
  .nb-yr__next-need {
