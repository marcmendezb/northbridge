---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ServicesTeaser from '../components/sections/ServicesTeaser.astro';
import Stats from '../components/sections/Stats.astro';
import Process from '../components/sections/Process.astro';
import CalculatorTeaser from '../components/sections/CalculatorTeaser.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { useI18n } from '../i18n';
import { organizationJsonLd } from '../lib/seo';
import { site } from '../lib/site';
const { t, locale } = useI18n(Astro.currentLocale);
---

<BaseLayout
  description={t('home.seoDescription')}
  overlayHeader
  jsonLd={organizationJsonLd(locale, Astro.site ?? site.url)}
>
  <Hero />
  <ServicesTeaser />
  <Stats />
  <Process />
  <CalculatorTeaser />
  <Testimonials />
  <FinalCta />
</BaseLayout>
