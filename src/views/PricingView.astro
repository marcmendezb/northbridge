---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Section from '../components/ui/Section.astro';
import Tag from '../components/ui/Tag.astro';
import Button from '../components/ui/Button.astro';
import PriceTag from '../components/ui/PriceTag.astro';
import Accordion from '../components/ui/Accordion.astro';
import ComparisonCell from '../components/ui/ComparisonCell.astro';
import CalculatorTeaser from '../components/sections/CalculatorTeaser.astro';
import ProposalCta from '../components/sections/ProposalCta.astro';
import Arrow from '../components/brand/Arrow.astro';
import { useI18n, type MessageKey } from '../i18n';
import { getBookingCta } from '../lib/site';
import { byCountry, currencyOf, legalForm } from '../lib/country';
import { vatFor } from '../lib/vat';
import { formatMoney } from '../lib/pricing/currency';
import {
  COMPARISON,
  FIXED_PRICES,
  PACKAGES,
  SEPARATE_QUOTE,
  type ComparisonRow,
  type PackageId,
} from '../lib/pricing/config';

const { t, tRaw, lp, locale } = useI18n(Astro.currentLocale);
const bookingCta = getBookingCta(locale);
const ids = Object.keys(PACKAGES) as PackageId[];
const rowLabel = (id: string) => t(`pricing.rows.${id}` as MessageKey);
const cellText = (c: ComparisonRow[PackageId]) =>
  typeof c === 'object' ? t(`pricing.cells.${'note' in c ? c.note : c.text}` as MessageKey) : '';
/** En alemán los sustantivos van en mayúscula: no se fuerza la minúscula tras los dos puntos. */
const lowerFirst = (s: string) =>
  locale === 'de' ? s : `${s.charAt(0).toLowerCase()}${s.slice(1)}`;
/** Lo que incluye cada paquete, tomado de la tabla comparativa. */
const highlights = (id: PackageId) =>
  COMPARISON.filter((r) => r[id] !== false).map((r) => {
    const note = cellText(r[id]);
    return note ? `${rowLabel(r.id)}: ${lowerFirst(note)}` : rowLabel(r.id);
  });
const forWhom = (id: PackageId) =>
  byCountry((c) => t(`pricing.packages.${id}.forWhom` as MessageKey, { ag: legalForm(c, 'ag') }));

/** Grupos de la comparativa (las filas salen de config.ts). */
const groups: { key: string; rows: ComparisonRow['id'][] }[] = [
  { key: 'books', rows: ['accounting', 'vat', 'report'] },
  { key: 'team', rows: ['payroll'] },
  { key: 'support', rows: ['contact', 'meeting', 'taxPlanning', 'taxRequests'] },
  { key: 'startups', rows: ['capTable', 'valuation'] },
];
const rowById = Object.fromEntries(COMPARISON.map((r) => [r.id, r])) as Record<
  ComparisonRow['id'],
  ComparisonRow
>;

/** Perfil → paquete que le encaja (las mismas reglas que la calculadora, simplificadas). */
const profiles = [
  { key: 'autonomo', pkg: 'essential' },
  { key: 'startup', pkg: 'growth' },
  { key: 'pyme', pkg: 'growth' },
  { key: 'estructura', pkg: 'full' },
] as const;

const separate = SEPARATE_QUOTE.map((key) => ({
  key,
  label: t(`pricing.separate.${key}` as MessageKey),
  price:
    key === 'constitution'
      ? byCountry((c) =>
          t('pricing.separateConstitution', {
            gmbhName: legalForm(c, 'gmbh'),
            agName: legalForm(c, 'ag'),
            gmbh: formatMoney(FIXED_PRICES.gmbh.from, currencyOf(c), locale),
            ag: formatMoney(FIXED_PRICES.ag.from, currencyOf(c), locale),
          }),
        )
      : t('pricing.separateFixed'),
}));
const facts = tRaw<string[]>('pricing.facts');
const guarantees = tRaw<{ title: string; text: string }[]>('pricing.guarantees');
const faq = tRaw<{ q: string; a: string }[]>('pricing.faq');
---

<BaseLayout title={t('pricing.seoTitle')} description={t('pricing.seoDescription')} overlayHeader>
  <header class="nb-ph" data-surface="dark" data-pricing>
    <div class="nb-container nb-ph__inner">
      <Breadcrumbs items={[{ label: t('pricing.title') }]} tone="dark" />
      <h1 class="nb-ph__title" data-split data-pr-drift>
        {t('pricing.heroTitle')}
      </h1>
      <div class="nb-ph__aside" data-reveal>
        <p class="nb-ph__lead">{t('pricing.heroLead')}</p>
        <ul class="nb-ph__facts" data-pr-stagger>
          {facts.map((f) => (
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M2.5 8.5l3.5 3.5 7.5-8" pathLength="1" data-pr-check />
              </svg>
              <Fragment set:html={byCountry((c) => vatFor(f, c, locale))} />
            </li>
          ))}
        </ul>
        <div class="nb-ph__actions">
          <Button href={lp('/calculadora')} on="dark" arrow>
            {t('cta.calculate')}
          </Button>
          <Button href="#comparativa" variant="ghost" on="dark">
            {t('pricing.compareCta')}
          </Button>
        </div>
      </div>
    </div>
  </header>

  <section class="nb-pk-sec" aria-labelledby="packages-title">
    <div class="nb-container">
      <h2 id="packages-title" class="sr-only">
        {t('pricing.compareTitle')}
      </h2>
      <div class="nb-chooser" data-chooser>
        <p class="nb-chooser__title" id="chooser-title">
          {t('pricing.chooserTitle')}
        </p>
        <div class="nb-chooser__chips" role="group" aria-labelledby="chooser-title" data-pr-stagger>
          {profiles.map((p) => (
            <button type="button" class="nb-chooser__chip" aria-pressed="false" data-pick={p.pkg}>
              {t(`pricing.chooser.${p.key}` as MessageKey)}
            </button>
          ))}
        </div>
      </div>

      <div class="nb-deck" data-price-deck>
        <span class="nb-deck__line" aria-hidden="true" data-deck-line></span>
        <ul class="nb-pk">
          {ids.map((id) => {
            const p = PACKAGES[id];
            return (
              <li
                class:list={['nb-pk__item', p.recommended && 'nb-pk__item--featured']}
                data-pkg={id}
                data-deck-card
              >
                <span class="nb-pk__pillar" aria-hidden="true" data-deck-pillar />
                <article class="nb-pk__card" aria-labelledby={`pkg-${id}`}>
                  <div class="nb-pk__head">
                    <h3 class="nb-pk__name" id={`pkg-${id}`}>
                      {p.name}
                    </h3>
                    {p.recommended && (
                      <Tag tone="salvia" class="nb-pk__rec">
                        {t('pricing.recommended')}
                      </Tag>
                    )}
                    <span class="nb-pk__fits">{t('pricing.fits')}</span>
                  </div>
                  <p class="nb-pk__for">
                    <span class="nb-pk__for-label">{t('pricing.forWhom')}</span>
                    <Fragment set:html={forWhom(id)} />
                  </p>
                  <PriceTag amount={p.from} size="lg" hideVatNote class="nb-pk__price" />
                  <p class="nb-pk__inc-title">{t('pricing.includes')}</p>
                  <ul class="nb-pk__inc" data-pr-stagger>
                    {highlights(id).map((h) => (
                      <li>
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                          <path d="M2.5 8.5l3.5 3.5 7.5-8" pathLength="1" data-pr-check />
                        </svg>
                        <Fragment set:html={byCountry((c) => vatFor(h, c, locale))} />
                      </li>
                    ))}
                  </ul>
                  <a href={bookingCta.href} class="nb-pk__cta">
                    <span>{bookingCta.label}</span>
                    <Arrow />
                  </a>
                </article>
              </li>
            );
          })}
        </ul>
      </div>
      <p
        class="nb-pk__vat"
        set:html={byCountry((c) => vatFor(t('price.vatNoteFirst'), c, locale))}
      />
    </div>
  </section>

  <Section
    tone="piedra"
    label={t('pricing.compareLabel')}
    title={t('pricing.compareTitle')}
    id="comparativa"
  >
    <div class="nb-cmp-wrap">
      <table class="nb-cmp">
        <caption class="sr-only">{t('pricing.compareCaption')}</caption>
        <thead>
          <tr>
            <th scope="col" class="nb-cmp__corner">
              <span class="sr-only">{t('pricing.feature')}</span>
            </th>
            {ids.map((id) => (
              <th
                scope="col"
                class:list={['nb-cmp__pkg', PACKAGES[id].recommended && 'nb-cmp__pkg--featured']}
              >
                <span class="nb-cmp__pkg-name">{PACKAGES[id].name}</span>
                <PriceTag amount={PACKAGES[id].from} hideVatNote class="nb-cmp__price" />
              </th>
            ))}
          </tr>
        </thead>
        {groups.map((g) => (
          <tbody data-pr-stagger>
            <tr class="nb-cmp__group">
              <th scope="colgroup" colspan={ids.length + 1}>
                {t(`pricing.groups.${g.key}` as MessageKey)}
              </th>
            </tr>
            {g.rows.map((rid) => (
              <tr>
                <th scope="row" set:html={byCountry((c) => vatFor(rowLabel(rid), c, locale))} />
                {ids.map((id) => (
                  <td class:list={[PACKAGES[id].recommended && 'nb-cmp__cell--featured']}>
                    <ComparisonCell cell={rowById[rid][id]} />
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
    <p class="nb-cmp__note">{t('price.vatNote')}</p>
  </Section>

  <Section label={t('pricing.guaranteesLabel')} title={t('pricing.guaranteesTitle')}>
    <ul class="nb-guar">
      {guarantees.map((g) => (
        <li data-reveal class="nb-guar__item">
          <svg class="nb-guar__mark" viewBox="4 11 40 26" aria-hidden="true" data-pr-draw>
            <path d="M4 13H44" pathLength="1" />
            <path d="M10 37V29A14 14 0 0 1 38 29V37" pathLength="1" />
          </svg>
          <h3 class="nb-guar__title">{g.title}</h3>
          <p class="nb-guar__text">{g.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section
    tone="piedra"
    label={t('pricing.separateLabel')}
    title={t('pricing.separateTitle')}
    lead={t('pricing.separateLead')}
  >
    <dl class="nb-ledger">
      {separate.map((s) => (
        <div class="nb-ledger__row" data-pr-row>
          <span class="nb-ledger__rule" aria-hidden="true" data-pr-rule></span>
          <dt>{s.label}</dt>
          <dd set:html={s.price} />
        </div>
      ))}
    </dl>
  </Section>

  <CalculatorTeaser />

  <Section tone="piedra" label={t('pricing.faqLabel')}>
    <div class="nb-pfaq">
      <h2 class="m-0">{t('pricing.faqTitle')}</h2>
      <Accordion items={faq} level="h3" openFirst />
    </div>
  </Section>

  <ProposalCta />
</BaseLayout>

<style is:global>
  /* ── Cabecera navy ── */
  .nb-ph {
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-ph__inner {
    display: grid;
    gap: 32px;
    /* El fondo navy sube por detrás del header flotante, como en el hero de la Home. */
    padding-block: calc(var(--header-h) + clamp(40px, 6vw, 88px)) clamp(56px, 8vw, 120px);
  }
  @media (min-width: 1024px) {
    .nb-ph__inner {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: end;
      column-gap: 80px;
    }
    .nb-ph__inner > nav {
      grid-column: 1 / -1;
    }
  }
  .nb-ph__title {
    margin: 0;
    max-width: 13ch;
    font-size: clamp(2.75rem, 1rem + 5.4vw, 6.25rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--white);
  }
  .nb-ph__aside {
    display: grid;
    gap: 24px;
  }
  .nb-ph__lead {
    margin: 0;
    font-size: 1.1875rem;
    line-height: 1.55;
  }
  .nb-ph__facts {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 20px 0 0;
    list-style: none;
    border-top: 1px solid var(--navy-600);
    font-weight: 600;
    color: var(--white);
  }
  .nb-ph__facts li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nb-ph__facts svg {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: var(--salvia-300);
    stroke-width: 1.5;
  }
  .nb-ph__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  /* ── Paquetes colgados del tablero (el viaducto de la marca) ── */
  .nb-pk-sec {
    padding-block: clamp(40px, 6vw, 80px) var(--section-y);
    background: var(--white);
  }
  .nb-chooser {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .js .nb-chooser {
    display: flex;
  }
  .nb-chooser__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: var(--navy-800);
  }
  .nb-chooser__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .nb-chooser__chip {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--piedra-300);
    border-radius: var(--radius-button, 4px);
    background: var(--white);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--navy-800);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .nb-chooser__chip:hover {
    border-color: var(--navy-800);
  }
  .nb-chooser__chip[aria-pressed='true'] {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--white);
  }
  .nb-chooser__chip:focus-visible {
    outline: 2px solid var(--navy-600);
    outline-offset: 3px;
  }

  .nb-deck {
    position: relative;
  }
  /* Tablero: filete navy de 1,5 px del que cuelgan los paquetes. */
  .nb-deck__line {
    position: absolute;
    inset: 0 0 auto;
    height: 1.5px;
    background: var(--navy-800);
    transform-origin: left;
  }
  .nb-pk {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 1024px) {
    .nb-pk {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
  }
  .nb-pk__item {
    display: grid;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .nb-pk__pillar {
    justify-self: center;
    width: 1.5px;
    height: 32px;
    background: var(--navy-800);
    transform-origin: top;
  }
  /* El destacado cuelga más arriba, con el pilar corto, y llega más abajo: el centro del arco. */
  @media (min-width: 1024px) {
    .nb-pk__pillar {
      height: 56px;
    }
    .nb-pk__item--featured .nb-pk__pillar {
      height: 24px;
    }
  }
  .nb-pk__card {
    display: grid;
    align-content: start;
    gap: 20px;
    padding: clamp(28px, 3vw, 40px);
    border: 1px solid var(--piedra-200);
    border-radius: var(--radius-card, 8px);
    background: var(--white);
    color: var(--navy-800);
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }
  .nb-pk__item:hover .nb-pk__card {
    border-color: var(--navy-800);
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__card {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  @media (min-width: 1024px) {
    .nb-pk__item--featured .nb-pk__card {
      padding-bottom: calc(clamp(28px, 3vw, 40px) + 32px);
    }
  }
  .nb-pk__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    min-height: 2.75rem;
  }
  .nb-pk__name {
    margin: 0;
    font-size: clamp(1.75rem, 1rem + 1.4vw, 2.25rem);
    font-weight: 400;
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__name {
    color: var(--white);
  }
  .nb-pk__fits {
    display: none;
    padding: 4px 8px;
    border-radius: var(--radius-tag, 2px);
    background: var(--salvia-400);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy-800);
  }
  .nb-pk__for {
    min-height: 4.6em;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--piedra-700);
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__for {
    color: var(--navy-100);
  }
  .nb-pk__for-label {
    display: block;
    margin-bottom: 2px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--piedra-600);
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__for-label {
    color: var(--navy-200);
  }
  .nb-pk__price {
    padding-block: 18px;
    border-block: 1px solid var(--piedra-200);
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__price {
    border-color: var(--navy-600);
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__price
    .t-price {
    color: var(--white);
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__price
    .text-piedra-600 {
    color: var(--navy-200);
  }
  .nb-pk__inc-title {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--piedra-600);
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__inc-title {
    color: var(--navy-200);
  }
  .nb-pk__inc {
    display: grid;
    gap: 10px;
    margin: -8px 0 8px;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--piedra-800);
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__inc {
    color: var(--white);
  }
  .nb-pk__inc li {
    display: flex;
    gap: 10px;
  }
  .nb-pk__inc svg {
    width: 16px;
    height: 16px;
    flex: none;
    margin-top: 2px;
    fill: none;
    stroke: var(--salvia-600);
    stroke-width: 1.5;
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__inc
    svg {
    stroke: var(--salvia-300);
  }
  .nb-pk__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 0 18px 0 20px;
    border: 1px solid var(--navy-800);
    border-radius: var(--radius-button, 4px);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--navy-800);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .nb-pk__cta:hover {
    background: var(--navy-800);
    color: var(--white);
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__cta {
    border-color: var(--white);
    background: var(--white);
    color: var(--navy-800);
  }
  :is(.nb-pk:not([data-picked]) .nb-pk__item--featured, .nb-pk[data-picked] .nb-pk__item[data-fit])
    .nb-pk__cta:hover {
    background: var(--piedra-100);
  }
  .nb-pk__vat {
    margin: 24px 0 0;
    font-size: 0.875rem;
    color: var(--piedra-600);
  }

  /* Perfil elegido: el tratamiento navy pasa del recomendado al paquete que encaja. */
  .nb-pk__card :is(h3, p, span, li, a, svg) {
    transition:
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      stroke var(--dur-base) var(--ease-out);
  }
  .nb-pk__item {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .nb-pk[data-picked] .nb-pk__item[data-fit] {
    transform: translateY(-8px);
  }
  .nb-pk[data-picked] .nb-pk__item[data-fit] .nb-pk__fits {
    display: inline-block;
  }
  .nb-pk[data-picked] .nb-pk__rec {
    display: none;
  }

  /* ── Comparativa: cabecera fija mientras recorres las filas ── */
  .nb-cmp-wrap {
