<script>
  // «¿Qué te describe mejor?»: marca el paquete que encaja. Solo con JS (sin JS no se muestra).
  const chooser = document.querySelector<HTMLElement>('[data-chooser]');
  const list = document.querySelector<HTMLElement>('.nb-pk');
  if (chooser && list) {
    const chips = [...chooser.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const items = [...list.querySelectorAll<HTMLElement>('[data-pkg]')];
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const active = chip.getAttribute('aria-pressed') !== 'true';
        for (const c of chips) c.setAttribute('aria-pressed', String(active && c === chip));
        list.toggleAttribute('data-picked', active);
        for (const item of items)
          item.toggleAttribute('data-fit', active && item.dataset.pkg === chip.dataset.pick);
      });
    }
  }
</script>
