---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Calculator from '../components/islands/Calculator.tsx';
import { useI18n, type Messages } from '../i18n';
import { getBookingCta } from '../lib/site';

const { t, tRaw, lp, locale } = useI18n(Astro.currentLocale);
const bookingCta = getBookingCta(locale);
const s = tRaw<Messages['calculator']>('calculator');
---

<BaseLayout title={t('calculator.seoTitle')} description={t('calculator.seoDescription')}>
  <PageHeader
    title={t('calculator.title')}
    lead={t('calculator.lead')}
    crumbs={[{ label: t('calculator.seoTitle') }]}
  />

  <section class="nb-calcx-wrap" aria-label={t('calculator.title')}>
    <div class="nb-container">
      <Calculator
        client:visible
        locale={locale}
        s={s}
        vatNote={t('price.vatNoteFirst')}
        perMonth={t('price.perMonth')}
        note={t('home.calculator.note')}
        bookLabel={bookingCta.label}
        recommendedTag={t('pricing.recommended')}
        bookHref={bookingCta.href}
        pricingHref={lp('/precios')}
      />
    </div>
  </section>

  <Section tone="piedra" label={s.howLabel} title={s.howTitle} rule>
    <ol class="nb-how">
      {s.how.map((step) => (
        <li data-reveal class="nb-how__item">
          <h3 class="nb-how__title">{step.title}</h3>
          <p class="nb-how__text">{step.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <CtaBand />
</BaseLayout>

<style is:global>
  .nb-calcx-wrap {
    padding-block: clamp(32px, 5vw, 72px) var(--section-y);
    background: var(--white);
  }
  .nb-calcx {
    display: grid;
    gap: 24px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .nb-calcx {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 16px;
    }
  }

  /* Controls: stone card, like the home page teaser. */
  .nb-calcx__controls {
    display: grid;
    gap: 40px;
    margin: 0;
    padding: clamp(24px, 3.5vw, 48px);
    border-radius: var(--radius-card, 8px);
    background: var(--piedra-100);
  }
  .nb-calcx__field {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .nb-calcx__legend {
    padding: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--navy-800);
  }
  fieldset > .nb-calcx__legend {
    margin-bottom: 12px;
  }
  .nb-calcx__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .nb-calcx__help {
    margin: -6px 0 0;
    font-size: 0.875rem;
    color: var(--piedra-600);
  }
  .nb-calcx__types {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .nb-calcx__type {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 16px 18px;
    border: 1px solid var(--piedra-300);
    border-radius: var(--radius-button, 4px);
    background: var(--white);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .nb-calcx__type input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .nb-calcx__type:hover {
    border-color: var(--navy-800);
  }
  .nb-calcx__type:has(input:checked) {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--white);
  }
  .nb-calcx__type:has(input:focus-visible) {
    outline: 2px solid var(--navy-600);
    outline-offset: 3px;
  }
  .nb-calcx__type-name {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: 1.25rem;
    line-height: 1.2;
  }
  .nb-calcx__type-hint {
    font-size: 0.8125rem;
    color: var(--piedra-600);
  }
  .nb-calcx__type:has(input:checked) .nb-calcx__type-hint {
    color: var(--navy-100);
  }
  .nb-calcx__num {
    width: 5.5rem;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--piedra-300);
    border-radius: var(--radius-button, 4px);
    background: var(--white);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--navy-800);
  }
  .nb-calcx__num:disabled {
    color: var(--piedra-500);
  }

  /* Native range input with the brand track: navy fill up to the value. */
  .nb-calcx__range {
    --fill: calc(var(--v, 0) * 100%);
    width: 100%;
    height: 44px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
  }
  .nb-calcx__range::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(
      to right,
      var(--navy-800) var(--fill),
      var(--piedra-300) var(--fill)
    );
  }
  .nb-calcx__range::-moz-range-track {
    height: 2px;
    background: var(--piedra-300);
  }
  .nb-calcx__range::-moz-range-progress {
    height: 2px;
    background: var(--navy-800);
  }
  .nb-calcx__range::-webkit-slider-thumb {
    width: 22px;
    height: 22px;
    margin-top: -10px;
    border: 2px solid var(--navy-800);
    border-radius: 50%;
    background: var(--white);
    appearance: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nb-calcx__range::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: 2px solid var(--navy-800);
    border-radius: 50%;
    background: var(--white);
  }
  .nb-calcx__range:active::-webkit-slider-thumb {
    transform: scale(1.15);
  }
  .nb-calcx__range:focus-visible {
    outline: 2px solid var(--navy-600);
    outline-offset: 3px;
  }
  .nb-calcx__range:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .nb-calcx__check {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--piedra-800);
    cursor: pointer;
  }
  .nb-calcx__check input {
    width: 18px;
    height: 18px;
    accent-color: var(--navy-800);
  }
  .nb-calcx__share {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--piedra-600);
  }

  /* Result: navy card, sticky on scroll on desktop. */
  .nb-calcx__result {
    display: grid;
    gap: 20px;
    padding: clamp(24px, 3.5vw, 48px);
    border-radius: var(--radius-card, 8px);
    background: var(--navy-800);
    color: var(--navy-100);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  @media (min-width: 1024px) {
    .nb-calcx__result {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
  .nb-calcx__result-label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-200);
  }
  .nb-calcx__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin: 0;
  }
  .nb-calcx__amount {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(3rem, 1.5rem + 4vw, 5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--white);
  }
  .nb-calcx__dash {
    padding-inline: 0.08em;
    color: var(--navy-300);
  }
  .nb-calcx__unit {
    font-size: 0.9375rem;
    color: var(--navy-200);
  }
  .nb-calcx__vat {
    margin: -8px 0 0;
    font-size: 0.875rem;
    color: var(--navy-200);
  }
  .nb-calcx__packages {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }
  .nb-calcx__pkg {
    display: grid;
    align-content: start;
    gap: 6px;
    min-height: 64px;
    padding: 12px;
    border: 1px solid var(--navy-600);
    border-radius: var(--radius-button, 4px);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: var(--navy-200);
    transition:
      border-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }
  .nb-calcx__pkg[data-active] {
    border-color: var(--white);
    background: var(--white);
    color: var(--navy-800);
  }
  .nb-calcx__pkg-tag {
    justify-self: start;
    padding: 3px 6px;
    border-radius: var(--radius-tag, 2px);
    background: var(--salvia-400);
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy-800);
  }
  .nb-calcx__lines {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--navy-600);
  }
  .nb-calcx__line {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 10px;
    border-bottom: 1px solid var(--navy-700);
    font-size: 0.9375rem;
  }
  .nb-calcx__line dt {
    color: var(--navy-100);
  }
  .nb-calcx__line dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--white);
  }
  .nb-calcx__line--total {
    border-bottom: 0;
    font-weight: 600;
  }
  .nb-calcx__custom {
    display: grid;
    gap: 16px;
  }
  .nb-calcx__custom-text {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.2;
    color: var(--white);
  }
  .nb-calcx__note {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--navy-200);
  }
  .nb-calcx__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .nb-calcx__cta {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 48px;
    padding: 0 22px;
    border-radius: var(--radius-button, 4px);
    background: var(--white);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--navy-800);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .nb-calcx__cta:hover {
    background: var(--piedra-100);
  }
  .nb-calcx__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--piedra-50);
    text-decoration: none;
  }
  .nb-calcx__link:hover {
    color: var(--salvia-300);
  }
  .nb-calcx :focus-visible {
    outline: 2px solid var(--navy-600);
    outline-offset: 3px;
  }
  .nb-calcx__result :focus-visible {
    outline-color: var(--salvia-300);
  }

  /* Mobile: a summary fixed at the bottom that jumps to the result. */
  .nb-calcx__bar {
    position: fixed;
    inset: auto 12px 12px;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 0 18px;
    border-radius: var(--radius-card, 8px);
    background: var(--navy-800);
    box-shadow: 0 10px 30px rgb(21 39 66 / 0.25);
    color: var(--white);
    text-decoration: none;
  }
  .nb-calcx__bar-price {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-variant-numeric: tabular-nums;
  }
  .nb-calcx__bar-pkg {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy-200);
  }
  @media (min-width: 1024px) {
    .nb-calcx__bar {
      display: none;
    }
  }

  .nb-how {
    display: grid;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .nb-how {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 48px;
    }
  }
  .nb-how__item {
    display: grid;
    align-content: start;
    gap: 12px;
    padding-top: 20px;
    border-top: 1.5px solid var(--navy-800);
  }
  .nb-how__title {
    margin: 0;
    font-size: 1.5rem;
  }
  .nb-how__text {
    margin: 0;
    color: var(--piedra-700);
  }
</style>
