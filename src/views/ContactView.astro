---
import PhoneLink from '../components/ui/PhoneLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Arrow from '../components/brand/Arrow.astro';
import entrance from '../assets/img/about/office/nb-contacto-entrada-01.jpeg';
import lea from '../assets/img/about/team/lea-brunner.jpeg';
import ContactForm from '../components/islands/ContactForm.tsx';
import { useI18n, type Messages } from '../i18n';
import { getTeam } from '../lib/content';
import { getBookingCta, site } from '../lib/site';
import { byCountry, COUNTRIES } from '../lib/country';
import { OFFICES } from '../data/offices';
import { vatFor } from '../lib/vat';
import { organizationJsonLd } from '../lib/seo';

const { t, tRaw, lp, locale } = useI18n(Astro.currentLocale);
const bookingCta = getBookingCta(locale);
const s = tRaw<Messages['form']>('form');
const c = tRaw<Messages['contact']>('contact');
const tel = `tel:${site.phone.replace(/\s/g, '')}`;
const reader = (await getTeam(locale))[0];
const readerName = reader?.data.name ?? 'Lea Brunner';
const [readerBefore, readerAfter] = c.readerText.split('{name}');

/** Three ways: write (anchor to the form), call, or book the consultation. */
const ways = c.ways.map((w, i) => ({
  ...w,
  href: [`#escribir`, tel, bookingCta.href][i],
  meta: [w.cta, site.phone, w.cta][i],
  sub: [t('contact.lead'), t('footer.hours'), t('booking.label')][i],
}));

/** Monday-to-Sunday week with short day names in the language; working days 08:30 to 17:30. */
const week = Array.from({ length: 7 }, (_, i) => {
  const day = new Date(Date.UTC(2026, 9, 26 + i, 12));
  return {
    weekday: day.getUTCDay(),
    short: new Intl.DateTimeFormat(locale, { weekday: 'short', timeZone: 'UTC' })
      .format(day)
      .replace('.', ''),
    long: new Intl.DateTimeFormat(locale, { weekday: 'long', timeZone: 'UTC' }).format(day),
    open: i < 5,
  };
});

const deck = 'M4 13H44';
const arch = 'M10 37V29A14 14 0 0 1 38 29V37';
---

<BaseLayout
  title={t('contact.seoTitle')}
  description={t('contact.seoDescription')}
  overlayHeader
  jsonLd={organizationJsonLd(locale, Astro.site ?? site.url)}
>
  <!-- Header: the office door, in an arch, and the actual reply time -->
  <header class="nb-cx" data-surface="dark" data-contact-hero>
    <div class="nb-container nb-cx__grid">
      <div class="nb-cx__text" data-cx-drift>
        <Breadcrumbs items={[{ label: t('nav.contact') }]} tone="dark" />
        <h1 class="nb-cx__title" data-split>
          {c.title}
        </h1>
        <div
          class="nb-cx__promise"
          data-reveal
          data-promise
          data-locale={locale}
          data-tpl={c.promiseDate}
          data-open={c.openNow}
          data-closed={c.closedNow}
          data-closed-today={c.closedToday}
        >
          <p class="nb-cx__promise-label">{c.promiseLabel}</p>
          <p class="nb-cx__promise-date" data-promise-text>
            {c.promiseFallback}
          </p>
          <p class="nb-cx__status" data-status hidden>
            <span class="nb-cx__dot" aria-hidden="true"></span>
            <span data-status-text></span>
          </p>
        </div>
        <p class="nb-cx__direct" data-reveal>
          <PhoneLink />
          <span aria-hidden="true">/</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>

      <figure class="nb-cx__door" aria-hidden="true">
        <div class="nb-cx__arch" data-cx-arch>
          <Picture
            src={entrance}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 42vw, 92vw"
            alt=""
            loading="eager"
            fetchpriority="high"
            quality={76}
            class="nb-cx__img"
          />
        </div>
        <span class="nb-cx__outline" data-cx-outline></span>
      </figure>
    </div>
  </header>

  <!-- Three ways to reach us: an editorial index, each row fills with blue on hover -->
  <section class="nb-ways" aria-labelledby="ways-title">
    <div class="nb-container">
      <div class="nb-ways__head">
        <h2 id="ways-title" class="nb-ways__title" data-split>
          {c.waysTitle}
        </h2>
      </div>
      <ol class="nb-ways__list" role="list" data-ways>
        {ways.map((w) => (
          <li class="nb-way" data-way>
            <span class="nb-way__rule" data-way-rule aria-hidden="true" />
            <a class="nb-way__link" href={w.href}>
              <span class="nb-way__n" aria-hidden="true">
                <svg viewBox="4 11 40 26" fill="none" stroke="currentColor" stroke-width="4">
                  <path d="M4 13H44" />
                  <path d="M10 37V29A14 14 0 0 1 38 29V37" />
                </svg>
              </span>
              <span class="nb-way__main">
                <span class="nb-way__title">{w.title}</span>
                <span class="nb-way__text">{w.text}</span>
              </span>
              <span class="nb-way__meta">
                <span class="nb-way__cta">{w.meta}</span>
                <span class="nb-way__sub">{w.sub}</span>
              </span>
              <span class="nb-way__arrow">
                <Arrow size={28} />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- The letter: who reads it and what happens next, next to the paper-style form -->
  <section id="escribir" class="nb-letter" aria-labelledby="letter-title">
    <div class="nb-container nb-letter__grid">
      <aside class="nb-letter__side">
        <p class="nb-letter__eyebrow">{c.readerTitle}</p>
        <div class="nb-reader" data-reveal>
          <div class="nb-reader__arch">
            <Picture
              src={lea}
              formats={['avif', 'webp']}
              widths={[160, 320]}
              sizes="120px"
              alt=""
              quality={74}
              class="nb-reader__img"
            />
          </div>
          <div>
            <p class="nb-reader__name">{readerName}</p>
            <p class="nb-reader__role">{reader?.data.role}</p>
          </div>
        </div>
        <p class="nb-reader__text" data-reveal>
          <Fragment set:html={byCountry((cc) => vatFor(readerBefore ?? '', cc, locale))} />
          <strong>{readerName}</strong>
          <Fragment set:html={byCountry((cc) => vatFor(readerAfter ?? '', cc, locale))} />
        </p>
        <ol class="nb-steps" role="list" data-steps>
          <span class="nb-steps__line" aria-hidden="true">
            <span data-steps-line></span>
          </span>
          {c.steps.map((step) => (
            <li class="nb-step" data-step>
              <span class="nb-step__dot" aria-hidden="true" />
              <span class="nb-step__when">{step.when}</span>
              <span class="nb-step__text">{step.text}</span>
            </li>
          ))}
        </ol>
      </aside>

      <div class="nb-sheet" data-sheet>
        <div class="nb-sheet__head">
          <dl class="nb-sheet__meta">
            <div>
              <dt>{c.letterTo}</dt>
              <dd>
                {COUNTRIES.map((cc) => (
                  <span data-cc={cc}>
                    {`${site.legalName}, ${OFFICES[cc].street}, ${OFFICES[cc].postalCode} ${OFFICES[cc].city}`}
                  </span>
                ))}
              </dd>
            </div>
            <div data-letter-date hidden>
              <dt>{c.letterDate}</dt>
              <dd data-letter-date-text></dd>
            </div>
          </dl>
          <svg class="nb-sheet__mark" viewBox="4 11 40 26" aria-hidden="true">
            <path d={deck}></path>
            <path d={arch}></path>
          </svg>
        </div>
        <span class="nb-sheet__rule" data-sheet-rule aria-hidden="true"></span>
        <h2 id="letter-title" class="nb-sheet__title">
          {c.formTitle}
        </h2>
        <noscript>
          <p class="nb-contact__noscript">
            {t('form.noscript', { email: site.email, phone: site.phone })}
          </p>
        </noscript>
        <ContactForm
          client:visible
          s={s}
          demo={tRaw<Messages['demo']>('demo')}
          privacyHref={lp('/privacidad')}
          thanksHref={lp('/gracias')}
        />
      </div>
    </div>
  </section>

  <!-- The country's office: address, opening hours with today highlighted and the walk from the station -->
  <section class="nb-visit" data-surface="dark" aria-labelledby="visit-title">
    <div class="nb-container nb-visit__grid">
      <div class="nb-visit__info">
        <p class="nb-visit__eyebrow">{c.visitLabel}</p>
        <h2
          id="visit-title"
          class="nb-visit__title"
          data-reveal
          set:html={byCountry((cc) => c.visitTitle.replace('{city}', OFFICES[cc].cityName[locale]))}
        />
        <address class="nb-visit__addr" data-reveal>
          {COUNTRIES.map((cc) => (
            <span data-cc={cc}>
              {site.legalName}
              <br />
              {OFFICES[cc].street}
              <br />
              {`${OFFICES[cc].postalCode} ${OFFICES[cc].city}`}
            </span>
          ))}
        </address>
        <dl class="nb-visit__data" data-reveal>
          <div>
            <dt>{c.phone}</dt>
            <dd>
              <PhoneLink />
            </dd>
          </div>
          <div>
            <dt>{c.email}</dt>
            <dd>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
        </dl>
        <div class="nb-week" data-reveal>
          <p class="nb-week__title">{c.hours}</p>
          <ol class="nb-week__days" role="list" data-week data-today-label={c.today}>
            {week.map((d) => (
              <li class:list={['nb-week__day', !d.open && 'is-closed']} data-wd={d.weekday}>
                <abbr class="nb-week__name" title={d.long}>
                  {d.short}
                </abbr>
                <span class="nb-week__hours">
                  {d.open ? (
                    <>
                      08:30–
                      <br />
                      17:30
                    </>
                  ) : (
                    c.closed
                  )}
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <figure class="nb-map" data-map>
        <svg viewBox="0 0 600 460" role="img" aria-labelledby="nb-map-caption">
          <rect width="600" height="460" class="nb-map__land"></rect>
          {(['water', 'park'] as const).map((kind) => (
            <path
              class:list={['nb-map__lake', kind === 'park' && 'nb-map__lake--park']}
              data-cc={COUNTRIES.filter((cc) => OFFICES[cc].landmarkKind === kind).join(' ')}
              d="M0 250 C 70 240 140 268 200 312 C 262 358 300 410 330 460 L 0 460 Z"
            />
          ))}
          <g class="nb-map__streets" data-map-streets>
            <path d="M40 0 C 110 70 190 120 290 190 S 470 330 600 372"></path>
            <path d="M180 0 C 230 60 300 110 400 160 S 540 230 600 250"></path>
            <path d="M320 0 C 360 50 430 92 600 150"></path>
            <path d="M0 110 L 600 96"></path>
            <path d="M390 0 L 260 460"></path>
            <path d="M520 0 L 450 460"></path>
            <path d="M0 196 C 120 200 200 214 300 236"></path>
          </g>
          <path
            id="nb-map-seefeld"
            class="nb-map__main"
            d="M150 112 C 220 168 300 214 380 262 S 470 318 500 336"
          ></path>
          {COUNTRIES.map((cc) => (
            <text class="nb-map__street" data-cc={cc}>
              <textPath href="#nb-map-seefeld" startOffset="18%">
                {OFFICES[cc].streetLabel}
              </textPath>
            </text>
          ))}
          <path
            class="nb-map__route"
            d="M150 112 C 220 168 300 214 380 262 S 452 306 468 316"
            pathLength="1"
            data-map-route
          ></path>
          <g class="nb-map__station" transform="translate(150 112)">
            <rect x="-34" y="-9" width="68" height="18" rx="1"></rect>
          </g>
          {COUNTRIES.map((cc) => (
            <text x="150" y="84" class="nb-map__label" text-anchor="middle" data-cc={cc}>
              {OFFICES[cc].station}
            </text>
          ))}
          {COUNTRIES.map((cc) => (
            <text x="56" y="400" class="nb-map__label nb-map__label--lake" data-cc={cc}>
              {OFFICES[cc].landmark[locale]}
            </text>
          ))}
          <g
            transform="translate(286 276)"
            data-cc={COUNTRIES.filter((cc) => OFFICES[cc].walkMinutes).join(' ')}
          >
            <g class="nb-map__grow">
              <g class="nb-map__walk" data-map-walk>
                <rect x="-56" y="-16" width="112" height="32" rx="2"></rect>
                <text text-anchor="middle" y="5">
                  {c.walk}
                </text>
              </g>
            </g>
          </g>
          <g transform="translate(480 330)">
            <g class="nb-map__grow">
              <g class="nb-map__pin" data-map-pin>
                <circle r="34"></circle>
                <g transform="translate(-16 -10.4) scale(0.8)">
                  <path d="M0 2H40"></path>
                  <path d="M6 26V18A14 14 0 0 1 34 18V26"></path>
                </g>
              </g>
            </g>
          </g>
        </svg>
        <figcaption
          id="nb-map-caption"
          set:html={byCountry(
            (cc) =>
              `${site.legalName}, ${OFFICES[cc].street}, ${OFFICES[cc].postalCode} ${OFFICES[cc].city}. ${OFFICES[cc].directions[locale]}`,
          )}
        />
      </figure>
    </div>
  </section>
</BaseLayout>

<script>
  import { formatDay, officeStatus, replyDay, zurichNow } from '../lib/contact/office';
  import { OFFICE_CLOSED } from '../lib/contact/closed-days';
  import type { Country } from '../lib/country';

  // Actual reply time and office status (Central European Time). Without JS, the server's generic text stays.
  const now = new Date();
  const root = document.documentElement;
  const promise = document.querySelector<HTMLElement>('[data-promise]');
  if (promise) {
    const { locale = 'es', tpl = '', open = '', closed = '', closedToday = '' } = promise.dataset;
    const target = promise.querySelector('[data-promise-text]');
    const [before, after = ''] = tpl.split('{when}');
    const z = zurichNow(now);
    const line = promise.querySelector<HTMLElement>('[data-status]');
    const text = promise.querySelector('[data-status-text]');

    // Uses the closing days of the selected country's office; recomputed if the country changes.
    const render = () => {
      const country = (root.dataset.country ?? 'CH') as Country;
      const closedDays = OFFICE_CLOSED[country] ?? OFFICE_CLOSED.CH;
      if (target && before !== undefined) {
        const em = document.createElement('em');
        em.textContent = formatDay(replyDay(now, closedDays), locale);
        target.replaceChildren(before, em, after);
      }
      const status = officeStatus(now, closedDays);
      if (line && text) {
        if (status.open) text.textContent = open;
        else if (status.opens.d === z.d && status.opens.m === z.m) text.textContent = closedToday;
        else text.textContent = closed.replace('{when}', formatDay(status.opens, locale, false));
        line.dataset.open = String(status.open);
        line.hidden = false;
      }
    };
    render();
    new MutationObserver(render).observe(root, { attributeFilter: ['data-country'] });

    // Letter date and today in the opening hours.
    const date = document.querySelector<HTMLElement>('[data-letter-date]');
    const dateText = date?.querySelector('[data-letter-date-text]');
    if (date && dateText) {
      dateText.textContent = new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : locale, {
        dateStyle: 'long',
        timeZone: 'Europe/Zurich',
      }).format(now);
      date.hidden = false;
    }
    const week = document.querySelector<HTMLElement>('[data-week]');
    const today = week?.querySelector<HTMLElement>(`[data-wd="${z.weekday}"]`);
    if (week && today) {
      today.classList.add('is-today');
      today.setAttribute('aria-current', 'date');
      const badge = document.createElement('span');
      badge.className = 'nb-week__today';
      badge.textContent = week.dataset.todayLabel ?? '';
      today.append(badge);
    }
  }
</script>

<style is:global>
  /* ── Header ── */
  .nb-cx {
    position: relative;
    overflow: clip;
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-cx__grid {
    display: grid;
    gap: 48px;
    padding-block: calc(var(--header-h) + 40px) clamp(48px, 6vw, 96px);
  }
  @media (min-width: 1024px) {
    .nb-cx__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: center;
      gap: clamp(48px, 6vw, 112px);
      min-height: max(100svh, 760px);
    }
  }
  .nb-cx__text {
    display: grid;
    gap: 28px;
  }
  .nb-cx__title {
    margin: 0;
    max-width: 11ch;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(3rem, 1rem + 6vw, 7.25rem);
    font-weight: 300;
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: var(--white);
  }
  .nb-cx__promise {
    display: grid;
    gap: 6px;
    max-width: 34rem;
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.22);
  }
  .nb-cx__promise-label {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--salvia-300);
  }
  .nb-cx__promise-date {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.1rem + 1.4vw, 2.375rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--white);
  }
  .nb-cx__promise-date em {
    font-style: italic;
  }
  .nb-cx__status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 10px 0 0;
    font-size: 0.9375rem;
    color: var(--navy-100);
  }
  .nb-cx__status[hidden] {
    display: none;
  }
  .nb-cx__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--navy-300);
  }
  .nb-cx__status[data-open='true'] .nb-cx__dot {
    background: var(--salvia-300);
  }
  /* Open: a slow, barely visible halo (transform/opacity only). */
  @media (prefers-reduced-motion: no-preference) {
    .nb-cx__status[data-open='true'] .nb-cx__dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: var(--salvia-300);
      animation: nb-cx-halo 2.8s var(--ease-out) infinite;
    }
  }
  @keyframes nb-cx-halo {
    from {
      transform: scale(1);
      opacity: 0.55;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }
  .nb-cx__direct {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    font-size: 1.0625rem;
    color: var(--navy-300);
  }
  .nb-cx__direct a {
    color: var(--white);
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.3);
    text-underline-offset: 6px;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .nb-cx__direct a:hover {
    text-decoration-color: currentColor;
  }

  /* The door: an arch photo with an outline that traces it. */
  .nb-cx__door {
    position: relative;
    margin: 0;
    width: min(100%, 520px);
    justify-self: end;
    aspect-ratio: 100 / 130;
  }
  @media (max-width: 1023px) {
    .nb-cx__door {
      justify-self: center;
      width: min(100%, 420px);
    }
  }
  .nb-cx__arch {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 9999px 9999px 0 0;
    background: var(--navy-700);
  }
  .nb-cx__arch picture {
    display: contents;
  }
  .nb-cx__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% 50%;
    transform-origin: 54% 42%;
  }
  /* Concentric outline: the same arch, 14 px wider. */
  .nb-cx__outline {
    position: absolute;
    inset: -14px -14px 0;
    border: 1px solid rgb(255 255 255 / 0.26);
    border-bottom: 0;
    border-radius: 9999px 9999px 0 0;
    pointer-events: none;
  }

  /* ── Three ways ── */
  .nb-ways {
    padding-block: var(--section-y);
    background: var(--white);
  }
  .nb-ways__head {
    padding-bottom: clamp(24px, 4vw, 48px);
  }
  .nb-ways__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1rem + 3vw, 4rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--navy-800);
  }
  .nb-ways__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--navy-800);
  }
  .nb-way {
    position: relative;
  }
  .nb-way__rule {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--navy-800);
    transform-origin: left center;
  }
  .nb-way__link {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px clamp(16px, 3vw, 48px);
    padding: clamp(24px, 3.5vw, 44px) clamp(8px, 1.5vw, 24px);
    color: var(--navy-800);
    text-decoration: none;
    isolation: isolate;
  }
  @media (min-width: 900px) {
    .nb-way__link {
      grid-template-columns: 56px minmax(0, 1.4fr) minmax(0, 1fr) auto;
    }
  }
  /* Blue fill rising from the bottom (transform); the text turns white. */
  .nb-way__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--navy-800);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .nb-way__link:hover::before,
  .nb-way__link:focus-visible::before {
    transform: scaleY(1);
  }
  .nb-way__link:focus-visible {
    outline: 2px solid var(--navy-600);
    outline-offset: 2px;
  }
  .nb-way__n svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .nb-way__n {
    align-self: start;
    width: 24px;
    padding-top: 0.7em;
    color: var(--piedra-600);
    transition: color var(--dur-base) var(--ease-out);
  }
  .nb-way__main {
