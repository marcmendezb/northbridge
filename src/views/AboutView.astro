---
import { Image, Picture } from 'astro:assets';
import logoMark from '../assets/brand/logo-header.png';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Arrow from '../components/brand/Arrow.astro';
import Button from '../components/ui/Button.astro';
import office from '../assets/img/about/office/oficina.jpeg';
import entrance from '../assets/img/about/office/nb-contacto-entrada-01.jpeg';
import meeting from '../assets/img/about/office/nb-consulta-conversacion-01.jpeg';
import lea from '../assets/img/about/team/lea-brunner.jpeg';
import tobias from '../assets/img/about/team/tobias-vogel.jpeg';
import nora from '../assets/img/about/team/nora-steiner.jpeg';
import marc from '../assets/img/about/team/marc-bernasconi.jpeg';
import { useI18n } from '../i18n';
import { entryKey, getTeam } from '../lib/content';
import { getBookingCta, site } from '../lib/site';
import { byCountry, COUNTRIES } from '../lib/country';
import { OFFICES } from '../data/offices';
import { vatFor } from '../lib/vat';

const { t, tRaw, lp, locale } = useI18n(Astro.currentLocale);
const team = await getTeam(locale);
const portraits: Record<string, ImageMetadata> = {
  'lea-brunner': lea,
  'tobias-vogel': tobias,
  'nora-steiner': nora,
  'marc-bernasconi': marc,
};
/** Encuadre de cada retrato: Tobias tiene una franja oscura a la izquierda. */
const focus: Record<string, string> = { 'tobias-vogel': '72% 50%' };
const story = tRaw<string[]>('about.story');
const method = tRaw<{ title: string; text: string }[]>('about.method');
const principles = tRaw<{ title: string; text: string }[]>('about.principles');
const facts = tRaw<{ value: string; label: string }[]>('about.facts');
const bookingCta = getBookingCta(locale);
const guarantees = tRaw<string[]>('booking.guarantees');
const tel = `tel:${site.phone.replace(/\s/g, '')}`;
const yearDigits = String(site.founded).split('');
/** «200+» → cifra animable y sufijo. */
const splitFact = (v: string) => {
  const m = v.match(/^(\d+)(.*)$/);
  return m ? { n: Number(m[1]), suffix: m[2] } : { n: null, suffix: v };
};
---

<BaseLayout title={t('about.seoTitle')} description={t('about.seoDescription')} overlayHeader>
  <!-- 1 · Cabecera: la oficina a sangre y las cifras de la firma al pie -->
  <header class="nb-ah" data-surface="dark" data-about-hero>
    <div class="nb-ah__media" aria-hidden="true">
      <Picture
        src={office}
        formats={['avif', 'webp']}
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        quality={74}
        class="nb-ah__img"
      />
    </div>
    <div class="nb-ah__content nb-container" data-about-hero-content>
      <Breadcrumbs items={[{ label: t('nav.about') }]} tone="dark" />
      <h1 class="nb-ah__title" data-split>
        {t('about.title')}
      </h1>
      <p
        class="nb-ah__lead"
        data-reveal
        set:html={byCountry((c) =>
          vatFor(t(c === 'CH' ? 'about.lead' : 'about.leadIntl'), c, locale),
        )}
      />
      <dl class="nb-ah__facts" data-reveal>
        {facts.map((f) => {
          const { n, suffix } = splitFact(f.value);
          return (
            <div class="nb-ah__fact">
              <dt>{f.label}</dt>
              <dd>
                {n !== null && n < 1000 ? <span data-count={n}>{n}</span> : n}
                {suffix}
              </dd>
            </div>
          );
        })}
      </dl>
    </div>
  </header>

  <!-- 2 · Historia: el año de fundación, monumental -->
  <section class="nb-hist" aria-labelledby="story-title">
    <div class="nb-container nb-hist__grid">
      <div class="nb-hist__year" aria-hidden="true">
        <span class="nb-hist__digits" data-year>
          {yearDigits.map((d) => (
            <span class="nb-hist__digit">
              <span>{d}</span>
            </span>
          ))}
        </span>
        <span class="nb-hist__caption">{facts[0]?.label}</span>
      </div>
      <div class="nb-hist__body">
        <p class="nb-hist__label">{t('about.storyLabel')}</p>
        <h2 class="nb-hist__title" id="story-title" data-split>
          {t('about.storyTitle')}
        </h2>
        {story.map((p, i) => (
          <p data-reveal class:list={['nb-hist__p', i === 0 && 'nb-hist__p--lead']}>
            {p}
          </p>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · Principios: cada palabra se ilumina al pasar por el centro de la pantalla -->
  <section class="nb-prin" aria-labelledby="principles-title">
    <div class="nb-container">
      <div class="nb-prin__head">
        <p class="nb-prin__label">{t('about.principlesLabel')}</p>
        <h2 class="nb-prin__title" id="principles-title" data-split>
          {t('about.principlesTitle')}
        </h2>
      </div>
      <dl class="nb-prin__list">
        {principles.map((p) => (
          <div class="nb-prin__row" data-focus-row>
            <dt class="nb-prin__word">{p.title}</dt>
            <dd class="nb-prin__text">{p.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 4 · Método: el símbolo se construye mientras recorres los cuatro puntos -->
  <section class="nb-meth" data-surface="dark" aria-labelledby="method-title">
    <div class="nb-container nb-meth__grid">
      <div class="nb-meth__aside">
        <p class="nb-meth__label">{t('about.methodLabel')}</p>
        <h2 class="nb-meth__title" id="method-title" data-split>
          {t('about.methodTitle')}
        </h2>
        <Image
          src={logoMark}
          alt=""
          width={480}
          densities={[1, 2]}
          class="nb-meth__symbol"
          loading="lazy"
          aria-hidden="true"
          data-reveal
        />
      </div>
      <ol class="nb-meth__list" data-method-list>
        {method.map((m) => (
          <li class="nb-meth__item" data-reveal>
            <h3 class="nb-meth__item-title">{m.title}</h3>
            <p class="nb-meth__item-text">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5 · Equipo: el nombre, escrito en la pared de cada retrato -->
  <section class="nb-crew" aria-labelledby="team-title">
    <div class="nb-container">
      <div class="nb-crew__head">
        <p class="nb-crew__label">{t('about.teamLabel')}</p>
        <h2 class="nb-crew__title" id="team-title" data-split>
          {t('about.teamTitle')}
        </h2>
        <p class="nb-crew__lead" data-reveal>
          {t('about.teamLead')}
        </p>
      </div>
      <ul class="nb-crew__grid">
        {team.map((m) => {
          const [given, ...family] = m.data.name.split(' ');
          const key = entryKey(m);
          return (
            <li class="nb-crew__member">
              <figure class="nb-crew__arch" data-crew-arch>
                <Picture
                  src={portraits[key]}
                  formats={['avif', 'webp']}
                  widths={[360, 540, 800]}
                  sizes="(min-width: 1024px) 24vw, (min-width: 640px) 46vw, 92vw"
                  alt={m.data.name}
                  loading="lazy"
                  quality={76}
                  class="nb-crew__img"
                  style={focus[key] ? `object-position:${focus[key]}` : undefined}
                />
                <figcaption class="nb-crew__name" aria-hidden="true">
                  <span class="nb-crew__line">
                    <span>{given}</span>
                  </span>
                  <span class="nb-crew__line">
                    <span>{family.join(' ')}</span>
                  </span>
                </figcaption>
              </figure>
              <div class="nb-crew__body" data-reveal>
                <h3 class="sr-only">{m.data.name}</h3>
                <p class="nb-crew__role">{m.data.role}</p>
                <p class="nb-crew__spec">
                  <span class="nb-crew__spec-label">{t('about.specialty')}</span>
                  <Fragment set:html={byCountry((c) => vatFor(m.data.specialty, c, locale))} />
                </p>
                <blockquote class="nb-crew__quote">
                  <p>{m.data.quote}</p>
                </blockquote>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- 6 · Oficina -->
  <section class="nb-office" aria-labelledby="office-title">
    <div class="nb-container nb-office__grid">
      <div class="nb-office__text">
        <p class="nb-office__label">{t('about.officeLabel')}</p>
        <!-- La oficina depende del país (src/data/offices.ts): una variante por país. -->
        <h2
          class="nb-office__title"
          id="office-title"
          data-reveal
          set:html={byCountry((c) => OFFICES[c].title[locale])}
        />
        <p class="nb-office__p" data-reveal set:html={byCountry((c) => OFFICES[c].text[locale])} />
        <address class="nb-office__address" data-reveal>
          {COUNTRIES.map((c) => (
            <span data-cc={c}>
              {OFFICES[c].street}
              <br />
              {`${OFFICES[c].postalCode} ${OFFICES[c].city}`}
            </span>
          ))}
        </address>
        <a href={lp('/contacto')} class="nb-office__cta" data-reveal>
          {t('about.officeCta')}
          <Arrow />
        </a>
      </div>
      <div class="nb-office__photo" data-reveal-media>
        <Picture
          src={entrance}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 34vw, 100vw"
          alt=""
          loading="lazy"
          quality={74}
        />
      </div>
      <div class="nb-office__photo nb-office__photo--offset" data-reveal-media>
        <Picture
          src={meeting}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 30vw, 100vw"
          alt=""
          loading="lazy"
          quality={74}
        />
      </div>
    </div>
  </section>

  <!-- 7 · Cierre: el equipo, en pie como los pilares de un puente, y la consulta -->
  <section class="nb-meet" data-surface="dark" aria-labelledby="meet-title" data-meet>
    <div class="nb-container nb-meet__grid">
      <div class="nb-meet__text">
        <p class="nb-meet__label">{t('booking.label')}</p>
        <h2 class="nb-meet__title" id="meet-title" data-split>
          {t('about.ctaTitle')}
        </h2>
        <p class="nb-meet__lead" data-reveal>
          {t('about.ctaText')}
        </p>
        <div class="nb-meet__actions" data-reveal>
          <Button href={bookingCta.href} on="dark" arrow>
            {bookingCta.label}
          </Button>
          <p class="nb-meet__call">
            {t('about.ctaCall').split('{phone}')[0]}
            <a href={tel}>{site.phone}</a>
            {t('about.ctaCall').split('{phone}')[1]}
          </p>
        </div>
        <ul class="nb-meet__guarantees" data-reveal>
          {guarantees.map((g) => (
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M2.5 8.5l3.5 3.5 7.5-8" />
              </svg>
              {g}
            </li>
          ))}
        </ul>
      </div>

      <figure class="nb-meet__team">
        <ul class="nb-meet__piers">
          {team.map((m, i) => (
            <li class="nb-meet__pier" style={`--h:${[100, 86, 94, 80][i % 4]}%`}>
              <span class="nb-meet__mask">
                <span class="nb-meet__arch" data-meet-arch>
                  <Picture
                    src={portraits[entryKey(m)]}
                    formats={['avif', 'webp']}
                    widths={[240, 400]}
                    sizes="(min-width: 1024px) 12vw, 22vw"
                    alt={m.data.name}
                    loading="lazy"
                    quality={72}
                    class="nb-meet__img"
                  />
                </span>
              </span>
              <span class="nb-meet__name" data-meet-name>
                {m.data.name.split(' ')[0]}
              </span>
            </li>
          ))}
        </ul>
        <span class="nb-meet__base" aria-hidden="true" data-meet-base></span>
        <figcaption class="nb-meet__caption" data-reveal>
          {t('about.ctaPeople')}
        </figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ── 1 · Cabecera ── */
  .nb-ah {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: max(100svh, 720px);
    overflow: hidden;
    background: var(--navy-800);
    color: var(--white);
  }
  .nb-ah__media {
    position: absolute;
    inset: 0;
  }
  .nb-ah__media picture {
    display: contents;
  }
  .nb-ah__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 50%;
    transform-origin: 70% 50%;
  }
  .nb-ah__content {
    position: relative;
    display: grid;
    gap: 24px;
    width: 100%;
    padding-block: calc(var(--header-h) + 48px) clamp(32px, 4vw, 56px);
  }
  .nb-ah__title {
    margin: 0;
    max-width: 13ch;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(2.75rem, 1rem + 5vw, 6rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--white);
  }
  .nb-ah__lead {
    margin: 0;
    max-width: 32rem;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--navy-100);
  }
  .nb-ah__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 24px;
    margin: clamp(24px, 4vw, 56px) 0 0;
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.22);
  }
  @media (min-width: 900px) {
    .nb-ah__facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .nb-ah__fact {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
  }
  .nb-ah__fact dt {
    font-size: 0.875rem;
    color: var(--navy-100);
  }
  .nb-ah__fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.5rem + 2vw, 3.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--white);
  }
  @media (max-width: 767px) {
    .nb-ah__img {
      object-position: 70% 50%;
    }
    .nb-ah__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: color-mix(in srgb, var(--navy-800) 74%, transparent);
    }
  }

  /* ── 2 · Historia ── */
  .nb-hist {
    padding-block: var(--section-y);
    background: var(--white);
  }
  .nb-hist__grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1024px) {
    .nb-hist__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 80px;
      align-items: start;
    }
    .nb-hist__year {
      position: sticky;
      top: calc(var(--header-h) + 48px);
    }
  }
  .nb-hist__year {
    display: grid;
    gap: 12px;
  }
  .nb-hist__digits {
    display: flex;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(6rem, 2rem + 13vw, 15rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--navy-800);
  }
  /* Cada cifra sube desde su propia máscara (aboutScene.ts). */
  .nb-hist__digit {
    display: inline-block;
    overflow: hidden;
  }
  .nb-hist__digit > span {
    display: inline-block;
  }
  .nb-hist__caption {
    padding-top: 16px;
    border-top: 1.5px solid var(--navy-800);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--piedra-600);
  }
  .nb-hist__body {
    display: grid;
    gap: 20px;
    max-width: 40rem;
  }
  .nb-hist__label,
  .nb-prin__label,
  .nb-crew__label,
  .nb-office__label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-600);
  }
  .nb-hist__title {
    margin: 0 0 12px;
    font-size: clamp(2.25rem, 1rem + 3vw, 3.75rem);
    font-weight: 300;
    line-height: 1.05;
  }
  .nb-hist__p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--piedra-800);
  }
  .nb-hist__p--lead {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1rem + 1vw, 1.75rem);
    line-height: 1.35;
    color: var(--navy-800);
  }

  /* ── 3 · Principios ── */
  .nb-prin {
    padding-block: var(--section-y);
    background: var(--piedra-100);
  }
  .nb-prin__head {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .nb-prin__title {
    margin: 0;
    font-size: clamp(2.25rem, 1rem + 3vw, 3.75rem);
    font-weight: 300;
  }
  .nb-prin__list {
    margin: 0;
    border-top: 1.5px solid var(--navy-800);
  }
  .nb-prin__row {
    display: grid;
    gap: 8px 48px;
    padding-block: clamp(24px, 3.5vw, 44px);
    border-bottom: 1px solid var(--piedra-300);
  }
  @media (min-width: 768px) {
    .nb-prin__row {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .nb-prin__word {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(3rem, 1rem + 7vw, 7.5rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--navy-800);
    transition:
      color var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }
  .nb-prin__text {
    margin: 0;
    max-width: 30rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--piedra-700);
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  /* Con movimiento: solo la fila del centro de la pantalla tiene todo su color. */
  @media (prefers-reduced-motion: no-preference) {
    .js.motion:not(.anim-fail) .nb-prin__word {
      color: var(--piedra-300);
    }
    .js.motion:not(.anim-fail) .nb-prin__text {
      opacity: 0.35;
    }
    .js.motion:not(.anim-fail) .nb-prin__row.is-lit .nb-prin__word {
      color: var(--navy-800);
      transform: translateX(12px);
    }
    .js.motion:not(.anim-fail) .nb-prin__row.is-lit .nb-prin__text {
      opacity: 1;
    }
  }

  /* ── 4 · Método ── */
  .nb-meth {
    padding-block: var(--section-y);
    background: var(--navy-800);
    color: var(--navy-100);
  }
  .nb-meth__grid {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .nb-meth__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 96px;
      align-items: start;
    }
    .nb-meth__aside {
      position: sticky;
      top: calc(var(--header-h) + 48px);
    }
  }
  .nb-meth__aside {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .nb-meth__label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia-300);
  }
  .nb-meth__title {
    margin: 0;
    font-size: clamp(2.25rem, 1rem + 3vw, 3.75rem);
    font-weight: 300;
    color: var(--white);
  }
  /* Símbolo en negativo (blanco sobre Navy 800, docs/02), grande: el PNG navy pasa a blanco puro. */
  .nb-meth__symbol {
    display: block;
    width: clamp(180px, 22vw, 340px);
    height: auto;
    margin-top: clamp(32px, 5vw, 72px);
    filter: brightness(0) invert(1);
  }
  .nb-meth__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--navy-600);
  }
  .nb-meth__item {
    display: grid;
    gap: 12px;
    padding-block: clamp(32px, 5vw, 64px);
    border-bottom: 1px solid var(--navy-600);
  }
  .nb-meth__item-title {
    margin: 0;
    font-size: clamp(1.75rem, 1rem + 1.6vw, 2.5rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--white);
  }
  .nb-meth__item-text {
    margin: 0;
    max-width: 32rem;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  /* ── 5 · Equipo ── */
  .nb-crew {
    padding-block: var(--section-y);
    background: var(--white);
  }
  .nb-crew__head {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .nb-crew__title {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(2.25rem, 1rem + 3vw, 3.75rem);
    font-weight: 300;
  }
  .nb-crew__lead {
    margin: 0;
    font-size: 1.125rem;
    color: var(--piedra-700);
  }
  .nb-crew__grid {
    display: grid;
    gap: 56px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
